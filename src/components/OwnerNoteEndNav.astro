---
const {
  nextHref,
  nextName,
  nextHeadline,
  nextReason,
  historyHref = 'history/#1950s',
  ownersHref = 'owners-notes/'
} = Astro.props;
const base = import.meta.env.BASE_URL;
const resolveLocal = (path: string) => `${base}${path.replace(/^\//, '')}`;
---
<nav class="owner-note-end-nav shell" aria-label="OWNER'S NOTE 次のページと一覧">
  <a class="owner-note-next" href={resolveLocal(nextHref)}>
    <small>NEXT OWNER'S NOTE <em>／ 次の一本</em></small>
    {nextHeadline ? (
      <>
        <strong>{nextHeadline}</strong>
        {nextReason && <span class="owner-note-next-reason">{nextReason}</span>}
        <strong>{nextName} →</strong>
      </>
    ) : (
      <>
        <strong>{nextName} →</strong>
        {nextReason && <span class="owner-note-next-reason">{nextReason}</span>}
      </>
    )}
  </a>
  <div class="owner-note-secondary">
    <a class="owner-note-all" href={resolveLocal(ownersHref)}>ALL OWNER'S NOTES <span>／ 一覧</span> →</a>
    <a class="owner-note-history" href={resolveLocal(historyHref)}>HISTORYへ戻る →</a>
  </div>
</nav>

<style>
  .owner-note-end-nav{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:28px;align-items:end;padding-block:52px 82px;border-top:1px solid var(--ink)}
  .owner-note-end-nav a{text-decoration:none}
  .owner-note-next{display:grid;gap:8px;min-width:0}
  .owner-note-next small{color:var(--soft);font-size:11px;letter-spacing:.12em}.owner-note-next small em{font-style:normal;letter-spacing:.02em}
  .owner-note-next strong{font-family:Georgia,"Times New Roman",serif;font-size:clamp(1.45rem,4vw,2.4rem);font-weight:400;line-height:1.12;overflow-wrap:normal;word-break:normal}
  .owner-note-next-reason{max-width:46rem;color:var(--soft);font-size:14px;line-height:1.65;letter-spacing:.01em}
  .owner-note-secondary{display:grid;gap:12px;justify-items:end}
  .owner-note-all,.owner-note-history{padding-bottom:5px;border-bottom:1px solid currentColor;font-size:14px;white-space:nowrap}
  .owner-note-all{font-size:12px;letter-spacing:.08em}
  .owner-note-all span{letter-spacing:.02em}
  @media(max-width:480px){
    .owner-note-end-nav{grid-template-columns:1fr;gap:28px;padding-block:38px 58px}
    .owner-note-next strong{font-size:1.45rem}
    .owner-note-next-reason{font-size:13px;line-height:1.7}
    .owner-note-secondary{justify-items:start}
  }
</style>
