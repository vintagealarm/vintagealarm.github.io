---
const { items } = Astro.props;
const base = import.meta.env.BASE_URL;
const resolveImage = (path: string) => /^https?:\/\//.test(path)
  ? path
  : `${base}${path.replace(/^\//, '')}`;
---
<section class="section shell" aria-labelledby="deep">
  <h2 id="deep">さらに詳しく</h2>
  <div class="deep-list">
    {items.map((item: any) => {
      const images = item.images ?? [];
      const compactMedia = item.mediaStyle === 'compact-sequence';
      const trailingImages = images.filter((image: any) =>
        !Number.isInteger(image.afterParagraph)
        || image.afterParagraph < 1
        || image.afterParagraph > item.paragraphs.length
      );

      const renderMedia = (mediaImages: any[]) => (
        <div class:list={["deep-media", compactMedia && "deep-media--compact"]}>
          {mediaImages.map((image: any) => {
            const imageIndex = images.indexOf(image);
            const alt = image.alt || image.caption || `${item.title} 補足画像`;
            const src = resolveImage(image.src);
            return (
              <figure class:list={[compactMedia && image.fullRow && "deep-media__full"]}>
                {compactMedia ? (
                  <button
                    type="button"
                    class="deep-zoom"
                    data-deep-index={imageIndex}
                    data-src={src}
                    data-alt={alt}
                    data-caption={image.caption || ''}
                    aria-label={`${image.caption || item.title}を拡大表示`}
                  >
                    <img
                      src={src}
                      alt={alt}
                      loading="lazy"
                      decoding="async"
                    />
                  </button>
                ) : (
                  <img
                    src={src}
                    alt={alt}
                    loading="lazy"
                    decoding="async"
                  />
                )}
                {image.caption && <figcaption>{image.caption}</figcaption>}
              </figure>
            );
          })}
        </div>
      );

      return (
        <details>
          <summary><span class="number">{item.number}</span><span class="summary-label">{item.title}</span></summary>
          <div class="copy prose" data-deep-gallery={compactMedia ? 'true' : undefined}>
            {item.subtitle && <h3>{item.subtitle}</h3>}
            {item.paragraphs.map((paragraph: string, index: number) => {
              const imagesAfter = images.filter((image: any) => image.afterParagraph === index + 1);
              const refs = (item.citationRefs?.[index] ?? '')
                .split(',')
                .map((ref: string) => ref.trim())
                .filter(Boolean);
              return (
                <>
                  <p>
                    {paragraph}
                    {refs.length > 0 && (
                      <sup class="cite-refs" aria-label={`出典 ${refs.join('、')}`}>
                        {refs.map((ref: string, refIndex: number) => (
                          <>
                            {refIndex > 0 && <span aria-hidden="true">,</span>}
                            <a href={`#source-${ref}`}>{ref}</a>
                          </>
                        ))}
                      </sup>
                    )}
                  </p>
                  {imagesAfter.length > 0 && renderMedia(imagesAfter)}
                </>
              );
            })}
            {trailingImages.length > 0 && renderMedia(trailingImages)}
            {item.linkUrl && (
              <a class="deep-link" href={item.linkUrl} target="_blank" rel="noopener">
                {item.linkLabel || '関連資料を見る'} <span aria-hidden="true">↗</span>
              </a>
            )}
            {compactMedia && images.length > 0 && (
              <dialog class="deep-lightbox" data-deep-lightbox aria-label={`${item.title} 画像拡大表示`}>
                <div class="deep-lightbox__panel">
                  <button type="button" class="deep-lightbox__close" data-deep-close aria-label="拡大表示を閉じる">×</button>
                  <button type="button" class="deep-lightbox__nav deep-lightbox__prev" data-deep-prev aria-label="前の画像">‹</button>
                  <figure>
                    <img data-deep-lightbox-image alt="" />
                    <figcaption data-deep-lightbox-caption></figcaption>
                  </figure>
                  <button type="button" class="deep-lightbox__nav deep-lightbox__next" data-deep-next aria-label="次の画像">›</button>
                </div>
              </dialog>
            )}
          </div>
        </details>
      );
    })}
  </div>
</section>

<script>
  const initDeepGalleries = () => {
    document.querySelectorAll('[data-deep-gallery="true"]').forEach((galleryNode) => {
      const gallery = galleryNode as HTMLElement;
      if (gallery.dataset.deepGalleryReady === 'true') return;

      const dialog = gallery.querySelector('[data-deep-lightbox]') as HTMLDialogElement | null;
      const image = gallery.querySelector('[data-deep-lightbox-image]') as HTMLImageElement | null;
      const caption = gallery.querySelector('[data-deep-lightbox-caption]') as HTMLElement | null;
      const triggers = Array.from(gallery.querySelectorAll('[data-deep-index]')) as HTMLButtonElement[];
      if (!dialog || !image || !caption || triggers.length === 0) return;

      gallery.dataset.deepGalleryReady = 'true';
      let current = 0;

      const show = (index: number) => {
        current = (index + triggers.length) % triggers.length;
        const trigger = triggers[current];
        image.src = trigger.dataset.src || '';
        image.alt = trigger.dataset.alt || '';
        caption.textContent = trigger.dataset.caption || '';
        caption.hidden = !caption.textContent;
      };

      triggers.forEach((trigger, index) => {
        trigger.addEventListener('click', () => {
          show(index);
          dialog.showModal();
        });
      });

      dialog.querySelector('[data-deep-close]')?.addEventListener('click', () => dialog.close());
      dialog.querySelector('[data-deep-prev]')?.addEventListener('click', () => show(current - 1));
      dialog.querySelector('[data-deep-next]')?.addEventListener('click', () => show(current + 1));

      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });

      dialog.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          show(current - 1);
        } else if (event.key === 'ArrowRight') {
          event.preventDefault();
          show(current + 1);
        }
      });
    });
  };

  initDeepGalleries();
  document.addEventListener('astro:page-load', initDeepGalleries);
</script>

<style>
  .deep-media{display:grid;grid-template-columns:minmax(0,1fr);gap:18px;margin:22px 0 28px}
  .deep-media figure{margin:0}
  .deep-media img{display:block;width:100%;height:auto;border:1px solid rgba(31,28,24,.16)}
  .deep-media figcaption{margin-top:8px;font-size:13px;line-height:1.7;opacity:.72}
  .deep-media--compact{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px 12px;max-width:600px;margin:20px auto 26px;align-items:start}
  .deep-media--compact figure{min-width:0}
  .deep-media--compact .deep-media__full{grid-column:1/-1;width:min(100%,360px);justify-self:center}
  .deep-media--compact figcaption{font-size:12px;line-height:1.6}
  .deep-zoom{display:block;width:100%;padding:0;border:0;background:transparent;cursor:zoom-in;text-align:inherit}
  .deep-zoom img{transition:opacity .18s ease}
  .deep-zoom:hover img{opacity:.9}
  .deep-zoom:focus-visible{outline:2px solid var(--red,#934932);outline-offset:3px}
  .deep-lightbox{width:100vw;height:100dvh;max-width:none;max-height:none;margin:auto;padding:0;border:0;background:transparent;color:#fff;overflow:hidden}
  .deep-lightbox::backdrop{background:rgba(12,12,10,.88)}
  .deep-lightbox__panel{position:relative;width:100%;height:100%;display:grid;place-items:center;padding:48px 64px 36px;box-sizing:border-box}
  .deep-lightbox figure{margin:0;max-width:min(92vw,1100px);max-height:88vh;display:grid;gap:10px;justify-items:center}
  .deep-lightbox img{display:block;width:auto;height:auto;max-width:100%;max-height:78vh;border:1px solid rgba(255,255,255,.16);object-fit:contain}
  .deep-lightbox figcaption{max-width:760px;margin:0;color:#fff;font-size:13px;line-height:1.65;text-align:left;opacity:.9}
  .deep-lightbox__close,.deep-lightbox__nav{position:absolute;z-index:1;display:grid;place-items:center;width:42px;height:42px;padding:0;border:1px solid rgba(255,255,255,.45);border-radius:50%;background:rgba(0,0,0,.4);color:#fff;font:400 28px/1 var(--sans,sans-serif);cursor:pointer}
  .deep-lightbox__close{top:18px;right:18px;font-size:24px}
  .deep-lightbox__prev{left:16px;top:50%;transform:translateY(-50%)}
  .deep-lightbox__next{right:16px;top:50%;transform:translateY(-50%)}
  .deep-lightbox__close:focus-visible,.deep-lightbox__nav:focus-visible{outline:2px solid #fff;outline-offset:3px}
  .deep-link{display:inline-flex;gap:8px;align-items:center;margin:8px 0 4px;padding-bottom:3px;border-bottom:1px solid currentColor;text-decoration:none;font-size:14px;font-weight:600;letter-spacing:.01em}
  .deep-link span{font-size:12px}
  .cite-refs{margin-left:.18em;font:600 10px/1 var(--sans, sans-serif);vertical-align:super;white-space:nowrap}
  .cite-refs a{color:var(--red,#934932);text-decoration:none;border-bottom:1px solid transparent}
  .cite-refs a:hover,.cite-refs a:focus-visible{border-bottom-color:currentColor}
  .cite-refs span{color:var(--soft,#58634e);margin:0 .08em}
  @media(max-width:480px){
    .deep-media{margin:18px 0 24px;gap:14px}
    .deep-media figcaption{font-size:12px;line-height:1.65}
    .deep-media--compact{gap:12px 8px;margin:18px auto 24px}
    .deep-media--compact .deep-media__full{width:min(100%,280px)}
    .deep-media--compact figcaption{font-size:11px;line-height:1.55}
    .deep-lightbox__panel{padding:48px 12px 72px}
    .deep-lightbox figure{max-width:94vw;max-height:82vh}
    .deep-lightbox img{max-height:72vh}
    .deep-lightbox figcaption{max-width:92vw;font-size:12px;line-height:1.55}
    .deep-lightbox__close{top:12px;right:12px}
    .deep-lightbox__prev{left:12px;top:auto;bottom:14px;transform:none}
    .deep-lightbox__next{right:12px;top:auto;bottom:14px;transform:none}
  }
</style>
