---
type Lang = 'en' | 'de';
const { lang } = Astro.props as { lang: Lang };

const copy = {
  en: {
    chapter: '07 | PRESENT: SMARTWATCH',
    subtitle: 'Smartwatch',
    lead: 'Alarms, notifications, health, connection.',
    endpoint: 'Where we are now.',
    allIn: 'Everything we want, all in one.',
    stillEnough: 'Still not enough?',
    fatigue: 'Tired of notifications?',
    question: 'Is this really how much we wanted to be notified?',
    back: '← Back to a quieter age.',
    backTitle: 'Back to a quieter age',
    notices: [
      ['MSG', 'Messages', 'New message', '99+'],
      ['MAIL', 'Mail', '12 unread', '47'],
      ['CAL', 'Calendar', 'Lunch meeting · 11:30–12:30', '3'],
      ['MUS', 'Music', 'New Release · Listen now', ''],
      ['CALL', 'Phone', 'Missed call', '3'],
      ['LINE', 'LINE', 'New message', '99+'],
      ['WTHR', 'Weather', '22°C', ''],
      ['ALRM', 'Alarm', '7:00', ''],
      ['HR', 'Heart Rate', '72 bpm', ''],
      ['PHO', 'Photos', 'Memory created', '3'],
      ['TASK', 'Tasks', '3 tasks', '3'],
      ['MOVE', 'Activity', 'Move 560/500 kcal', ''],
      ['RUN', 'Workout', 'Outdoor Run · Goal reached', ''],
      ['NEWS', 'News', 'News digest', ''],
      ['MAP', 'Maps', '18 min home · heavy traffic', ''],
      ['STR', 'Stress', 'Moderate', ''],
      ['SLP', 'Sleep', 'Sleep score · Good', '12'],
      ['STK', 'Stocks', 'AAPL +1.32%', ''],
      ['MAIL', 'Mail', 'VIP mail', '5'],
      ['BP', 'Blood Pressure', '128/82 mmHg · Normal', ''],
      ['PAY', 'Payment', '¥1,480 · Complete', ''],
      ['HOME', 'Home', 'Living-room lights · On', ''],
      ['TMR', 'Timer', '15:00', ''],
      ['GPS', 'GPS', 'Sharing location', ''],
      ['TRN', 'Transit', 'Train delayed · 15 min', '2'],
      ['BAT', 'Battery', '34% remaining', ''],
      ['SOS', 'Emergency Alert', 'Earthquake warning', '1'],
      ['MIN', 'Mindfulness', '1 min', ''],
      ['TIME', 'Screen Time', 'Today · 7h 42m', '99+']
    ]
  },
  de: {
    chapter: '07 | GEGENWART: SMARTWATCH',
    subtitle: 'Smartwatch',
    lead: 'Alarm, Benachrichtigungen, Gesundheit, Vernetzung.',
    endpoint: 'Der heutige Stand.',
    allIn: 'Alles, was man will. Alles drin.',
    stillEnough: 'Reicht es immer noch nicht?',
    fatigue: 'Müde von Benachrichtigungen?',
    question: 'Wollten wir wirklich in diesem Ausmaß benachrichtigt werden?',
    back: '← Zurück in eine ruhigere Zeit.',
    backTitle: 'Zurück in eine ruhigere Zeit',
    notices: [
      ['MSG', 'Nachrichten', 'Neue Nachricht', '99+'],
      ['MAIL', 'Mail', '12 ungelesen', '47'],
      ['KAL', 'Kalender', 'Mittagstermin · 11:30–12:30', '3'],
      ['MUS', 'Musik', 'Neu erschienen · Jetzt hören', ''],
      ['TEL', 'Telefon', 'Verpasster Anruf', '3'],
      ['LINE', 'LINE', 'Neue Nachricht', '99+'],
      ['WET', 'Wetter', '22 °C', ''],
      ['WECK', 'Wecker', '7:00', ''],
      ['HF', 'Herzfrequenz', '72 bpm', ''],
      ['FOTO', 'Fotos', 'Erinnerung erstellt', '3'],
      ['AUF', 'Aufgaben', '3 Aufgaben', '3'],
      ['AKT', 'Aktivität', 'Bewegung 560/500 kcal', ''],
      ['RUN', 'Training', 'Lauf im Freien · Ziel erreicht', ''],
      ['NEWS', 'News', 'Nachrichtenüberblick', ''],
      ['KAR', 'Karten', '18 Min. nach Hause · dichter Verkehr', ''],
      ['STR', 'Stress', 'Mittel', ''],
      ['SLF', 'Schlaf', 'Schlafscore · Gut', '12'],
      ['AKT', 'Aktien', 'AAPL +1,32 %', ''],
      ['MAIL', 'Mail', 'VIP-Mail', '5'],
      ['BD', 'Blutdruck', '128/82 mmHg · Normal', ''],
      ['PAY', 'Zahlung', '¥1.480 · Abgeschlossen', ''],
      ['HOME', 'Zuhause', 'Wohnzimmerlicht · An', ''],
      ['TMR', 'Timer', '15:00', ''],
      ['GPS', 'GPS', 'Standort wird geteilt', ''],
      ['ÖPNV', 'ÖPNV', 'Zug verspätet · 15 Min.', '2'],
      ['BAT', 'Batterie', '34 % verbleibend', ''],
      ['SOS', 'Notfallwarnung', 'Erdbebenfrühwarnung', '1'],
      ['ACHT', 'Achtsamkeit', '1 Min.', ''],
      ['ZEIT', 'Bildschirmzeit', 'Heute · 7 Std. 42 Min.', '99+']
    ]
  }
} as const;

const c = copy[lang];
const beforeWatch = c.notices.slice(0, 8);
const afterWatch = c.notices.slice(8);
const notices = [...beforeWatch, ['WATCH', '', '', ''] as const, ...afterWatch];
---

<main class="smartwatch-localized" aria-labelledby="smartwatch-title">
  <section class="smartwatch-localized-inner">
    <header class="smartwatch-hero">
      <p class="smartwatch-series">HISTORY OF ALARM WRISTWATCHES</p>
      <p class="smartwatch-chapter">{c.chapter}</p>
      <h1 id="smartwatch-title">SMARTWATCH</h1>
      <p class="smartwatch-subtitle">{c.subtitle}</p>
      <p class="smartwatch-lead">{c.lead}</p>
    </header>

    <div class="notification-grid" aria-label={lang === 'en' ? 'Examples of smartwatch notifications and functions' : 'Beispiele für Smartwatch-Benachrichtigungen und -Funktionen'}>
      {notices.map((item) => item[0] === 'WATCH' ? (
        <div class="watch-visual" aria-hidden="true">
          <span class="watch-strap watch-strap-top"></span>
          <span class="watch-face">
            <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
          </span>
          <span class="watch-strap watch-strap-bottom"></span>
        </div>
      ) : (
        <div class="notice-card">
          <span class="notice-icon">{item[0]}</span>
          <span class="notice-copy">
            <strong>{item[1]}</strong>
            <small>{item[2]}</small>
          </span>
          {item[3] && <em>{item[3]}</em>}
        </div>
      ))}
    </div>

    <section class="smartwatch-bridge">
      <p>{c.endpoint}</p>
      <strong>{c.allIn}</strong>
    </section>

    <section class="smartwatch-closing">
      <h2>{c.stillEnough}</h2>
      <p class="smartwatch-fatigue">{c.fatigue}</p>
      <p class="smartwatch-question">{c.question}</p>
      <a href={lang === 'en' ? '/en/history/' : '/de/history/'} title={c.backTitle}>{c.back}</a>
    </section>
  </section>
</main>

<style>
  :global(html), :global(body) { margin: 0; background: #030303; }
  :global(body) { min-height: 100vh; color: #f0eee8; }
  .smartwatch-localized {
    min-height: 100vh;
    background:
      radial-gradient(circle at 50% 28%, rgba(65,82,80,.18), transparent 34%),
      radial-gradient(circle at 22% 72%, rgba(83,68,50,.14), transparent 28%),
      #030303;
  }
  .smartwatch-localized-inner {
    width: min(100%, 480px);
    margin-inline: auto;
    padding: 24px 14px 30px;
    box-sizing: border-box;
    overflow: hidden;
  }
  .smartwatch-hero { text-align: center; padding: 4px 0 18px; }
  .smartwatch-series {
    margin: 0;
    color: #aca48f;
    font: 500 9px/1.2 Georgia, "Times New Roman", serif;
    letter-spacing: .16em;
  }
  .smartwatch-chapter {
    margin: 7px 0 0;
    color: #b9b4a9;
    font: 500 9px/1.2 Georgia, "Times New Roman", serif;
    letter-spacing: .08em;
  }
  .smartwatch-hero h1 {
    margin: 10px 0 0;
    font: 700 clamp(38px, 11vw, 58px)/.94 Arial, Helvetica, sans-serif;
    letter-spacing: -.045em;
  }
  .smartwatch-subtitle {
    margin: 4px 0 0;
    color: #bcb7ad;
    font: 400 10px/1.3 Arial, Helvetica, sans-serif;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .smartwatch-lead {
    margin: 12px 0 0;
    color: #d6d2c9;
    font: 400 11px/1.5 Arial, Helvetica, sans-serif;
  }
  .notification-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 5px;
    position: relative;
  }
  .notice-card {
    position: relative;
    display: grid;
    grid-template-columns: 25px minmax(0, 1fr);
    gap: 6px;
    align-items: center;
    min-height: 43px;
    padding: 5px 6px;
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 9px;
    background: linear-gradient(145deg, rgba(34,34,34,.95), rgba(12,12,12,.96));
    box-sizing: border-box;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.035), 0 6px 18px rgba(0,0,0,.18);
  }
  .notice-icon {
    display: grid;
    place-items: center;
    width: 25px;
    height: 25px;
    border-radius: 7px;
    background: linear-gradient(145deg, #35574e, #1d2c29);
    color: #f6f5ef;
    font: 700 6px/1 Arial, Helvetica, sans-serif;
    letter-spacing: -.02em;
  }
  .notice-card:nth-child(4n+2) .notice-icon { background: linear-gradient(145deg, #6a493c, #33201b); }
  .notice-card:nth-child(4n+3) .notice-icon { background: linear-gradient(145deg, #564f78, #28243a); }
  .notice-card:nth-child(4n) .notice-icon { background: linear-gradient(145deg, #635923, #302b13); }
  .notice-copy { min-width: 0; }
  .notice-copy strong,
  .notice-copy small { display: block; overflow-wrap: anywhere; }
  .notice-copy strong {
    color: #f1efe9;
    font: 600 8.5px/1.15 Arial, Helvetica, sans-serif;
  }
  .notice-copy small {
    margin-top: 2px;
    color: #a9a59d;
    font: 400 7px/1.22 Arial, Helvetica, sans-serif;
  }
  .notice-card em {
    position: absolute;
    top: 4px;
    right: 4px;
    min-width: 14px;
    padding: 2px 3px;
    border-radius: 7px;
    background: #a92728;
    color: white;
    font: 700 6.5px/1 Arial, Helvetica, sans-serif;
    text-align: center;
    font-style: normal;
  }
  .watch-visual {
    position: relative;
    min-height: 92px;
    grid-row: span 2;
    display: grid;
    place-items: center;
  }
  .watch-face {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(3, 12px);
    grid-template-rows: repeat(3, 12px);
    gap: 5px;
    padding: 10px;
    border: 3px solid #6d6b66;
    border-radius: 17px;
    background: #090909;
    box-shadow: 0 0 0 2px #222, 0 8px 18px rgba(0,0,0,.48);
  }
  .watch-face i { width: 12px; height: 12px; border-radius: 50%; background: #2d6657; }
  .watch-face i:nth-child(2n) { background: #a45c39; }
  .watch-face i:nth-child(3n) { background: #495b91; }
  .watch-face i:nth-child(5n) { background: #a79339; }
  .watch-strap {
    position: absolute;
    left: 50%;
    width: 33px;
    height: 24px;
    transform: translateX(-50%);
    background: linear-gradient(90deg, #131313, #282828, #131313);
  }
  .watch-strap-top { top: 3px; border-radius: 6px 6px 0 0; }
  .watch-strap-bottom { bottom: 3px; border-radius: 0 0 6px 6px; }
  .smartwatch-bridge {
    margin: 22px -14px 0;
    padding: 32px 18px 30px;
    text-align: center;
    background: linear-gradient(180deg, rgba(13,13,13,.2), rgba(0,0,0,.9));
  }
  .smartwatch-bridge p {
    margin: 0;
    font: 400 23px/1.3 Georgia, "Times New Roman", serif;
  }
  .smartwatch-bridge strong {
    display: block;
    margin-top: 12px;
    font: 400 19px/1.4 Georgia, "Times New Roman", serif;
  }
  .smartwatch-closing {
    padding: 38px 16px 24px;
    text-align: center;
  }
  .smartwatch-closing h2 {
    margin: 0;
    font: 400 24px/1.35 Georgia, "Times New Roman", serif;
  }
  .smartwatch-fatigue {
    margin: 18px 0 0;
    color: #cbc6bc;
    font: 400 12px/1.5 Arial, Helvetica, sans-serif;
  }
  .smartwatch-question {
    max-width: 390px;
    margin: 8px auto 0;
    color: #d8d4cb;
    font: 400 11px/1.7 Arial, Helvetica, sans-serif;
  }
  .smartwatch-closing a {
    display: inline-block;
    margin-top: 28px;
    color: #b99a64;
    font: 400 12px/1.4 Georgia, "Times New Roman", serif;
    text-decoration: none;
  }
  .smartwatch-closing a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .smartwatch-closing a:focus-visible { outline: 2px solid #b99a64; outline-offset: 5px; border-radius: 2px; }

  @media (max-width: 360px) {
    .smartwatch-localized-inner { padding-inline: 10px; }
    .notification-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px; }
    .notice-card { min-height: 41px; }
    .smartwatch-bridge { margin-inline: -10px; }
  }
</style>
