---
const { sources, meta = [], lang = 'ja', research = null } = Astro.props;
const isEnglish = lang === 'en';
const isGerman = lang === 'de';
const sectionLabel = isEnglish ? 'References and sources' : isGerman ? 'Literatur und Quellen' : '参考資料・出典';
const typeLabel = isGerman
  ? {
      primary: 'PRIMÄRQUELLE',
      reference: 'REFERENZ',
      provenance: 'PROVENIENZ',
      owner: 'EIGENE BEOBACHTUNG'
    }
  : {
      primary: 'PRIMARY SOURCE',
      reference: 'REFERENCE',
      provenance: 'PROVENANCE',
      owner: 'OWNER OBSERVATION'
    };
const structured = Array.isArray(meta) && meta.length === sources.length;
const showResearch = !isEnglish && !isGerman && research?.summary?.length > 0;
const stripDuplicatedTypePrefix = (source: string, type?: string, label?: string) => {
  if (type !== 'owner') return source;
  const prefixes = [label, 'OWNER OBSERVATION', 'EIGENE BEOBACHTUNG'].filter(Boolean) as string[];
  let cleaned = source;
  for (const prefix of prefixes) {
    const escaped = prefix.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    cleaned = cleaned.replace(new RegExp(`^${escaped}\\s*(?:[—–:,-]\\s*)?`, 'i'), '');
  }
  return cleaned;
};
const parseInlineLink = (source: string) => {
  const match = source.match(/^(.*?)\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)(.*)$/);
  if (!match) return null;
  return {
    before: match[1],
    label: match[2],
    href: match[3],
    after: match[4]
  };
};
---
<section class="section shell sources" aria-label={sectionLabel} lang={lang}>
  <details>
    <summary>{isEnglish ? 'REFERENCES & SOURCES' : isGerman ? 'LITERATUR & QUELLEN' : '参考資料・出典'}</summary>
    {structured ? (
      <ol class="source-list">
        {sources.map((source: string, index: number) => {
          const itemMeta = meta[index];
          const id = itemMeta?.id || String(index + 1);
          const label = typeLabel[itemMeta?.type as keyof typeof typeLabel];
          const displaySource = stripDuplicatedTypePrefix(source, itemMeta?.type, label);
          const linkedSource = parseInlineLink(displaySource);

          return (
            <li id={`source-${id}`}>
              <span class="source-no" aria-hidden="true">{id}</span>
              <div class="source-copy">
                {label && <span class="source-kind">{label}</span>}
                <span>
                  {linkedSource ? (
                    <>
                      {linkedSource.before}
                      <a href={linkedSource.href} target="_blank" rel="noopener noreferrer">{linkedSource.label}</a>
                      {linkedSource.after}
                    </>
                  ) : displaySource}
                </span>
              </div>
            </li>
          );
        })}
      </ol>
    ) : (
      <ul>
        {sources.map((source: string) => <li>{source}</li>)}
      </ul>
    )}

    {showResearch && (
      <>
        <div class="research-record" data-research-record>
          <p class="research-heading">RESEARCH NOTE</p>
          <dl class="research-grid">
            {research.summary.map((item: { label: string; value: string }) => (
              <div>
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))}
          </dl>
        </div>

        {research.revisions?.length > 0 && (
          <div class="revision-record" data-revision-record>
            <p class="research-heading">REVISION</p>
            <ol class="revision-list">
              {research.revisions.map((revision: { date: string; note: string }) => (
                <li>
                  <time datetime={revision.date}>{revision.date}</time>
                  <span>{revision.note}</span>
                </li>
              ))}
            </ol>
          </div>
        )}
      </>
    )}
  </details>
</section>

<style>
  .source-list{list-style:none;margin:0;padding:6px 0 22px}
  .source-list li{display:grid;grid-template-columns:28px minmax(0,1fr);gap:12px;padding:18px 0;border-bottom:1px solid var(--rule,#bcc5b2);scroll-margin-top:24px}
  .source-list li:last-child{border-bottom:0}
  .source-no{color:var(--red,#934932);font:600 12px/1.5 var(--sans,sans-serif);padding-top:3px}
  .source-copy{min-width:0;color:var(--soft,#58634e);font-size:14px;line-height:1.9}
  .source-copy a{color:inherit;text-decoration-thickness:1px;text-underline-offset:3px}
  .source-kind{display:inline-block;margin:0 8px 6px 0;padding:2px 7px;border:1px solid var(--rule,#bcc5b2);font:600 10px/1.5 var(--sans,sans-serif);letter-spacing:.06em;color:var(--soft,#58634e);vertical-align:.08em}
  .research-record,.revision-record{border-top:1px solid var(--rule,#bcc5b2);padding:20px 0 8px}
  .revision-record{margin-top:16px}
  .research-heading{margin:0 0 8px;color:var(--soft,#58634e);font:500 11px/1.6 var(--sans,sans-serif);letter-spacing:.1em}
  .research-grid{margin:0}
  .research-grid>div{display:grid;grid-template-columns:150px minmax(0,1fr);gap:18px;padding:9px 0;border-top:1px solid var(--rule,#bcc5b2)}
  .research-grid dt,.research-grid dd{margin:0;font-size:13px;line-height:1.8}
  .research-grid dt{color:var(--soft,#58634e)}
  .research-grid dd{color:var(--ink,#232720)}
  .revision-list{list-style:none;margin:0;padding:0}
  .revision-list li{display:grid;grid-template-columns:150px minmax(0,1fr);gap:18px;padding:9px 0;border-top:1px solid var(--rule,#bcc5b2);font-size:13px;line-height:1.8}
  .revision-list time{color:var(--soft,#58634e);font-variant-numeric:tabular-nums}
  .revision-list span{color:var(--ink,#232720)}
  @media(max-width:480px){
    .source-list li{grid-template-columns:24px minmax(0,1fr);gap:10px;padding:16px 0}
    .source-copy{font-size:13px;line-height:1.85}
    .source-kind{font-size:9px}
    .research-record,.revision-record{padding-top:18px}
    .research-grid>div,.revision-list li{grid-template-columns:108px minmax(0,1fr);gap:12px;padding:8px 0}
    .research-grid dt,.research-grid dd,.revision-list li{font-size:12px;line-height:1.75}
  }
</style>
