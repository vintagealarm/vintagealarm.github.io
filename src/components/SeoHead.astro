---
interface AlternateLink {
  hreflang: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  robots?: string;
  locale?: string;
  alternates?: AlternateLink[];
}

const {
  title,
  description,
  path = '',
  image,
  type = 'website',
  schema,
  robots = 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1',
  locale = 'ja_JP',
  alternates = []
} = Astro.props;

const siteRoot = 'https://vintagealarm.github.io/';
const canonical = new URL(path.replace(/^\//, ''), siteRoot).toString();
const effectiveImage = image ?? '/images/history-motifs/before-watercolor.png';
const ogImage = effectiveImage.startsWith('http')
  ? effectiveImage
  : new URL(effectiveImage.replace(/^\//, ''), siteRoot).toString();
const normalizedAlternates = alternates.map((item) => ({
  hreflang: item.hreflang,
  href: item.href.startsWith('http') ? item.href : new URL(item.href.replace(/^\//, ''), siteRoot).toString()
}));
---
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />
{normalizedAlternates.map((item) => <link rel="alternate" hreflang={item.hreflang} href={item.href} />)}
<meta property="og:locale" content={locale} />
<meta property="og:site_name" content="VINTAGE ALARM" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

<!-- Performance / visitor analytics. Admin browsers can opt out with ?__va_analytics=off -->
<script is:inline>
  (() => {
    const key = 'vintageAlarmAnalyticsOptOut';
    try {
      const url = new URL(window.location.href);
      let toggle = url.searchParams.get('__va_analytics');

      // Accept both the canonical ?query#hash form and the common mistaken
      // #hash?query form so admin opt-out still works on anchored links.
      if (!toggle && url.hash.includes('?')) {
        const [hashPath, hashQuery = ''] = url.hash.split('?', 2);
        const hashParams = new URLSearchParams(hashQuery);
        const hashToggle = hashParams.get('__va_analytics');
        if (hashToggle === 'off' || hashToggle === 'on') {
          toggle = hashToggle;
          hashParams.delete('__va_analytics');
          const remainingHashQuery = hashParams.toString();
          url.hash = hashPath + (remainingHashQuery ? `?${remainingHashQuery}` : '');
        }
      }

      if (toggle === 'off') localStorage.setItem(key, '1');
      if (toggle === 'on') localStorage.removeItem(key);

      if (toggle === 'off' || toggle === 'on') {
        url.searchParams.delete('__va_analytics');
        history.replaceState(null, '', url.pathname + url.search + url.hash);
      }

      if (localStorage.getItem(key) === '1') {
        document.documentElement.dataset.vaAnalytics = 'off';
        return;
      }
    } catch {}

    // Diagnostic-only early arrival probe. It runs before the Cloudflare RUM
    // script so we can distinguish click→HTML arrival from HTML→RUM loss.
    try {
      const referrerSource = (() => {
        if (!document.referrer) return 'direct';
        try {
          const host = new URL(document.referrer).hostname.toLowerCase().replace(/^www\./, '');
          const currentHost = window.location.hostname.toLowerCase().replace(/^www\./, '');
          if (!host) return 'direct';
          if (host === currentHost) return 'internal';
          if (host === 't.co' || host === 'x.com' || host === 'twitter.com' || host === 'mobile.twitter.com') return 'x';
          if (host === 'facebook.com' || host === 'm.facebook.com' || host.endsWith('.facebook.com')) return 'facebook';
          if (host === 'instagram.com' || host.endsWith('.instagram.com')) return 'instagram';
          if (host === 'youtube.com' || host === 'm.youtube.com' || host === 'youtu.be') return 'youtube';
          if (host === 'watchuseek.com' || host.endsWith('.watchuseek.com')) return 'watchuseek';
          if (
            host === 'google.com' || host.startsWith('google.') || host.endsWith('.google.com') ||
            host === 'bing.com' || host.endsWith('.bing.com') ||
            host === 'duckduckgo.com' || host.endsWith('.duckduckgo.com') ||
            host === 'search.yahoo.com' || host.endsWith('.search.yahoo.com') ||
            host === 'yandex.com' || host.endsWith('.yandex.com') ||
            host === 'ecosia.org' || host.endsWith('.ecosia.org')
          ) return 'search';
          return 'other';
        } catch {
          return 'other';
        }
      })();

      const probeUrl = 'https://vintage-alarm-analytics.orima1995.workers.dev/api/arrival-probe';
      const probeBody = JSON.stringify({
        path: window.location.pathname,
        source: referrerSource
      });
      let queued = false;

      if (navigator.sendBeacon) {
        queued = navigator.sendBeacon(
          probeUrl,
          new Blob([probeBody], { type: 'text/plain;charset=UTF-8' })
        );
      }

      if (!queued) {
        fetch(probeUrl, {
          method: 'POST',
          mode: 'cors',
          keepalive: true,
          headers: { 'Content-Type': 'text/plain;charset=UTF-8' },
          body: probeBody
        }).catch(() => {});
      }
    } catch {}

    const beacon = document.createElement('script');
    beacon.defer = true;
    beacon.src = 'https://static.cloudflareinsights.com/beacon.min.js';
    beacon.dataset.cfBeacon = '{"token":"862adb1fcab1439f899cccf093361ee9"}';
    document.head.appendChild(beacon);
  })();
</script>
