---
import data from '../data/cyma-chronometre-research.json';

const { open = false } = Astro.props as { open?: boolean };
const goldSpecimens = data.observed.specimens.filter((item) => /YG|GOLD|14K|18K/i.test(item.case));
const steelSpecimens = data.observed.specimens.filter((item) => /SS|STEEL/i.test(item.case));
const total = goldSpecimens.length + steelSpecimens.length;
---
<details class="proto-specimens" open={open}>
  <summary><span>観測個体一覧を見る</span><small>{total}件</small></summary>
  <div class="proto-table-region" tabindex="0" role="region" aria-label="CYMA Time-O-Vox 18K・金色ケース観測個体一覧">
    <section class="proto-table-group">
      <h3>18K / YG<small>{goldSpecimens.length} OBJECTS</small></h3>
      <table>
        <thead><tr><th>CASE</th><th>CHRONOMÈTRE</th><th>ADJUSTMENT</th><th>MOV. No.帯</th><th>seller ref</th><th>年代</th><th>ダイヤル</th><th>CASE CODE</th><th>SOURCE</th><th>ID</th></tr></thead>
        <tbody>{goldSpecimens.map((row) => <tr><td>{row.case}</td><td>{row.chronometre}</td><td>{row.adjustment}</td><td>{row.movementBand}</td><td>{row.sellerRef}</td><td>{row.era}</td><td>{row.dial}</td><td>{row.caseCode}</td><td>{row.source}</td><td>{row.id}</td></tr>)}</tbody>
      </table>
    </section>
  </div>
  <details class="proto-specimen-subgroup">
    <summary><span>STAINLESS STEEL</span><small>{steelSpecimens.length}件</small></summary>
    <div class="proto-table-region" tabindex="0" role="region" aria-label="CYMA Time-O-Vox ステンレスケース観測個体一覧">
      <section class="proto-table-group proto-table-group--nested">
        <table>
          <thead><tr><th>CASE</th><th>CHRONOMÈTRE</th><th>ADJUSTMENT</th><th>MOV. No.帯</th><th>seller ref</th><th>年代</th><th>ダイヤル</th><th>CASE CODE</th><th>SOURCE</th><th>ID</th></tr></thead>
          <tbody>{steelSpecimens.map((row) => <tr><td>{row.case}</td><td>{row.chronometre}</td><td>{row.adjustment}</td><td>{row.movementBand}</td><td>{row.sellerRef}</td><td>{row.era}</td><td>{row.dial}</td><td>{row.caseCode}</td><td>{row.source}</td><td>{row.id}</td></tr>)}</tbody>
        </table>
      </section>
    </div>
  </details>
  <p class="proto-table-note">{data.observed.note}</p>
</details>
