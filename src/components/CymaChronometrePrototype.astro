---
import SectionMast from './SectionMast.astro';
import OwnerFonts from './OwnerFonts.astro';
import CymaSpecimenTables from './CymaSpecimenTables.astro';
import CymaResearchConclusion from './CymaResearchConclusion.astro';
import data from '../data/cyma-chronometre-research.json';

type Variant = 'owners' | 'history' | 'archive';
const { variant } = Astro.props as { variant: Variant };
const base = import.meta.env.BASE_URL;

const paths = {
  owners: `${base}lab/cyma-chronometre/owners-note/`,
  history: `${base}lab/cyma-chronometre/history/`,
  archive: `${base}lab/cyma-chronometre/archive/`
};
const labels = {
  owners: 'A / NOTE',
  history: 'B / HISTORY',
  archive: 'C / ARCHIVE'
};
const titles = {
  owners: "OWNER'S NOTE",
  history: 'HISTORY',
  archive: 'RESEARCH / ARCHIVE'
};
const goldSpecimens = data.observed.specimens.filter((item) => /YG|GOLD|14K|18K/i.test(item.case));
const steelSpecimens = data.observed.specimens.filter((item) => /SS|STEEL/i.test(item.case));
const totalSpecimens = goldSpecimens.length + steelSpecimens.length;

const logic = [
  {
    label: '根拠',
    title: '刻印と実際の調整状態が一致しない輸出例',
    body: '1956年の米国上院公聴会では、実際には調整されたスイス時計が、追加関税を避けるため「unadjusted」と表示されて輸入された問題が扱われた。PritchardはTavannesの例として、工場広告が全ムーブメントをpositionとtemperatureに調整すると記す一方、Washington, D.C.で購入された時計には「unadjusted」と刻印されていたとまとめている。'
  },
  {
    label: '観測',
    title: 'Time-O-VoxにもUNADJUSTED刻印がある',
    body: '観測17件のうち、金色ケースとステンレスケースの双方でUNADJUSTED刻印を確認した。別の個体では、文字盤にChronomètre表記がなくても、ムーブメントに5姿勢・温度調整の刻印がある。'
  },
  {
    label: '推論',
    title: 'UNADJUSTEDだけでは、Chronomètre仕様を除外できない',
    body: 'Tavannes系で刻印と実際の調整状態が一致しない輸出例があった以上、UNADJUSTED刻印のTime-O-Voxが実際には調整済みで、Chronomètre仕様として出荷された可能性は残る。ただし、特定個体の認定を証明するには、証明書や観測所台帳など別の記録が必要になる。'
  }
];

const proofQuote = '“Before leaving the factory, every Tavannes movement is adjusted for position and temperature.”';
const proofQuoteJa = '「工場を出る前に、すべてのTavannesムーブメントは姿勢と温度について調整される。」';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content={variant === 'history' ? '#1c201c' : '#f7f8f4'} />
    <OwnerFonts />
    <title>CYMA Time-O-Vox Chronomètre — {titles[variant]}｜VINTAGE ALARM</title>
  </head>
  <body class:list={['cyma-proto', `cyma-proto--${variant}`, variant === 'owners' && 'owners-v15', variant === 'history' && 'history-v13 history-v18']}>
    <div class="proto-mast"><SectionMast rightLabel="CYMA / R.464" /></div>
    <nav class="proto-switcher" aria-label="表示切り替え">
      <div class="shell">
        {(Object.keys(paths) as Variant[]).map((key) => (
          <a href={paths[key]} aria-current={key === variant ? 'page' : undefined}>{labels[key]}</a>
        ))}
      </div>
    </nav>

    {variant === 'owners' && (
      <main class="proto-owner">
        <header class="proto-owner-hero shell">
          <div class="proto-owner-title">
            <p class="proto-kicker">CYMA / CAL. R.464</p>
            <h1><span>Time-O-Vox</span><span>Chronomètre</span></h1>
            <p class="proto-owner-deck">文字盤に「CHRONOMÈTRE」と記された18KケースのTime-O-Vox。企業資料と専門書にはChronomètre仕様の記録がある一方、現存個体の表記と調整刻印は一様ではない。さらに個体を追う過程で、資料上の正常仕様とは異なるアラーム挙動も少なくとも3例で確認した。</p>
          </div>
          <figure class="proto-owner-watch">
            <img src={`${base}images/cyma-time-o-vox/gallery/cyma-front.jpg`} alt="CYMA Time-O-Vox 18K Chronomètre 掲載個体" />
            <figcaption>18K YELLOW GOLD / CAL. R.464</figcaption>
          </figure>
        </header>

        <article class="proto-owner-story shell">
          <section class="proto-owner-section" id="owners-documented">
            <header><span>01</span><div><small>DOCUMENTED</small><h2>Time-O-VoxにもChronomètreがあった</h2></div></header>
            <div class="proto-owner-copy">
              <dl class="proto-source-ledger">
                <div><dt>01</dt><dd><small>CYMA / D_7938</small><strong>金製Time-O-Voxへのクロノメーター証明</strong><p>MIHから共有されたCYMAの企業資料には、金製アラーム腕時計「Time-O-Vox」がクロノメーター証明を受けたと記されている。</p></dd></div>
                <div><dt>02</dt><dd><small>MICHAEL PHILIP HORLBECK</small><strong>5姿勢と温度による試験</strong><p>『The Alarm Wristwatch』は、Cal.R.464を搭載したTime-O-Voxにクロノメーター証明付きの仕様があり、そのムーブメントは5姿勢と温度で試験されたと記す。</p></dd></div>
                <div><dt>03</dt><dd><small>LEONHARD BEITL</small><strong>文字盤に表記がないChronomètre個体</strong><p>『Alarm am Arm』には、文字盤とムーブメントの双方にChronomètre表記を持つ金ケース個体に加え、文字盤には表記がない一方、ムーブメントにChronometerの表記を持つ別個体も掲載されている。</p></dd></div>
              </dl>
              <p>Time-O-VoxにChronomètre仕様が存在したことは、複数の資料から確認できる。だが、Chronomètreという語がどこに記されたかは、個体ごとに異なっている。</p>
            </div>
          </section>

          <section class="proto-owner-section" id="owners-observed">
            <header><span>02</span><div><small>OBSERVED</small><h2>表記が揃わない</h2></div></header>
            <div class="proto-owner-copy">
              <p>公開資料から確認できた17件には、文字盤の表記だけではムーブメントの状態を判断できない例が含まれている。</p>
              <dl class="proto-source-ledger">
                <div><dt>01</dt><dd><small>18K / CHRONOMÈTRE</small><strong>文字盤はChronomètre</strong><p>掲載個体は18Kケースで、文字盤にCHRONOMÈTREとある。ムーブメント写真では、5姿勢・温度調整を示す刻印を確認できない。</p></dd></div>
                <div><dt>02</dt><dd><small>YG / FIVE POSITIONS + TEMPERATURE</small><strong>表記なし、5姿勢・温度調整</strong><p>金色ケースの観測例には、文字盤にChronomètre表記がなく、ムーブメントに「ADJUSTED TO FIVE POSITION(S) AND TEMPERATURE」と刻まれた個体がある。</p></dd></div>
                <div><dt>03</dt><dd><small>YG / UNADJUSTED</small><strong>金色ケース、UNADJUSTED</strong><p>金色ケースには、ムーブメントにUNADJUSTEDと刻まれた個体もある。ケース素材、文字盤表記、調整刻印の組み合わせは一定していない。</p></dd></div>
              </dl>
              <CymaSpecimenTables />
            </div>
          </section>

          <section class="proto-owner-section proto-owner-logic" id="owners-unadjusted">
            <header><span>03</span><div><small>UNADJUSTED</small><h2>Tavannesで起きていたこと</h2></div></header>
            <div class="proto-owner-copy">
              <p>1956年、米国上院の公聴会は、実際には調整されていたスイス時計が「unadjusted」と表示され、米国へ輸入されていた問題を扱った。調整済み時計に課される追加関税を避けるためだった。</p>
              <blockquote><p lang="en">{proofQuote}</p><footer>{proofQuoteJa}</footer></blockquote>
              <p>Pritchardはその具体例としてTavannesを挙げている。工場の広告は、すべてのムーブメントを姿勢と温度について調整すると記していた。一方、Washington, D.C.で購入されたTavannes時計には「unadjusted」と刻印されていた。</p>
              <p>PritchardのTavannes項目には、CYMA WATCH CO. SAもグループ企業として記載されている。少なくともTavannesの米国向け時計では、UNADJUSTEDという刻印と実際の調整状態が一致しない例があった。</p>
              <p>金色ケースのTime-O-VoxにあるUNADJUSTED刻印も、それだけで未調整の証拠にはならない。調整済みだった可能性は残るが、クロノメーター試験を通過したかどうかは、別の記録がなければ確定できない。</p>
            </div>
          </section>

          <section class="proto-owner-section" id="owners-archive">
            <header><span>04</span><div><small>ARCHIVE</small><h2>なぜ掲載個体の証明書まで辿れないのか</h2></div></header>
            <div class="proto-owner-copy proto-institution-list">
              <article><small>MIH / 18 SEP. 2025</small><h3>モデルに直接結びつく文書は未発見</h3><p>国際時計博物館（MIH）は、Time-O-Vox Chronomètreに直接関係する文書は見つからなかったと回答した。その一方で、CYMAの企業資料に金製アラーム腕時計へのクロノメーター証明の記述があるとして、D_7938を共有した。</p></article>
              <article><small>NEUCHÂTEL / 14 NOV. 2025</small><h3>掲載個体を特定できず</h3><p>Neuchâtel州立公文書館は、1954年から1958年までの8冊のBT台帳を調べたが、掲載個体に対応する試験記録を特定できなかった。ただし、1956年以降にはCyma Watch Co. SA, Le Locle名義で、Arnold Racineが調整を担当した試験記録が残っている。</p></article>
              <p>掲載個体のムーブメント番号やケース番号は、観測所の記録番号と同じものではない。文字盤のCHRONOMÈTREと、特定の証明書や台帳記録を結びつける資料は、現在まで確認できていない。</p>
            </div>
          </section>

          <section class="proto-owner-section proto-owner-field-section" id="owners-field-note">
            <header><span>05</span><div><small>FIELD NOTE</small><h2>ニュートラル以外でも鳴る</h2></div></header>
            <div class="proto-owner-copy">
              <p>{data.failure.normalBody}</p>

              <div class="proto-owner-field-media" aria-label="掲載個体のプッシャー配置とCal.R.464ムーブメント">
                <figure>
                  <img src={`${base}images/cyma-time-o-vox/gallery/cyma-side-pushers.jpg`} alt="CYMA Time-O-Vox 掲載個体の上下プッシャーとリューズ" />
                  <figcaption>掲載個体の操作系。上下のプッシャーがR.464の切替機構を動かす。</figcaption>
                </figure>
                <figure>
                  <img src={`${base}images/cyma-time-o-vox/gallery/cyma-movement-r464.jpg`} alt="CYMA Time-O-Vox Cal.R.464 ムーブメント" />
                  <figcaption>掲載個体のCal.R.464。内部写真は掲載個体の原因候補を考える材料であり、他個体の内部状態を示すものではない。</figcaption>
                </figure>
              </div>

              <div class="proto-owner-field-observation">
                <div class="proto-owner-field-heading">
                  <small>OBSERVED / 3 EXAMPLES</small>
                  <h3>{data.failure.observedTitle}</h3>
                </div>
                <p>{data.failure.observedBody}</p>
                <ol>
                  {data.failure.examples.map((example, index) => (
                    <li><span>0{index + 1}</span><strong>{example}</strong><small>片側プッシャー押し込み状態での鳴動を目視確認</small></li>
                  ))}
                </ol>
              </div>

              <div class="proto-owner-field-hypothesis">
                <small>HYPOTHESIS / LISTED SPECIMEN ONLY</small>
                <h3>{data.failure.hypothesisTitle}</h3>
                <p>{data.failure.hypothesisBody}</p>
              </div>

              <p class="proto-owner-field-caution">3例で共通しているのは「ニュートラルではない状態でも鳴る」という外から確認できる挙動まで。内部原因が同じかどうかは、掲載個体以外では確認できていない。</p>
            </div>
          </section>
        </article>
      </main>
    )}

    {variant === 'history' && (
      <main class="proto-history">
        <header class="proto-history-cover">
          <div class="shell">
            <div class="proto-history-meta"><span>CASE HISTORY / 1955–2025</span><span>CYMA R.464</span></div>
            <h1><span>TIME-O-VOX</span><em>CHRONOMÈTRE</em><small>記録と現存個体</small></h1>
            <p>存在の記録から、17件の観測、UNADJUSTEDの制度背景、未接続の認定記録まで。</p>
          </div>
        </header>
        <nav class="proto-history-nav" aria-label="章ナビゲーション"><div class="shell"><a href="#history-01">1955</a><a href="#history-02">17 OBJECTS</a><a href="#history-03">UNADJUSTED</a><a href="#history-04">ARCHIVE</a><a href="#history-05">FIELD NOTE</a></div></nav>

        <article class="proto-history-chapters">
          <details id="history-01" open>
            <summary><span>01</span><div><small>c.1955 / DOCUMENTED</small><h2>Chronomètre仕様が記録される</h2><p>企業資料と二冊の専門書を重ねる。</p></div><i aria-hidden="true"></i></summary>
            <div class="shell proto-history-body">
              <div class="proto-history-copy"><p>CYMA企業資料は、金製Time-O-Voxへのクロノメーター証明を記す。Horlbeckは5姿勢と温度の試験、Beitlは文字盤とムーブメントの表記差を記録している。</p></div>
              <dl class="proto-history-ledger">{data.documented.cards.map((card, index) => <div><dt>DOC.0{index + 1}</dt><dd><strong>{card.title}</strong><p>{card.body}</p></dd></div>)}</dl>
            </div>
          </details>

          <details id="history-02">
            <summary><span>02</span><div><small>CURRENTLY OBSERVED</small><h2>17件を並べる</h2><p>18K / YGからSSへ。番号は帯域で見る。</p></div><i aria-hidden="true"></i></summary>
            <div class="shell proto-history-body"><div class="proto-history-copy"><p>{data.observed.intro}</p></div><CymaSpecimenTables open /></div>
          </details>

          <details id="history-03" open>
            <summary><span>03</span><div><small>1956 / U.S. TARIFF</small><h2>UNADJUSTEDでも、除外できない</h2><p>根拠、観測、推論を順に追う。</p></div><i aria-hidden="true"></i></summary>
            <div class="shell proto-history-body">
              <div class="proto-history-quote"><p lang="en">{proofQuote}</p><span>{proofQuoteJa}</span></div>
              <div class="proto-history-logic">{logic.map((item) => <article><small>{item.label}</small><h3>{item.title}</h3><p>{item.body}</p></article>)}</div>
            </div>
          </details>

          <details id="history-04">
            <summary><span>04</span><div><small>2025 / INSTITUTIONAL REPLIES</small><h2>認定記録との接続を探す</h2><p>未発見と不存在を分ける。</p></div><i aria-hidden="true"></i></summary>
            <div class="shell proto-history-body"><div class="proto-history-archive">{data.archive.cards.map((card) => <article><small>{card.label}</small><h3>{card.title}</h3><p>{card.body}</p></article>)}</div><p class="proto-note">{data.archive.note}</p></div>
          </details>

          <details id="history-05">
            <summary><span>05</span><div><small>FIELD NOTE</small><h2>正常仕様と、現存個体の挙動差</h2><p>片側プッシャー押し込み状態でも鳴る。</p></div><i aria-hidden="true"></i></summary>
            <div class="shell proto-history-body proto-history-field"><img src={`${base}images/cyma-time-o-vox/gallery/cyma-movement-r464.jpg`} alt="CYMA Time-O-Vox Cal.R.464 ムーブメント"/><div><h3>{data.failure.normalTitle}</h3><p>{data.failure.normalBody}</p><h3>{data.failure.observedTitle}</h3><p>{data.failure.observedBody}</p><h3>{data.failure.hypothesisTitle}</h3><p>{data.failure.hypothesisBody}</p></div></div>
          </details>

          <CymaResearchConclusion />
        </article>
      </main>
    )}

    {variant === 'archive' && (
      <main class="proto-archive">
        <header class="proto-archive-head shell">
          <div class="proto-archive-code"><span>VA / R-01</span><span>REV. 2026-09</span></div>
          <p class="proto-kicker">CYMA TIME-O-VOX / CAL. R.464</p>
          <h1>CHRONOMÈTRE<br /><span>RESEARCH FILE</span></h1>
          <p class="proto-archive-deck">資料が示すこと、現存個体で見えること、そこから残る推論を一つの照合台帳にまとめる。</p>
        </header>

        <article class="proto-archive-flow shell">
          <section class="proto-archive-section" id="archive-documents">
            <header><span>FILE 01</span><h2>存在を記録する三つの資料</h2></header>
            <ol class="proto-document-list">{data.documented.cards.map((card, index) => <li><span>DOC.0{index + 1}</span><div><small>{card.label}</small><h3>{card.title}</h3><p>{card.body}</p></div></li>)}</ol>
          </section>

          <section class="proto-archive-section" id="archive-observed">
            <header><span>FILE 02</span><h2>OBSERVED OBJECTS / {totalSpecimens}</h2></header>
            <p>{data.observed.intro}</p>
            <CymaSpecimenTables />
          </section>

          <section class="proto-archive-section" id="archive-inference">
            <header><span>FILE 03</span><h2>ADJUSTED / UNADJUSTED</h2></header>
            <div class="proto-archive-quote"><p lang="en">{proofQuote}</p><span>{proofQuoteJa}</span></div>
            <div class="proto-archive-logic">{logic.map((item, index) => <article><span>0{index + 1}</span><div><small>{item.label}</small><h3>{item.title}</h3><p>{item.body}</p></div></article>)}</div>
          </section>

          <section class="proto-archive-section" id="archive-institutions">
            <header><span>FILE 04</span><h2>INSTITUTIONAL REPLIES / 2025</h2></header>
            <div class="proto-document-list">{data.archive.cards.map((card, index) => <article><span>REP.0{index + 1}</span><div><small>{card.label}</small><h3>{card.title}</h3><p>{card.body}</p></div></article>)}</div>
            <p class="proto-note">{data.archive.note}</p>
          </section>

          <section class="proto-archive-section" id="archive-field">
            <header><span>FILE 05</span><h2>FIELD NOTE / PUSHER LOCK</h2></header>
            <figure class="proto-archive-figure"><img src={`${base}images/cyma-time-o-vox/gallery/cyma-movement-r464.jpg`} alt="CYMA Time-O-Vox Cal.R.464 ムーブメント"/><figcaption>OBSERVED UNIT / CAL. R.464</figcaption></figure>
            <div class="proto-archive-field-grid"><article><small>NORMAL</small><h3>{data.failure.normalTitle}</h3><p>{data.failure.normalBody}</p></article><article><small>OBSERVED</small><h3>{data.failure.observedTitle}</h3><p>{data.failure.observedBody}</p></article><article><small>HYPOTHESIS</small><h3>{data.failure.hypothesisTitle}</h3><p>{data.failure.hypothesisBody}</p></article></div>
          </section>

          <CymaResearchConclusion />
        </article>
      </main>
    )}

    <footer class="proto-footer shell">
      <details><summary>SOURCES / 使用資料</summary><ol>{data.sources.map((source) => <li>{source}</li>)}</ol></details>
      <a href={`${base}cyma-time-o-vox/chronometre/`}>現行RESEARCHページを見る →</a>
    </footer>
  </body>
</html>
