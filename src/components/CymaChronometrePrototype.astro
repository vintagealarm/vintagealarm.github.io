---
import SectionMast from './SectionMast.astro';
import OwnerFonts from './OwnerFonts.astro';
import CymaSpecimenTables from './CymaSpecimenTables.astro';
import CymaResearchConclusion from './CymaResearchConclusion.astro';
import SeoHead from './SeoHead.astro';
import JapaneseProse from './JapaneseProse.astro';
import data from '../data/cyma-chronometre-research.json';
import { getGitLastmod, latestDate } from '../lib/git-lastmod';

type Variant = 'owners' | 'history' | 'archive';
const { variant, production = false } = Astro.props as { variant: Variant; production?: boolean };
const base = import.meta.env.BASE_URL;

const titles = {
  owners: '個体ノート',
  history: '年代記',
  archive: '資料'
};

const siteRoot='https://vintagealarm.github.io/';
const productionPath='cyma-time-o-vox/chronometre/';
const productionUrl=new URL(productionPath,siteRoot).href;
const productionTitle='Cyma Time-O-Vox Chronomètre｜観測個体と認定記録｜VINTAGE ALARM';
const productionDescription='Cyma Time-O-Vox Chronomètreを、文献・17件の観測個体・外部照会・UNADJUSTED刻印・実機観察から整理する。';
const productionImage='/images/cyma-time-o-vox/gallery/cyma-front.jpg';
const dateModified=latestDate(
  getGitLastmod('src/data/cyma-chronometre-research.json'),
  getGitLastmod('src/components/CymaChronometrePrototype.astro'),
  getGitLastmod('src/pages/cyma-time-o-vox/chronometre/index.astro')
);
const productionSchema={
  '@context':'https://schema.org',
  '@graph':[
    {
      '@type':'Article',
      headline:'CYMA Time-O-Vox Chronomètre — 観測個体と認定記録',
      description:productionDescription,
      inLanguage:'ja',
      url:productionUrl,
      image:new URL(productionImage.replace(/^\//,''),siteRoot).href,
      ...(dateModified?{dateModified}:{}),
      author:{'@type':'Organization',name:'VINTAGE ALARM',url:siteRoot},
      publisher:{'@type':'Organization',name:'VINTAGE ALARM',url:siteRoot},
      mainEntityOfPage:{'@type':'WebPage','@id':productionUrl},
      about:{'@type':'Thing',name:'Cyma Time-O-Vox Chronomètre'}
    },
    {
      '@type':'BreadcrumbList',
      itemListElement:[
        {'@type':'ListItem',position:1,name:'VINTAGE ALARM',item:siteRoot},
        {'@type':'ListItem',position:2,name:'CYMA TIME-O-VOX',item:new URL('cyma-time-o-vox/',siteRoot).href},
        {'@type':'ListItem',position:3,name:'CHRONOMÈTRE',item:productionUrl}
      ]
    }
  ]
};
const goldSpecimens = data.observed.specimens.filter((item) => /YG|GOLD|14K|18K/i.test(item.case));
const steelSpecimens = data.observed.specimens.filter((item) => /SS|STEEL/i.test(item.case));
const totalSpecimens = goldSpecimens.length + steelSpecimens.length;

const logic = [
  {
    label: '根拠',
    title: '刻印と実際の調整状態が一致しない輸出例',
    body: '1956年の米国上院公聴会では、実際には調整されたスイス時計が、追加関税を避けるため「unadjusted」と表示されて輸入された問題が扱われた。PritchardはTavannesの例として、工場広告が全ムーブメントをpositionとtemperatureに調整すると記す一方、Washington, D.C.で購入された時計には「unadjusted」と刻印されていたとまとめている。'
  },
  {
    label: '観測',
    title: 'Time-O-VoxにもUNADJUSTED刻印がある',
    body: '観測17件のうち、金色ケースとステンレスケースの双方でUNADJUSTED刻印を確認した。別の個体では、文字盤にChronomètre表記がなくても、ムーブメントに5姿勢・温度調整の刻印がある。'
  },
  {
    label: '推論',
    title: 'UNADJUSTEDだけでは、Chronomètre仕様を除外できない',
    body: 'Tavannes系で刻印と実際の調整状態が一致しない輸出例があった以上、UNADJUSTED刻印のTime-O-Voxが実際には調整済みで、Chronomètre仕様として出荷された可能性は残る。ただし、特定個体の認定を証明するには、証明書や観測所台帳など別の記録が必要になる。'
  }
];

const proofQuote = '“Before leaving the factory, every Tavannes movement is adjusted for position and temperature.”';
const proofQuoteJa = '「工場を出る前に、すべてのTavannesムーブメントは姿勢と温度について調整される。」';
const heroImage = data.heroImage || '/images/cyma-time-o-vox/gallery/cyma-front.jpg';
const getYouTubeId = (value: string) => {
  const input=value?.trim();
  if(!input) return '';
  if(!input.includes('/')&&!input.includes('.')) return input;
  try{
    const url=new URL(input);
    const host=url.hostname.replace(/^www\\./,'');
    if(host==='youtu.be') return url.pathname.split('/').filter(Boolean)[0]??'';
    if(host==='youtube.com'||host==='m.youtube.com'){
      const queryId=url.searchParams.get('v');
      if(queryId) return queryId;
      const parts=url.pathname.split('/').filter(Boolean);
      if(['shorts','embed','live'].includes(parts[0])) return parts[1]??'';
    }
  }catch{return input;}
  return input;
};
const failureVideoId=getYouTubeId(data.failure.youtubeId||'');
const resolveMedia=(value:string)=>/^https?:\/\//.test(value) ? value : `${base}${value.replace(/^\//,'')}`;
const failureImages=data.failure.images?.filter((item)=>item.image)??[];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {!production && <meta name="robots" content="noindex,nofollow" />}
    <meta name="theme-color" content={variant === 'history' ? '#1c201c' : '#f7f8f4'} />
    <OwnerFonts />
    {production
      ? <SeoHead title={productionTitle} description={productionDescription} path={productionPath} image={productionImage} type="article" schema={productionSchema} alternates={[{hreflang:'ja',href:productionUrl},{hreflang:'en',href:new URL('en/cyma-time-o-vox/chronometre/',siteRoot).href},{hreflang:'de',href:new URL('de/cyma-time-o-vox/chronometre/',siteRoot).href},{hreflang:'x-default',href:productionUrl}]} />
      : <title>CYMA Time-O-Vox Chronomètre — {titles[variant]}｜VINTAGE ALARM</title>}
  </head>
  <body class:list={['cyma-proto', `cyma-proto--${variant}`, variant === 'owners' && 'owners-v15', variant === 'history' && 'history-v13 history-v18']}>
    <div class="proto-mast"><SectionMast rightLabel="CYMA / R.464" languageLinks={production ? [{ href: '/en/cyma-time-o-vox/chronometre/', label: 'EN', hreflang: 'en' }, { href: '/de/cyma-time-o-vox/chronometre/', label: 'DE', hreflang: 'de' }] : undefined} /></div>
    {variant === 'owners' && (
      <main class="proto-owner">
        <header class="proto-owner-hero shell">
          <div class="proto-owner-title">
            <p class="proto-kicker">CYMA / CAL. R.464</p>
            <h1>{data.heading}</h1>
            <p class="proto-owner-deck">{data.lead.map((line)=><span>{line}</span>)}</p>
          </div>
          <figure class="proto-owner-watch">
            <img src={/^https?:\/\//.test(heroImage) ? heroImage : `${base}${heroImage.replace(/^\//,'')}`} alt="CYMA Time-O-Vox 18K Chronomètre 掲載個体" />
            <figcaption>18K YELLOW GOLD / CAL. R.464</figcaption>
          </figure>
        </header>

        <nav class="proto-owner-index" aria-label="このページの内容">
          <div class="shell">
            <a href="#owners-documented"><span>01</span><strong>文献</strong></a>
            <a href="#owners-observed"><span>02</span><strong>観測17件</strong></a>
            <a href="#owners-unadjusted"><span>03</span><strong>UNADJUSTED</strong></a>
            <a href="#owners-archive"><span>04</span><strong>外部照会</strong></a>
            <a href="#owners-field-note"><span>05</span><strong>不具合</strong></a>
          </div>
        </nav>

        <article class="proto-owner-story shell">
          <section class="proto-owner-section" id="owners-documented">
            <header><span>01</span><div><small>文献</small><h2>{data.documented.title}</h2></div><button class="proto-owner-section-toggle" type="button" aria-label="01 文献を開閉" aria-controls="owners-documented-content" aria-expanded="true"></button></header>
            <div class="proto-owner-copy" id="owners-documented-content">
              <dl class="proto-source-ledger">
                {data.documented.cards.map((card,index)=>(
                  <div>
                    <dt>{card.label}</dt>
                    <dd>
                      <small>{index===0?'共有資料':'専門書'}</small>
                      <strong>{card.title}</strong>
                      <p><JapaneseProse text={card.body}/>
                        {index===0&&<sup class="proto-cite"><a href="#source-1">[1]</a><a href="#source-7">[7]</a></sup>}
                        {index===1&&<sup class="proto-cite"><a href="#source-2">[2]</a></sup>}
                        {index===2&&<sup class="proto-cite"><a href="#source-3">[3]</a></sup>}
                      </p>
                    </dd>
                  </div>
                ))}
              </dl>
              {data.documented.cards.some((card)=>card.image)&&<div class="proto-owner-inline-media">
                {data.documented.cards.filter((card)=>card.image).map((card)=><figure><img src={resolveMedia(card.image)} alt={card.title}/><figcaption>{card.label} / {card.title}</figcaption></figure>)}
              </div>}
              <p><JapaneseProse text={data.documented.intro}/> <sup class="proto-cite"><a href="#source-1">[1]</a><a href="#source-2">[2]</a><a href="#source-3">[3]</a><a href="#source-9">[9]</a></sup></p>
            </div>
          </section>

          <section class="proto-owner-section" id="owners-observed">
            <header><span>02</span><div><small>観測個体</small><h2>{data.observed.title}</h2></div><button class="proto-owner-section-toggle" type="button" aria-label="02 観測個体を開閉" aria-controls="owners-observed-content" aria-expanded="true"></button></header>
            <div class="proto-owner-copy" id="owners-observed-content">
              <p><JapaneseProse text={data.observed.intro}/> <sup class="proto-cite"><a href="#source-9">[9]</a></sup></p>
              {data.observed.refNote&&<p><JapaneseProse text={data.observed.refNote}/> <sup class="proto-cite"><a href="#source-9">[9]</a><a href="#source-10">[10]</a><a href="#source-11">[11]</a><a href="#source-12">[12]</a></sup></p>}
              <dl class="proto-source-ledger">
                {data.mismatch.cards.map((card)=>(
                  <div><dt>{card.label}</dt><dd><small>{card.meta||''}</small><strong>{card.title}</strong><p><JapaneseProse text={card.body}/></p></dd></div>
                ))}
              </dl>
              {data.observed.images?.some((item)=>item.image)&&<div class="proto-owner-inline-media">
                {data.observed.images.filter((item)=>item.image).map((item)=><figure><img src={resolveMedia(item.image)} alt={item.alt||'CYMA Time-O-Vox 観測個体'}/><figcaption>{item.caption}</figcaption></figure>)}
              </div>}
              <CymaSpecimenTables />
            </div>
          </section>

          <section class="proto-owner-section proto-owner-logic" id="owners-unadjusted">
            <header><span>03</span><div><small>UNADJUSTED刻印</small><h2>{data.tariff.title}</h2></div><button class="proto-owner-section-toggle" type="button" aria-label="03 UNADJUSTED刻印を開閉" aria-controls="owners-unadjusted-content" aria-expanded="true"></button></header>
            <div class="proto-owner-copy" id="owners-unadjusted-content">
              <p><JapaneseProse text={data.tariff.intro}/> <sup class="proto-cite"><a href="#source-6">[6]</a></sup></p>
              <blockquote><p lang="en">{proofQuote}</p><footer>{proofQuoteJa} <sup class="proto-cite"><a href="#source-6">[6]</a></sup></footer></blockquote>
              {data.tariff.image&&<figure class="proto-tariff-media"><img src={resolveMedia(data.tariff.image)} alt="1956年米国上院 Swiss Watches—Adjustments 資料"/><figcaption>{data.tariff.caption}</figcaption></figure>}
              {data.tariff.body.map((paragraph,index)=><p><JapaneseProse text={paragraph}/>
                {index===0&&<sup class="proto-cite"><a href="#source-5">[5]</a><a href="#source-6">[6]</a></sup>}
                {index===1&&<sup class="proto-cite"><a href="#source-5">[5]</a></sup>}
                {index===2&&<sup class="proto-cite"><a href="#source-5">[5]</a><a href="#source-6">[6]</a><a href="#source-9">[9]</a></sup>}
              </p>)}
            </div>
          </section>

          <section class="proto-owner-section proto-owner-inquiry" id="owners-archive">
            <header><span>04</span><div><small>外部照会</small><h2>{data.archive.title}</h2></div><button class="proto-owner-section-toggle" type="button" aria-label="04 外部照会を開閉" aria-controls="owners-archive-content" aria-expanded="true"></button></header>
            <div class="proto-owner-copy" id="owners-archive-content">
              <p class="proto-inquiry-lead"><JapaneseProse text={data.archive.intro}/></p>
              <div class="proto-inquiry-grid">
                {data.archive.cards.map((card,index)=>(
                  <article><small>{card.label}</small><h3>{card.title}</h3><p><JapaneseProse text={card.body}/> <sup class="proto-cite"><a href={index===0?'#source-7':'#source-8'}>[{index===0?'7':'8'}]</a></sup></p></article>
                ))}
              </div>
              {data.archive.clueBody&&<aside class="proto-archive-clue">
                <small>{data.archive.clueLabel}</small>
                <blockquote>“{data.archive.clueQuote}”</blockquote>
                <p><JapaneseProse text={data.archive.clueBody}/> <sup class="proto-cite"><a href="#source-8">[8]</a></sup></p>
              </aside>}
            </div>
          </section>

          <section class="proto-owner-section proto-owner-field-section" id="owners-field-note">
            <header><span>05</span><div><small>実機観察</small><h2>{data.failure.title}</h2></div><button class="proto-owner-section-toggle" type="button" aria-label="05 実機観察を開閉" aria-controls="owners-field-note-content" aria-expanded="true"></button></header>
            <div class="proto-owner-copy" id="owners-field-note-content">
              <p><JapaneseProse text={data.failure.intro}/> <sup class="proto-cite"><a href="#source-4">[4]</a></sup></p>

              <div class="proto-owner-field-media" aria-label="掲載個体のプッシャー配置とCal.R.464ムーブメント">
                {failureImages.length
                  ? failureImages.map((item)=><figure><div class="proto-owner-field-image"><img src={resolveMedia(item.image)} alt={item.alt||'CYMA Time-O-Vox Cal.R.464'}/></div><figcaption>{item.caption}</figcaption></figure>)
                  : <>
                    <figure>
                      <div class="proto-owner-field-image"><img src={`${base}images/cyma-time-o-vox/gallery/cyma-side-pushers.jpg`} alt="CYMA Time-O-Vox 掲載個体の上下プッシャーとリューズ" /></div>
                      <figcaption>掲載個体。上下のプッシャーとリューズ。</figcaption>
                    </figure>
                    <figure>
                      <div class="proto-owner-field-image"><img src={`${base}images/cyma-time-o-vox/gallery/cyma-movement-r464.jpg`} alt="CYMA Time-O-Vox Cal.R.464 ムーブメント" /></div>
                      <figcaption>掲載個体のCal.R.464。</figcaption>
                    </figure>
                  </>}
              </div>
              {(failureImages.length>1||failureImages.length===0)&&<p class="proto-owner-field-swipe-hint">左右にスワイプして画像を見る</p>}
              {failureVideoId&&<figure class="proto-owner-video"><div class="proto-video-frame"><iframe src={`https://www.youtube.com/embed/${failureVideoId}`} title="CYMA Time-O-Vox アラーム挙動" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div><figcaption>{data.failure.youtubeCaption}</figcaption></figure>}

              <div class="proto-owner-field-observation">
                <div class="proto-owner-field-heading">
                  <small>{data.failure.normalTitle}</small>
                  <h3>{data.failure.observedTitle}</h3>
                </div>
                <p><JapaneseProse text={data.failure.observedBody}/> <sup class="proto-cite"><a href="#source-9">[9]</a></sup></p>
                <ol>
                  {data.failure.examples.map((example, index) => (
                    <li><span>0{index + 1}</span><strong>{example}</strong><small>鳴動を目視確認</small></li>
                  ))}
                </ol>
              </div>

            </div>
          </section>
        </article>
        <CymaResearchConclusion label="現状の結論" />
      </main>
    )}

    {variant === 'history' && (
      <main class="proto-history">
        <header class="proto-history-cover">
          <div class="shell">
            <div class="proto-history-meta"><span>CASE HISTORY / 1955–2025</span><span>CYMA R.464</span></div>
            <h1><span>TIME-O-VOX</span><em>CHRONOMÈTRE</em><small>記録と現存個体</small></h1>
            <p>存在の記録から、17件の観測、UNADJUSTEDの制度背景、未接続の認定記録まで。</p>
          </div>
        </header>
        <nav class="proto-history-nav" aria-label="章ナビゲーション"><div class="shell"><a href="#history-01">1955</a><a href="#history-02">17 OBJECTS</a><a href="#history-03">UNADJUSTED</a><a href="#history-04">ARCHIVE</a><a href="#history-05">FIELD NOTE</a></div></nav>

        <article class="proto-history-chapters">
          <details id="history-01" open>
            <summary><span>01</span><div><small>c.1955 / DOCUMENTED</small><h2>Chronomètre仕様が記録される</h2><p>企業資料と二冊の専門書を重ねる。</p></div><i aria-hidden="true"></i></summary>
            <div class="shell proto-history-body">
              <div class="proto-history-copy"><p>CYMA企業資料は、金製Time-O-Voxへのクロノメーター証明を記す。Horlbeckは5姿勢と温度の試験、Beitlは文字盤とムーブメントの表記差を記録している。</p></div>
              <dl class="proto-history-ledger">{data.documented.cards.map((card, index) => <div><dt>DOC.0{index + 1}</dt><dd><strong>{card.title}</strong><p>{card.body}</p></dd></div>)}</dl>
            </div>
          </details>

          <details id="history-02">
            <summary><span>02</span><div><small>CURRENTLY OBSERVED</small><h2>17件を並べる</h2><p>18K / YGからSSへ。番号は帯域で見る。</p></div><i aria-hidden="true"></i></summary>
            <div class="shell proto-history-body"><div class="proto-history-copy"><p>{data.observed.intro}</p></div><CymaSpecimenTables open /></div>
          </details>

          <details id="history-03" open>
            <summary><span>03</span><div><small>1956 / U.S. TARIFF</small><h2>UNADJUSTEDでも、除外できない</h2><p>根拠、観測、推論を順に追う。</p></div><i aria-hidden="true"></i></summary>
            <div class="shell proto-history-body">
              <div class="proto-history-quote"><p lang="en">{proofQuote}</p><span>{proofQuoteJa}</span></div>
              <div class="proto-history-logic">{logic.map((item) => <article><small>{item.label}</small><h3>{item.title}</h3><p>{item.body}</p></article>)}</div>
            </div>
          </details>

          <details id="history-04">
            <summary><span>04</span><div><small>2025 / INSTITUTIONAL REPLIES</small><h2>認定記録との接続を探す</h2><p>未発見と不存在を分ける。</p></div><i aria-hidden="true"></i></summary>
            <div class="shell proto-history-body"><div class="proto-history-archive">{data.archive.cards.map((card) => <article><small>{card.label}</small><h3>{card.title}</h3><p>{card.body}</p></article>)}</div><p class="proto-note">{data.archive.note}</p></div>
          </details>

          <details id="history-05">
            <summary><span>05</span><div><small>FIELD NOTE</small><h2>正常仕様と、現存個体の挙動差</h2><p>片側プッシャー押し込み状態でも鳴る。</p></div><i aria-hidden="true"></i></summary>
            <div class="shell proto-history-body proto-history-field"><img src={`${base}images/cyma-time-o-vox/gallery/cyma-movement-r464.jpg`} alt="CYMA Time-O-Vox Cal.R.464 ムーブメント"/><div><h3>{data.failure.normalTitle}</h3><p>{data.failure.normalBody}</p><h3>{data.failure.observedTitle}</h3><p>{data.failure.observedBody}</p><h3>{data.failure.hypothesisTitle}</h3><p>{data.failure.hypothesisBody}</p></div></div>
          </details>

          <CymaResearchConclusion />
        </article>
      </main>
    )}

    {variant === 'archive' && (
      <main class="proto-archive">
        <header class="proto-archive-head shell">
          <div class="proto-archive-code"><span>VA / R-01</span><span>REV. 2026-09</span></div>
          <p class="proto-kicker">CYMA TIME-O-VOX / CAL. R.464</p>
          <h1>CHRONOMÈTRE<br /><span>RESEARCH FILE</span></h1>
          <p class="proto-archive-deck">資料が示すこと、現存個体で見えること、そこから残る推論を一つの照合台帳にまとめる。</p>
        </header>

        <article class="proto-archive-flow shell">
          <section class="proto-archive-section" id="archive-documents">
            <header><span>FILE 01</span><h2>存在を記録する三つの資料</h2></header>
            <ol class="proto-document-list">{data.documented.cards.map((card, index) => <li><span>DOC.0{index + 1}</span><div><small>{card.label}</small><h3>{card.title}</h3><p>{card.body}</p></div></li>)}</ol>
          </section>

          <section class="proto-archive-section" id="archive-observed">
            <header><span>FILE 02</span><h2>OBSERVED OBJECTS / {totalSpecimens}</h2></header>
            <p>{data.observed.intro}</p>
            <CymaSpecimenTables />
          </section>

          <section class="proto-archive-section" id="archive-inference">
            <header><span>FILE 03</span><h2>ADJUSTED / UNADJUSTED</h2></header>
            <div class="proto-archive-quote"><p lang="en">{proofQuote}</p><span>{proofQuoteJa}</span></div>
            <div class="proto-archive-logic">{logic.map((item, index) => <article><span>0{index + 1}</span><div><small>{item.label}</small><h3>{item.title}</h3><p>{item.body}</p></div></article>)}</div>
          </section>

          <section class="proto-archive-section" id="archive-institutions">
            <header><span>FILE 04</span><h2>INSTITUTIONAL REPLIES / 2025</h2></header>
            <div class="proto-document-list">{data.archive.cards.map((card, index) => <article><span>REP.0{index + 1}</span><div><small>{card.label}</small><h3>{card.title}</h3><p>{card.body}</p></div></article>)}</div>
            <p class="proto-note">{data.archive.note}</p>
          </section>

          <section class="proto-archive-section" id="archive-field">
            <header><span>FILE 05</span><h2>FIELD NOTE / PUSHER LOCK</h2></header>
            <figure class="proto-archive-figure"><img src={`${base}images/cyma-time-o-vox/gallery/cyma-movement-r464.jpg`} alt="CYMA Time-O-Vox Cal.R.464 ムーブメント"/><figcaption>OBSERVED UNIT / CAL. R.464</figcaption></figure>
            <div class="proto-archive-field-grid"><article><small>NORMAL</small><h3>{data.failure.normalTitle}</h3><p>{data.failure.normalBody}</p></article><article><small>OBSERVED</small><h3>{data.failure.observedTitle}</h3><p>{data.failure.observedBody}</p></article><article><small>HYPOTHESIS</small><h3>{data.failure.hypothesisTitle}</h3><p>{data.failure.hypothesisBody}</p></article></div>
          </section>

          <CymaResearchConclusion />
        </article>
      </main>
    )}

    <footer class="proto-footer shell">
      <details open={variant === 'owners'}><summary>使用資料</summary><ol>{data.sources.map((source, index) => <li id={`source-${index + 1}`}><span class="proto-source-no">[{index + 1}]</span>{source}</li>)}</ol></details>
      <a href={`${base}cyma-time-o-vox/chronometre/`}>現行RESEARCHページを見る →</a>
    </footer>
    {variant === 'owners' && <script is:inline>
      (() => {
        const story=document.querySelector('.proto-owner-story');
        const mobile=window.matchMedia('(max-width:760px)');
        if(!story) return;
        const chapters=[...story.querySelectorAll('.proto-owner-section')].map((section)=>({
          section,
          button:section.querySelector('.proto-owner-section-toggle'),
          content:section.querySelector('.proto-owner-copy')
        }));
        const setOpen=(chapter,open)=>{
          chapter.content.hidden=!open;
          chapter.button.setAttribute('aria-expanded',String(open));
        };
        const openHash=()=>{
          if(!mobile.matches||!location.hash) return;
          const target=document.getElementById(location.hash.slice(1));
          const chapter=chapters.find(({section})=>section===target||section.contains(target));
          if(chapter) setOpen(chapter,true);
        };
        const sync=()=>{
          chapters.forEach((chapter)=>setOpen(chapter,!mobile.matches));
          openHash();
        };
        chapters.forEach((chapter)=>chapter.button.addEventListener('click',()=>{
          if(mobile.matches) setOpen(chapter,chapter.content.hidden);
        }));
        mobile.addEventListener('change',sync);
        window.addEventListener('hashchange',openHash);
        document.querySelectorAll('.proto-owner-index a[href^="#owners-"]').forEach((link)=>{
          link.addEventListener('click',()=>{
            if(!mobile.matches) return;
            const chapter=chapters.find(({section})=>`#${section.id}`===link.getAttribute('href'));
            if(chapter) setOpen(chapter,true);
          });
        });
        sync();
        story.classList.add('is-accordion-ready');

        const conclusion=document.querySelector('.proto-owner .proto-conclusion');
        const conclusionButton=conclusion?.querySelector('.proto-conclusion-toggle');
        const conclusionBody=conclusion?.querySelector('.proto-conclusion-body');
        const syncConclusion=()=>{
          if(!conclusion||!conclusionButton||!conclusionBody) return;
          conclusion.classList.add('is-accordion-ready');
          conclusionBody.hidden=mobile.matches;
          conclusionButton.setAttribute('aria-expanded',String(!mobile.matches));
        };
        conclusionButton?.addEventListener('click',()=>{
          if(!mobile.matches||!conclusionBody) return;
          conclusionBody.hidden=!conclusionBody.hidden;
          conclusionButton.setAttribute('aria-expanded',String(!conclusionBody.hidden));
        });
        mobile.addEventListener('change',syncConclusion);
        syncConclusion();

        const media=story.querySelector('.proto-owner-field-media');
        if(media&&media.children.length>1){
          const syncMedia=()=>mobile.matches?media.setAttribute('tabindex','0'):media.removeAttribute('tabindex');
          mobile.addEventListener('change',syncMedia);
          syncMedia();
        }
      })();
    </script>}
  </body>
</html>
