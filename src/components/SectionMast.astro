---
import researchSettings from '../data/research-settings.json';
import howTheyRingSettings from '../data/how-they-ring-settings.json';
const {
  rightLabel = 'ALARM WRISTWATCHES',
  lang = 'ja',
  languageHref = null,
  languageLabel = null,
  languageHreflang = null,
  languageLinks = []
} = Astro.props;
const base = import.meta.env.BASE_URL;
const researchPublished = researchSettings.published;
const howTheyRingPublished = howTheyRingSettings.productionPublished;
const isEnglish = lang === 'en';
const isGerman = lang === 'de';
const menuLabel = isEnglish
  ? 'VINTAGE ALARM section menu'
  : isGerman
    ? 'VINTAGE ALARM Bereichsmenü'
    : 'VINTAGE ALARM セクションメニュー';
const summaryLabel = isEnglish ? 'Section menu' : isGerman ? 'Bereichsmenü' : 'セクションメニュー';
const resolvedLanguageLinks = Array.isArray(languageLinks) && languageLinks.length > 0
  ? languageLinks
  : languageHref && languageLabel
    ? [{ href: languageHref, label: languageLabel, hreflang: languageHreflang }]
    : [];
const homeHref = isEnglish ? `${base}en/` : isGerman ? `${base}de/` : base;
---
<header class="shell mast section-mast">
  <div class="section-mast-left">
    <details class="section-menu">
      <summary aria-label={summaryLabel}>≡</summary>
      <nav class="section-menu-panel" aria-label={menuLabel}>
        {isEnglish ? (
          <>
            <a href={`${base}en/`}>English</a>
            <a href={`${base}en/history/`}>History</a>
            <a href={`${base}en/sources/`}>Sources</a>
            <a href={`${base}owners-notes/`}>Owner's Notes (Japanese)</a>
          </>
        ) : isGerman ? (
          <>
            <a href={`${base}de/`}>Deutsch</a>
            <a href={`${base}de/history/`}>Geschichte</a>
            <a href={`${base}de/sources/`}>Quellen</a>
            <a href={`${base}owners-notes/`}>Owner's Notes (Japanisch)</a>
          </>
        ) : (
          <>
            <a href={`${base}history/`}>歴史</a>
            <a href={`${base}history/#milestones`}>マイルストーン</a>
            <a href={`${base}owners-notes/`}>オーナーズノート</a>
            {howTheyRingPublished && <a href={`${base}how-they-ring/`}>音で見る</a>}
            <a href={`${base}sources/`}>資料・出典</a>
            {researchPublished && <a href={`${base}history/#research`}>調査個体</a>}
          </>
        )}
      </nav>
    </details>
    <a class="mast-link" href={homeHref}>VINTAGE ALARM</a>
  </div>
  <div class="section-mast-right">
    {resolvedLanguageLinks.length > 0 && (
      <div class="section-language-links" aria-label={isGerman ? 'Sprachauswahl' : isEnglish ? 'Language switcher' : '言語切替'}>
        {resolvedLanguageLinks.map((item: any) => (
          <a
            class="section-language-link"
            href={item.href}
            hreflang={item.hreflang || undefined}
            lang={item.hreflang || undefined}
          >{item.label}</a>
        ))}
      </div>
    )}
    <span>{rightLabel}</span>
  </div>
</header>

<style>
  .section-mast-left{display:flex;align-items:center;gap:12px}
  .section-mast-right{display:flex;align-items:center;justify-content:flex-end;gap:12px;min-width:0}
  .section-language-links{display:flex;align-items:center;gap:8px;min-width:0}
  .section-language-link{color:var(--soft);font-size:10px;line-height:1;letter-spacing:.08em;text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:2px;white-space:nowrap}
  .section-menu{position:relative;border:0!important}
  .section-menu:last-child{border-bottom:0!important}
  .section-menu>summary{position:relative;display:grid;place-items:center;width:44px;height:44px;min-height:0;padding:0;border:0;font-family:sans-serif;font-size:18px;line-height:1;letter-spacing:0;cursor:pointer;touch-action:manipulation}
  .section-menu>summary::before{content:"";position:absolute;inset:7px;border:1px solid var(--rule);pointer-events:none}
  .section-menu>summary::after{content:none!important}
  .section-menu-panel{position:absolute;z-index:50;top:46px;left:0;width:min(78vw,280px);padding:9px;border:1px solid var(--ink);background:var(--paper);box-shadow:0 16px 38px rgba(36,31,26,.14)}
  .section-menu-panel a{display:flex;justify-content:space-between;gap:18px;padding:13px 11px;border-bottom:1px solid var(--rule);color:var(--ink);font-size:13px;letter-spacing:.04em;text-decoration:none;white-space:normal}
  .section-menu-panel a:last-child{border-bottom:0}
  .section-menu-panel a::after{content:'→';font-family:Georgia,"Times New Roman",serif}
  @media(max-width:480px){
    .section-mast-left{gap:5px}
    .section-mast-right{gap:8px}
    .section-language-links{gap:6px}
    .section-language-link{font-size:9px}
    .section-menu>summary{width:44px;height:44px;font-size:17px}
    .section-menu>summary::before{inset:8px}
    .section-menu-panel{top:46px;width:min(84vw,280px)}
  }
</style>