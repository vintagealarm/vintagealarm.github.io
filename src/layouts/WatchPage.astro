---
import { getCollection } from 'astro:content';
import SeoHead from '../components/SeoHead.astro';
import SectionMast from '../components/SectionMast.astro';
import WatchHero from '../components/WatchHero.astro';
import OwnersNote from '../components/OwnersNote.astro';
import WatchSpec from '../components/WatchSpec.astro';
import AlarmVideo from '../components/AlarmVideo.astro';
import DeepDive from '../components/DeepDive.astro';
import SpecimenGallery from '../components/SpecimenGallery.astro';
import Sources from '../components/Sources.astro';
import OwnerNoteEndNav from '../components/OwnerNoteEndNav.astro';
import '../styles/site.css';
import '../styles/owners-v15.css';
import OwnerFonts from '../components/OwnerFonts.astro';
import ownersDirectory from '../data/owners-directory.json';
import { englishWatchEntries } from '../data/en-watch-entry';
import { germanWatchEntries } from '../data/de-watch-entry';
import { watchRecommendations } from '../data/watch-recommendations';

const { watch } = Astro.props;
const siteRoot = 'https://vintagealarm.github.io/';
const pageTitle = watch.slug === 'pierce-duofon'
  ? 'Pierce Duofon｜Cal.135・2段階アラーム・実機音｜VINTAGE ALARM'
  : watch.slug === 'cyma-time-o-vox'
    ? 'Cyma Time-O-Vox 18K Chronomètre｜Cal.R.464・1香箱｜VINTAGE ALARM'
    : watch.slug === 'basis-alarm'
      ? 'Basis Alarm BFG 90｜2香箱・巻上げ表示窓・実機音｜VINTAGE ALARM'
      : watch.slug === 'citizen-alarm'
        ? 'Citizen Alarm｜Cal.980・国産初のベル腕時計・実機音｜VINTAGE ALARM'
        : watch.slug === 'westclox-watchlarm'
          ? 'Westclox Watchlarm｜W5・0石・プッシャー式アラーム｜VINTAGE ALARM'
          : `${watch.brand} ${watch.model}｜VINTAGE ALARM`;
const description = watch.slug === 'cyma-time-o-vox'
  ? 'Cyma Time-O-Vox 18K Chronomètre。Cal.R.464、1香箱、2プッシャー、透かしラグ。OWNER\'S NOTE、SPEC、R.464機構とケース仕様のDEEP DIVEを掲載。'
  : watch.slug === 'basis-alarm'
    ? 'Basis AlarmとBaumgartner BFG 90。一本の巻真から同じ方向に2香箱を巻く構造、滑りクラッチ、2つの巻上げ表示窓を、実機音と資料から追う。'
    : watch.slug === 'citizen-alarm'
      ? '1958年のCitizen Alarm。Cal.980、2香箱、中央回転ディスク、2リューズ、二重裏蓋。国産初のベル腕時計を、掲載個体・資料・モデル変遷から追う。'
      : watch.slug === 'westclox-watchlarm'
        ? 'Westclox Watchlarm W5。0石、1香箱、2時位置プッシャー式アラーム設定、9時位置ON/OFF。掲載個体の実測と資料差を含めて構造を追う。'
        : `${watch.brand} ${watch.model}。${watch.spec.caliber}、${watch.spec.barrels}、${watch.spec.acoustic}。OWNER'S NOTE、SPEC、${watch.video ? '実機鳴動、' : ''}資料に基づくDEEP DIVEを掲載。`;
const pagePath = `${watch.slug}/`;
const pageUrl = new URL(pagePath, siteRoot).href;
const imageUrl = new URL(watch.ownersNote.image.replace(/^\//, ''), siteRoot).href;
const englishEntry = englishWatchEntries[watch.slug];
const germanEntry = germanWatchEntries[watch.slug];
const englishUrl = englishEntry ? new URL(`en/${watch.slug}/`, siteRoot).href : null;
const germanUrl = germanEntry ? new URL(`de/${watch.slug}/`, siteRoot).href : null;
const alternates = [
  { hreflang: 'ja', href: pageUrl },
  ...(englishUrl ? [{ hreflang: 'en', href: englishUrl }] : []),
  ...(germanUrl ? [{ hreflang: 'de', href: germanUrl }] : []),
  { hreflang: 'x-default', href: pageUrl }
];
const languageLinks = [
  ...(englishEntry ? [{ href: `/en/${watch.slug}/`, label: 'EN', hreflang: 'en' }] : []),
  ...(germanEntry ? [{ href: `/de/${watch.slug}/`, label: 'DE', hreflang: 'de' }] : [])
];
const allWatches = await getCollection('watches');
const watchBySlug = new Map(allWatches.map((item) => [item.data.slug, item]));
const directoryEntries = ownersDirectory.entries
  .flatMap((meta) => {
    const item = watchBySlug.get(meta.historyId);
    if (!item?.data.published) return [];
    return [{
      ...meta,
      ownerNumber: item.data.ownerNumber,
      brand: item.data.brand,
      name: item.data.model,
      href: `/${item.data.slug}/#owners-note`,
      historyHref: `/history/#${meta.historyEra}`
    }];
  });
const currentDirectoryEntry = directoryEntries.find((entry) => entry.historyId === watch.slug) ?? null;
const recommendation = watchRecommendations[watch.slug] ?? null;
const nextDirectoryEntry = recommendation
  ? directoryEntries.find((entry) => entry.historyId === recommendation.target) ?? null
  : null;
const nextOwnerNote = nextDirectoryEntry && recommendation
  ? {
      href: nextDirectoryEntry.href,
      name: `${nextDirectoryEntry.brand} ${nextDirectoryEntry.name}`,
      reason: recommendation.reason
    }
  : null;
const historyHref = currentDirectoryEntry?.historyHref ?? '/history/';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CreativeWork',
      name: watch.slug === 'cyma-time-o-vox' ? 'CYMA TIME-O-VOX 18K CHRONOMÈTRE' : `${watch.brand} ${watch.model}`,
      description,
      inLanguage: 'ja',
      url: pageUrl,
      image: imageUrl,
      about: {
        '@type': 'Thing',
        name: `${watch.brand} ${watch.model}`
      },
      isPartOf: {
        '@type': 'WebSite',
        name: 'VINTAGE ALARM',
        url: siteRoot
      }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'VINTAGE ALARM',
          item: siteRoot
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: `${watch.brand} ${watch.model}`,
          item: pageUrl
        }
      ]
    }
  ]
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f8f4" />
    <OwnerFonts />
    <SeoHead title={pageTitle} description={description} path={pagePath} image={watch.ownersNote.image} type="article" schema={schema} alternates={alternates} />
  </head>
  <body class="owners-v15">
    <SectionMast
      rightLabel="OWNER'S NOTE"
      languageLinks={languageLinks}
    />
    <main>
      <WatchHero brand={watch.brand} model={watch.model} catchLines={watch.catch} ownerNumber={watch.ownerNumber} />
      <div class="shell owners-grid">
        <OwnersNote data={watch.ownersNote} alt={`${watch.brand} ${watch.model} OWNER'S NOTE`} />
        <WatchSpec spec={watch.spec} />
      </div>
      {watch.video && <AlarmVideo video={watch.video} title={`${watch.brand} ${watch.model}`} />}
      {watch.specimenGallery?.length > 0 && <SpecimenGallery items={watch.specimenGallery} title={`${watch.brand} ${watch.model}`} />}
      <DeepDive items={watch.deepDive} />
      <Sources sources={watch.sources} meta={watch.sourceMeta} />
      {nextOwnerNote && (
        <OwnerNoteEndNav
          nextHref={nextOwnerNote.href}
          nextName={nextOwnerNote.name}
          nextReason={nextOwnerNote.reason}
          historyHref={historyHref}
        />
      )}
    </main>
  </body>
</html>
