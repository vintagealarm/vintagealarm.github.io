---
import { getCollection } from 'astro:content';
import SeoHead from '../components/SeoHead.astro';
import SectionMast from '../components/SectionMast.astro';
import HistoryMilestones from '../components/HistoryMilestonesV18.astro';
import OwnerThumbnailFrame from '../components/OwnerThumbnailFrame.astro';
import ownersDirectory from '../data/owners-directory.json';
import researchSettings from '../data/research-settings.json';
import { englishWatchEntries } from '../data/en-watch-entry';
import { germanWatchEntries } from '../data/de-watch-entry';
import '../styles/site.css';
import '../styles/history-v13.css';
import '../styles/history-v18.css';
import '../styles/history-v19.css';

const { lang, content, title, description } = Astro.props;
const isGerman = lang === 'de';
const base = import.meta.env.BASE_URL;
const root = 'https://vintagealarm.github.io/';
const pagePath = `${lang}/history/`;
const pageUrl = new URL(pagePath, root).href;
const japaneseUrl = new URL('history/', root).href;
const englishUrl = new URL('en/history/', root).href;
const germanUrl = new URL('de/history/', root).href;
const socialImage = '/images/history-motifs/1950s-train-watercolor.png';
const watches = await getCollection('watches');
const watchBySlug = new Map(watches.map((item) => [item.data.slug, item]));
const researchPublished = researchSettings.published;

const ui = isGerman
  ? {
      skip: 'Zum Inhalt',
      eraNav: 'Navigation nach Jahrzehnten',
      milestones: (label: string) => `Meilensteine der ${label}`,
      ownersLead: 'Durch eigene Exemplare betrachtet.',
      ownersIndex: 'UHRENSEITEN ↗',
      ownersIndexAria: 'Übersicht der deutschen Uhrenseiten',
      currentChapter: 'KAPITEL 06',
      researchAria: 'Nächste Recherche',
      researchLead: 'Was als Nächstes interessiert — und die Daten dazu.',
      breadcrumb: 'GESCHICHTE'
    }
  : {
      skip: 'Skip to history',
      eraNav: 'History era navigation',
      milestones: (label: string) => `${label} milestones`,
      ownersLead: 'Seen through owned specimens.',
      ownersIndex: 'WATCH PAGES ↗',
      ownersIndexAria: 'English watch-page index',
      currentChapter: 'CHAPTER 06',
      researchAria: 'Next research',
      researchLead: 'What we are looking at next, and the data behind it.',
      breadcrumb: 'HISTORY'
    };

const ownersForEra = (era: string) => ownersDirectory.entries
  .filter((note) => note.historyEra === era)
  .flatMap((note) => {
    const watch = watchBySlug.get(note.historyId);
    if (!watch?.data.published) return [];
    const localizedHref = lang === 'en'
      ? englishWatchEntries[watch.data.slug]
        ? `${base}en/${watch.data.slug}/#owners-note`
        : `${base}${watch.data.slug}/#owners-note`
      : germanWatchEntries[watch.data.slug]
        ? `${base}de/${watch.data.slug}/#owners-note`
        : englishWatchEntries[watch.data.slug]
          ? `${base}en/${watch.data.slug}/#owners-note`
          : `${base}${watch.data.slug}/#owners-note`;
    return [{
      note,
      brand: watch.data.brand,
      name: watch.data.model,
      href: localizedHref,
      image: `${base}${(note.historyThumbnail ?? note.image).replace(/^\//, '')}`,
      fallbackImage: note.fallbackThumbnail ? `${base}${note.fallbackThumbnail.replace(/^\//, '')}` : undefined
    }];
  });

const milestoneEntries = {
  '1910s': content.era1910s.cards.map((entry: any) => ({ ...entry, era: '1910s' })),
  '1940s': content.era1940s.cards.map((entry: any) => ({ ...entry, era: '1940s' })),
  '1950s': content.era1950s.cards.map((entry: any) => ({ ...entry, era: '1950s' })),
  '1960s': content.era1960s.cards.map((entry: any) => ({ ...entry, era: '1960s' })),
  electronic: content.electronic.cards.map((entry: any) => ({ ...entry, era: 'electronic' }))
};
const milestones = (era: string) => (milestoneEntries[era as keyof typeof milestoneEntries] ?? [])
  .filter((entry: any) => entry.featured)
  .sort((a: any, b: any) => a.sort - b.sort);

const { hero, coverMilestones, before, era1910s, era1940s, era1950s, era1960s, electronic, current, sources } = content;
const eras = [
  { id: 'before', no: before.chapterNo, label: before.label, title: before.title, paragraphs: before.intro, teaser: before.teaser, motif: 'images/history-motifs/before-watercolor.png', motifClass: 'motif-before' },
  { id: '1910s', no: era1910s.chapterNo, label: era1910s.label, title: era1910s.title, paragraphs: [era1910s.intro], teaser: era1910s.teaser },
  { id: '1940s', no: era1940s.chapterNo, label: era1940s.label, title: era1940s.title, paragraphs: [era1940s.intro], teaser: era1940s.teaser },
  { id: '1950s', no: era1950s.chapterNo, label: era1950s.label, title: era1950s.title, paragraphs: era1950s.intro.split('\n'), teaser: era1950s.teaser, motif: 'images/history-motifs/1950s-train-watercolor.png', motifClass: 'motif-1950s' },
  { id: '1960s', no: era1960s.chapterNo, label: era1960s.label, title: era1960s.title, paragraphs: [era1960s.intro], teaser: era1960s.teaser, motif: 'images/history-motifs/1960s-drive-watercolor.png', motifClass: 'motif-1960s' },
  { id: 'electronic', no: electronic.chapterNo, label: electronic.label, title: electronic.title, paragraphs: electronic.body, teaser: electronic.teaser, motif: 'images/history-motifs/1970s-digital-watercolor.png', motifClass: 'motif-1970s' }
];

const languageLinks = lang === 'en'
  ? [
      { href: '/history/', label: '日本語', hreflang: 'ja' },
      { href: '/de/history/', label: 'DE', hreflang: 'de' }
    ]
  : [
      { href: '/history/', label: '日本語', hreflang: 'ja' },
      { href: '/en/history/', label: 'EN', hreflang: 'en' }
    ];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: isGerman ? 'Geschichte der Wecker-Armbanduhr' : 'History of the Alarm Wristwatch',
      description,
      inLanguage: lang,
      mainEntityOfPage: pageUrl,
      isPartOf: { '@type': 'WebSite', name: 'VINTAGE ALARM', url: root }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'VINTAGE ALARM', item: root },
        { '@type': 'ListItem', position: 2, name: ui.breadcrumb, item: pageUrl }
      ]
    }
  ]
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1c201c" />
    <link rel="icon" href="data:," />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Noto+Serif+JP:wght@400;500;600&display=swap" rel="stylesheet" />
    <SeoHead
      title={title}
      description={description}
      path={pagePath}
      image={socialImage}
      type="article"
      locale={isGerman ? 'de_DE' : 'en_US'}
      schema={schema}
      alternates={[
        { hreflang: 'ja', href: japaneseUrl },
        { hreflang: 'en', href: englishUrl },
        { hreflang: 'de', href: germanUrl },
        { hreflang: 'x-default', href: japaneseUrl }
      ]}
    />
  </head>
  <body class="history-v13 history-v18">
    <a class="history-skip" href="#before">{ui.skip}</a>
    <div class="history-mast">
      <SectionMast rightLabel="HISTORY" lang={lang} languageLinks={languageLinks} />
    </div>
    <main>
      <section class="history-cover-v13" aria-labelledby="history-title">
        <div class="shell">
          <div class="cover-meta"><span>HISTORY</span><span>01 / CONTENTS</span></div>
          <h1 id="history-title"><span>HISTORY</span><em>of the</em><span>ALARM</span><small>WRISTWATCH</small></h1>
          <div class="cover-dates" id="milestones" aria-label="Milestones">
            {coverMilestones.map((item: any) => <a href={item.href}><strong>{item.year}</strong><span>{item.line1}<br />{item.line2}</span></a>)}
          </div>
          <div class="cover-foot"><p>{hero.kicker[0]}<br />{hero.kicker[1]}</p><a href="#before" aria-label={ui.skip}>↓</a></div>
        </div>
      </section>
      <nav class="history-era-nav" aria-label={ui.eraNav}>
        <div class="shell">{eras.map((era) => <a href={`#${era.id}`}>{era.label}</a>)}<a href="#current">CURRENT</a></div>
      </nav>
      {eras.map((era) => {
        const eraOwners = ownersForEra(era.id);
        return <details class:list={['chronology-era', 'chapter-v18', { 'has-owners': eraOwners.length > 0, 'is-before': era.id === 'before', 'has-motif': !!era.motif }]} id={era.id} aria-labelledby={`title-${era.id}`}>
          <summary class="chapter-summary-v18">
            <span class="chapter-index-v18">{era.no}</span>
            <span class="chapter-summary-copy-v18"><small>{era.label}</small><h2 id={`title-${era.id}`}>{era.title}</h2><span>{era.teaser}</span></span>
            {era.motif && <img class:list={['chapter-motif-v18', era.motifClass]} src={`${base}${era.motif}`} alt="" aria-hidden="true" />}
            <span class="chapter-toggle-v18" aria-hidden="true"><i></i></span>
          </summary>
          <div class:list={['shell', 'chapter-body-v18', { 'has-owners-body-v18': eraOwners.length > 0 }]}>
            <div class="chapter-copy">{era.paragraphs.map((paragraph: string) => <p>{paragraph}</p>)}</div>
            {era.id !== 'before' && <HistoryMilestones entries={milestones(era.id)} id={`milestones-${era.id}`} label={ui.milestones(era.label)} lang={lang} />}
            {eraOwners.length > 0 && <aside class="history-owners" aria-label="OWNER'S NOTES">
              <div class="collection-lead"><p>{ui.ownersLead}</p><a href={`${base}${lang}/`} aria-label={ui.ownersIndexAria}>{ui.ownersIndex}</a></div>
              <div class="owner-tiles">{eraOwners.map(({ note, brand, name, href, image, fallbackImage }) => <OwnerThumbnailFrame brand={brand} name={name} href={href} image={image} fallbackImage={fallbackImage} published={!!note} smartFit={false} />)}</div>
            </aside>}
          </div>
        </details>;
      })}
      <section class="history-current-v13 shell" id="current" aria-labelledby="current-title">
        <div class="chapter-date"><strong>CURRENT</strong><span>{ui.currentChapter}</span></div>
        <div><h2 id="current-title">{current.title}</h2><a class="current-link" href={`${base}${current.href}`} hreflang="ja"><span>{current.name}</span><span aria-hidden="true">↗</span></a></div>
      </section>
      {researchPublished && <aside class="history-research-v13 shell" id="research" aria-label={ui.researchAria}><h2>{researchSettings.title}</h2><p>{ui.researchLead}</p></aside>}
      <section class="history-sources-v13 shell">
        <details><summary>{sources.summary}</summary><ol class="history-source-list">{sources.items.map((item: any) => <li id={`history-source-${item.id}`}><span class="history-source-no" aria-hidden="true">{item.id}</span><span>{item.text}</span></li>)}</ol></details>
      </section>
    </main>
    <script>
      const links=[...document.querySelectorAll<HTMLAnchorElement>('.history-era-nav a')];
      const chapters=[...document.querySelectorAll<HTMLDetailsElement>('details.chronology-era')];
      const sections=[...chapters,...document.querySelectorAll<HTMLElement>('#current')];
      const revealTarget=(scroll=false)=>{
        if(!location.hash)return;
        const target=document.getElementById(decodeURIComponent(location.hash.slice(1)));
        if(!target)return;
        const chapter=target.matches('details.chronology-era')?target:target.closest('details.chronology-era');
        if(chapter instanceof HTMLDetailsElement)chapter.open=true;
        if(scroll)requestAnimationFrame(()=>target.scrollIntoView({block:'start'}));
      };
      const update=()=>{let active='';for(const section of sections)if(section.getBoundingClientRect().top<=180)active=section.id;for(const link of links){if(link.hash===`#${active}`)link.setAttribute('aria-current','location');else link.removeAttribute('aria-current');}};
      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(link=>link.addEventListener('click',()=>{const target=document.getElementById(decodeURIComponent(link.hash.slice(1)));const chapter=target?.matches('details.chronology-era')?target:target?.closest('details.chronology-era');if(chapter instanceof HTMLDetailsElement)chapter.open=true;}));
      let pending=false;window.addEventListener('scroll',()=>{if(!pending){pending=true;requestAnimationFrame(()=>{update();pending=false;});}},{passive:true});
      window.addEventListener('resize',update);window.addEventListener('hashchange',()=>{revealTarget(true);update();});
      chapters.forEach(chapter=>chapter.addEventListener('toggle',update));
      document.fonts.ready.then(()=>{revealTarget(!!location.hash);update();});
      document.querySelectorAll<HTMLAnchorElement>('.section-menu-panel a').forEach(link=>link.addEventListener('click',()=>link.closest('details')?.removeAttribute('open')));
    </script>
  </body>
</html>
