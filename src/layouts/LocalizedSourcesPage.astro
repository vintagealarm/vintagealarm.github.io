---
import SeoHead from '../components/SeoHead.astro';
import SectionMast from '../components/SectionMast.astro';
import type { SourceLibraryItem } from '../data/source-library';
import '../styles/site.css';

const { lang, books, title, description } = Astro.props as {
  lang: 'en' | 'de';
  books: SourceLibraryItem[];
  title: string;
  description: string;
};

const isGerman = lang === 'de';
const labels = isGerman
  ? {
      heading: 'Quellen & Literatur',
      intro: 'Die von VINTAGE ALARM wiederholt verwendeten Fachquellen werden hier so dokumentiert, dass Leserinnen und Leser sie selbst nachvollziehen können. Links zu Bibliotheken, Verlagen und bibliographischen Nachweisen dienen zur Prüfung von Existenz, Ausgabe und ISBN. Historische Aussagen selbst werden auf den jeweiligen HISTORY- und WATCH-Seiten mit den einschlägigen Seiten oder Primärquellen verknüpft.',
      section: 'Fachbücher',
      imprint: 'Ausgabe',
      year: 'Jahr',
      isbn: 'ISBN',
      unknown: 'nicht bestätigt',
      usedFor: 'Wichtige Verwendungen bei VINTAGE ALARM',
      bibliography: 'Bibliographie',
      acquisition: 'Bezugsquelle',
      scopeTitle: 'Umfang dieser Seite',
      scope: 'Zunächst werden nur Horlbeck und Beitl als gemeinsame Referenzwerke dokumentiert. Offizielle Herstellerunterlagen, Patente und einzelne Webquellen werden jeweils dort ausgewiesen, wo sie auf HISTORY- oder WATCH-Seiten verwendet werden. Die bloße Zahl der Quellen zu erhöhen, ist nicht das Ziel.',
      aria: 'Quellen und Literatur'
    }
  : {
      heading: 'Sources & References',
      intro: 'The specialist sources repeatedly used by VINTAGE ALARM are documented here so readers can trace them independently. Library, publisher and bibliographic links are provided to verify the existence, edition and ISBN of each source. Historical claims themselves are tied to the relevant pages or primary sources on the HISTORY and WATCH pages.',
      section: 'Reference books',
      imprint: 'Publication',
      year: 'Year',
      isbn: 'ISBN',
      unknown: 'not confirmed',
      usedFor: 'Main uses within VINTAGE ALARM',
      bibliography: 'Bibliographic check',
      acquisition: 'Where to find it',
      scopeTitle: 'Scope of this page',
      scope: 'For now, only Horlbeck and Beitl are documented here as shared reference works. Official manufacturer material, patents and individual web sources are cited on the HISTORY or WATCH pages where they are used. Increasing the source count for its own sake is not the goal.',
      aria: 'Sources and references'
    };

const root = 'https://vintagealarm.github.io/';
const path = `${lang}/sources/`;
const pageUrl = `${root}${path}`;
const japaneseUrl = `${root}sources/`;
const englishUrl = `${root}en/sources/`;
const germanUrl = `${root}de/sources/`;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: labels.heading,
      description,
      inLanguage: lang,
      url: pageUrl,
      isPartOf: { '@type': 'WebSite', name: 'VINTAGE ALARM', url: root }
    },
    ...books.map((item) => ({
      '@type': 'Book',
      '@id': `${pageUrl}#${item.id}`,
      name: item.title,
      author: { '@type': 'Person', name: item.author },
      datePublished: item.year,
      ...(item.isbn ? { isbn: item.isbn } : {}),
      ...(item.language ? { inLanguage: item.language } : {}),
      url: `${pageUrl}#${item.id}`
    }))
  ]
};
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#1c201c" />
  <link rel="icon" href="data:," />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Noto+Serif+JP:wght@400;500;600&display=swap" rel="stylesheet" />
  <SeoHead
    title={title}
    description={description}
    path={path}
    type="website"
    locale={lang === 'de' ? 'de_DE' : 'en_US'}
    schema={schema}
    alternates={[
      { hreflang: 'ja', href: japaneseUrl },
      { hreflang: 'en', href: englishUrl },
      { hreflang: 'de', href: germanUrl },
      { hreflang: 'x-default', href: japaneseUrl }
    ]}
  />
</head>
<body>
  <SectionMast
    rightLabel="SOURCES"
    lang={lang}
    languageLinks={lang === 'en'
      ? [
          { href: '/sources/', label: '日本語', hreflang: 'ja' },
          { href: '/de/sources/', label: 'DE', hreflang: 'de' }
        ]
      : [
          { href: '/sources/', label: '日本語', hreflang: 'ja' },
          { href: '/en/sources/', label: 'EN', hreflang: 'en' }
        ]}
  />
  <main class="source-library shell">
    <header class="source-library-head">
      <p class="source-kicker">SOURCE TRACEABILITY</p>
      <h1>{labels.heading}</h1>
      <p>{labels.intro}</p>
    </header>

    <section aria-labelledby="reference-books-title">
      <div class="source-section-head">
        <h2 id="reference-books-title">{labels.section}</h2>
        <span>{books.length}</span>
      </div>
      <div class="source-grid">
        {books.map((item,index)=><article class="source-card" id={item.id} data-source-id={item.id}>
          <div class="source-card-meta"><span>SOURCE {String(index+1).padStart(2,'0')}</span><span>{item.year}</span></div>
          <h3><cite>{item.title}</cite></h3>
          <p class="source-author">{item.author}</p>
          <dl>
            <div><dt>{labels.imprint}</dt><dd>{item.imprint}</dd></div>
            <div><dt>{labels.year}</dt><dd>{item.year}</dd></div>
            <div><dt>{labels.isbn}</dt><dd>{item.isbn??labels.unknown}</dd></div>
          </dl>
          <div class="source-uses">
            <h4>{labels.usedFor}</h4>
            <ul>{item.usedFor.map(use=><li>{use}</li>)}</ul>
          </div>
          {item.bibliography&&item.bibliography.length>0&&<div class="source-links source-bibliography" aria-label={labels.bibliography}>
            <span>{labels.bibliography}</span>
            {item.bibliography.map(link=><a href={link.url} rel="noopener noreferrer" target="_blank" data-kind={link.kind}>{link.label} ↗</a>)}
          </div>}
          {item.note&&<p class="source-note">{item.note}</p>}
          {item.acquisition&&item.acquisition.length>0&&<div class="source-links" aria-label={labels.acquisition}>
            <span>{labels.acquisition}</span>
            {item.acquisition.map(link=><a href={link.url} rel="noopener noreferrer" target="_blank">{link.label} ↗</a>)}
          </div>}
        </article>)}
      </div>
    </section>

    <aside class="source-scope" aria-label={labels.aria}>
      <strong>{labels.scopeTitle}</strong>
      <p>{labels.scope}</p>
    </aside>
  </main>
</body>
</html>

<style>
  .source-library{padding:54px 0 96px}
  .source-library-head{max-width:760px;margin-bottom:58px}
  .source-kicker{margin:0 0 12px;font:600 11px/1.2 Inter,sans-serif;letter-spacing:.18em;color:var(--soft)}
  .source-library h1{margin:0 0 20px;font:500 clamp(36px,7vw,72px)/1.05 "Noto Serif JP",Georgia,serif;letter-spacing:-.02em}
  .source-library-head>p:last-child{max-width:680px;margin:0;color:var(--soft);font-size:15px;line-height:2}
  .source-section-head{display:flex;align-items:end;justify-content:space-between;padding-bottom:12px;border-bottom:1px solid var(--ink);margin-bottom:24px}
  .source-section-head h2{margin:0;font:500 24px/1.2 "Noto Serif JP",Georgia,serif}
  .source-section-head span{font:500 11px/1 Inter,sans-serif;color:var(--soft)}
  .source-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
  .source-card{padding:24px;border:1px solid var(--rule);background:var(--paper)}
  .source-card-meta{display:flex;justify-content:space-between;gap:16px;margin-bottom:22px;font:500 10px/1.2 Inter,sans-serif;letter-spacing:.12em;color:var(--soft)}
  .source-card h3{margin:0 0 10px;font:500 24px/1.35 "Noto Serif JP",Georgia,serif}
  .source-card cite{font-style:normal}
  .source-author{margin:0 0 22px;font:500 13px/1.5 Inter,sans-serif}
  .source-card dl{margin:0 0 24px;border-top:1px solid var(--rule)}
  .source-card dl>div{display:grid;grid-template-columns:90px 1fr;gap:14px;padding:10px 0;border-bottom:1px solid var(--rule);font-size:12px;line-height:1.65}
  .source-card dt{color:var(--soft)}
  .source-card dd{margin:0}
  .source-uses h4{margin:0 0 10px;font:600 10px/1.2 Inter,sans-serif;letter-spacing:.08em;color:var(--soft)}
  .source-uses ul{margin:0;padding-left:1.1em;font-size:13px;line-height:1.8}
  .source-note{margin:20px 0 0;padding-top:16px;border-top:1px solid var(--rule);font-size:12px;line-height:1.8;color:var(--soft)}
  .source-links{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:18px}
  .source-bibliography{padding-top:16px;border-top:1px solid var(--rule)}
  .source-links>span{font:600 10px/1 Inter,sans-serif;letter-spacing:.08em;color:var(--soft)}
  .source-links a{color:var(--ink);font-size:12px;text-underline-offset:3px}
  .source-scope{margin-top:34px;padding:20px 0;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule)}
  .source-scope strong{display:block;margin-bottom:8px;font:600 10px/1 Inter,sans-serif;letter-spacing:.1em;color:var(--soft)}
  .source-scope p{max-width:760px;margin:0;font-size:13px;line-height:1.85}
  @media(max-width:760px){
    .source-library{padding:38px 0 72px}
    .source-library-head{margin-bottom:42px}
    .source-grid{grid-template-columns:1fr}
    .source-card{padding:20px}
    .source-card dl>div{grid-template-columns:82px 1fr}
  }
</style>
