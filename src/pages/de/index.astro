---
import { getCollection } from 'astro:content';
import SeoHead from '../../components/SeoHead.astro';
import HomeLanding from '../../components/HomeLanding.astro';
import OwnerThumbnailFrame from '../../components/OwnerThumbnailFrame.astro';
import OwnerFonts from '../../components/OwnerFonts.astro';
import ownersDirectory from '../../data/owners-directory.json';
import { germanWatchEntriesWithCyma } from '../../data/cyma-localizations';
import '../../styles/site.css';
import '../../styles/home-v2.css';
import '../../styles/owners-v15.css';

const base = import.meta.env.BASE_URL;
const watches = await getCollection('watches');
const watchBySlug = new Map(watches.map((item) => [item.data.slug, item]));
const entries = ownersDirectory.entries
  .flatMap((meta) => {
    const watch = watchBySlug.get(meta.historyId);
    const localized = germanWatchEntriesWithCyma[meta.historyId];
    if (!watch?.data.published || !localized) return [];
    return [{
      ...meta,
      ownerNumber: watch.data.ownerNumber,
      brand: watch.data.brand,
      name: watch.data.model,
      href: `/de/${watch.data.slug}/`,
      directoryCatch: localized.indexBlurb
    }];
  })
  .sort((a, b) => a.ownedSortKey - b.ownedSortKey || Number(a.ownerNumber) - Number(b.ownerNumber));

const title = "VINTAGE ALARM — Mechanische Wecker-Armbanduhren | Deutsch";
const description = "VINTAGE ALARM auf Deutsch: Geschichte, eigene Exemplare, reale Alarmtöne, Klangmechanismen und quellenbasierte Recherchen zu mechanischen Wecker-Armbanduhren.";
const socialImage = '/images/history-motifs/before-watercolor.png';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: "VINTAGE ALARM — Deutsch",
  description,
  inLanguage: 'de',
  url: 'https://vintagealarm.github.io/de/',
  hasPart: [
    { '@type': 'Article', name: 'Geschichte der Wecker-Armbanduhr', url: 'https://vintagealarm.github.io/de/history/' },
    { '@type': 'CollectionPage', name: 'HOW THEY RING', url: 'https://vintagealarm.github.io/de/how-they-ring/' }
  ]
};
const alternates = [
  { hreflang: 'ja', href: '/' },
  { hreflang: 'en', href: '/en/' },
  { hreflang: 'de', href: '/de/' },
  { hreflang: 'x-default', href: '/' }
];
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f8f4" />
    <OwnerFonts />
    <SeoHead title={title} description={description} path="de/" image={socialImage} locale="de_DE" schema={schema} alternates={alternates} />
  </head>
  <body class="home-v2 owners-v15">
    <HomeLanding locale="de" />

    <section class="shell localized-directory" id="owners-notes" aria-label="Lokalisierte Uhrenseiten">
      <header class="directory-intro localized-directory-intro">
        <div>
          <div class="eyebrow">VINTAGE ALARM</div>
          <h2>OWNER'S NOTES</h2>
        </div>
        <p class="directory-meta" set:html="EIGENE UHREN<br/>DEUTSCH"></p>
      </header>
      <div class="directory-eras">
        <section class="directory-era">
          <h2>UHREN</h2>
          <div class="directory-tiles">
            {entries.map((entry) => (
              <OwnerThumbnailFrame
                brand={entry.brand}
                name={entry.name}
                directoryCatch={entry.directoryCatch}
                href={`${base}${entry.href.replace(/^\//, '')}`}
                image={`${base}${(entry.ownersThumbnail ?? entry.image).replace(/^\//, '')}`}
                smartFit={false}
              />
            ))}
          </div>
        </section>
      </div>
    </section>
  </body>
</html>

<style>
  .localized-directory{padding-top:18px;padding-bottom:80px}
  .localized-directory-intro{margin-top:0}
  .localized-directory-intro h2{margin:0;font:400 clamp(38px,5vw,62px)/1 Georgia,"Times New Roman",serif;letter-spacing:-.03em}
</style>
