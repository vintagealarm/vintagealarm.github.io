---
const title = 'COUNCIL LAB V2｜多視点AI議論';
const description = '目的に応じて議論プロトコルと表示形式を切り替えるCouncil V2。';
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="robots" content="noindex,nofollow" />
<title>{title}</title><meta name="description" content={description} />
<style>
:root{--bg:#efefe8;--paper:#fafaf4;--ink:#111;--muted:#666;--line:#aaa99d;--red:#8b1f17;--green:#275d31;--blue:#0000cc;--warn:#fff1c7}*{box-sizing:border-box}html{background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Hiragino Kaku Gothic ProN","Yu Gothic",Meiryo,sans-serif}body{margin:0;line-height:1.65}button,input,textarea,select{font:inherit}button{cursor:pointer}.wrap{width:min(1160px,calc(100% - 24px));margin:auto}header{padding:18px 0 11px;border-bottom:3px double #666;background:#e6e6df}.mast{display:flex;justify-content:space-between;gap:16px;align-items:end}.mast h1{margin:0;font:500 clamp(1.8rem,6vw,3.1rem)/1 Georgia,"Times New Roman",serif}.mast p{margin:6px 0 0;color:var(--muted);font-size:11px}.tag{border:1px solid #777;padding:4px 7px;font-size:9px;letter-spacing:.12em}main{padding:16px 0 60px}.notice{padding:9px 11px;border:1px solid #c7aa4f;background:var(--warn);font-size:11px}.layout{display:grid;grid-template-columns:minmax(0,390px) minmax(0,1fr);gap:15px;align-items:start}.panel,.result{border:1px solid var(--line);background:var(--paper)}.head{padding:8px 10px;border-bottom:1px solid var(--line);background:#deded5;font-size:11px;font-weight:700}.body{padding:11px}.field{display:block;margin-bottom:12px}.field>span{display:block;margin-bottom:4px;color:var(--muted);font-size:10px;font-weight:700}input,textarea,select{width:100%;border:1px solid #99998c;background:#fff;padding:9px 10px;color:var(--ink)}textarea{min-height:120px;resize:vertical}.formats{display:grid;gap:7px}.format{display:grid;grid-template-columns:26px 1fr;gap:9px;text-align:left;border:1px solid var(--line);background:#fff;padding:9px}.format[aria-pressed="true"]{outline:2px solid #333;outline-offset:-2px;background:#f0f0e7}.format b{font-size:13px}.format small{display:block;color:var(--muted);font-size:10px}.num{font:700 18px/1 Georgia,serif;color:var(--red)}.triple{display:grid;grid-template-columns:1fr 1fr;gap:7px}.primary{width:100%;border:1px solid #222;background:#222;color:#fff;padding:10px}.status{margin-top:9px;padding:8px 9px;border-left:3px solid #8b2019;background:#f3e8e4;font-size:9px}.status.live{border-color:#187328;background:#e6f0e7}.result{min-height:650px}.empty,.loading{padding:70px 22px;text-align:center;color:#777;font-size:12px}.summary{padding:14px;border-bottom:1px solid var(--line);background:#ecece3}.summary h2{margin:0 0 6px;color:var(--red);font-size:18px}.meta{color:var(--muted);font-size:9px}.section{padding:14px;border-bottom:1px solid #d0d0c5}.section h3{margin:0 0 10px;font-size:13px}.card{margin:0 0 9px;padding:10px;border:1px solid #c3c3b8;background:#fff}.card:last-child{margin-bottom:0}.card h4{margin:0 0 5px;font-size:12px}.card p{margin:0;font-size:13px;white-space:pre-wrap}.muted{color:var(--muted);font-size:9px}.thread-post{padding:12px 2px;border-bottom:1px solid #d0d0c5}.thread-post .meta-line{font-size:11px}.thread-post .name{color:#008000;font-weight:700}.thread-post .txt{margin:7px 0 0 1.5em;font-size:14px;white-space:pre-wrap}.panel-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.votes{display:flex;flex-wrap:wrap;gap:6px}.vote{border:1px solid #bbb;background:#fff;padding:5px 7px;font-size:9px}.error{padding:20px;color:#8b2019}.foot{margin-top:8px;color:var(--muted);font-size:9px}details{margin-top:10px}summary{cursor:pointer;font-size:9px;color:var(--muted)}:focus-visible{outline:2px solid #222;outline-offset:2px}@media(max-width:800px){.layout{grid-template-columns:1fr}.result{min-height:300px}.panel-grid{grid-template-columns:1fr}.triple{grid-template-columns:1fr 1fr}}@media(max-width:390px){.wrap{width:calc(100% - 14px)}.triple{grid-template-columns:1fr}.format{grid-template-columns:23px 1fr;padding:8px}.thread-post .txt{margin-left:.7em}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style>
</head>
<body>
<header><div class="wrap mast"><div><h1>COUNCIL LAB V2</h1><p>同じ脳を、6つの会議形式で使い分ける。</p></div><span class="tag">PROTOCOL-DRIVEN</span></div></header>
<main class="wrap">
<p class="notice"><strong>V2：</strong> 人数や固定ラウンドではなく、独立初手 → Board → 反証 → 必要時だけHot Seat → 匿名再評価 → Minority Reportで進めます。API未設定時に偽のCouncil結果は生成しません。</p>
<div class="layout">
<div>
<section class="panel"><div class="head">1｜議題</div><div class="body">
<label class="field"><span>タイトル</span><input id="title" value="この案をどう進めるべきか？" /></label>
<label class="field"><span>分かっていること・制約</span><textarea id="body">ここに議題、既知の事実、変更禁止、決めたいことを書く。</textarea></label>
</div></section>
<section class="panel" style="margin-top:11px"><div class="head">2｜形式</div><div class="body"><div class="formats" id="formats"></div></div></section>
<section class="panel" style="margin-top:11px"><div class="head">3｜調査と深さ</div><div class="body">
<div class="triple"><label class="field"><span>領域</span><select id="domain"><option value="general">一般</option><option value="watch">時計研究</option><option value="business">仕事・企画</option></select></label><label class="field"><span>Evidence</span><select id="evidence"><option value="project">Project</option><option value="project-web">Project + Web</option><option value="deep-web">Deep Web</option><option value="web">Webのみ</option><option value="none">外部資料なし</option></select></label></div>
<div class="triple"><label class="field"><span>Budget</span><select id="budget"><option value="standard">Standard</option><option value="quick">Quick</option><option value="deep">Deep</option></select></label><label class="field"><span>人数</span><select id="size"><option value="">Auto</option><option>4</option><option>5</option><option>6</option><option>7</option><option>8</option><option>9</option><option>10</option></select></label></div>
<label class="field"><span>PRE-MORTEM段階</span><select id="premortemStage" disabled><option value="zero-code">コード0行｜前提破壊</option><option value="post-spike">最小SPIKE後｜再評価</option></select></label>
<details><summary>ENGINE API URL</summary><input id="api" type="url" placeholder="https://.../api/council" /></details><div id="status" class="status"></div>
<button class="primary" id="run" type="button">Councilを実行</button><p class="foot">ChatGPTでは「焼いて」→ 6択 → 選択後、既知情報を再利用。精度を上げる不足がある時だけ質問。</p>
</div></section>
</div>
<section class="result" aria-live="polite"><div class="head">RESULT</div><div id="result"><div class="empty">左で議題と形式を選び、Councilを実行する。</div></div></section>
</div>
</main>
<script is:inline>
const FORMATS=[
{id:'thread',n:1,title:'2ch民で焼いて',desc:'スレ表示。煽り・反論・レスバ込みで論点を削る'},
{id:'panel',n:2,title:'みんなで議論して',desc:'ひな壇。複数視点をテンポよくぶつける'},
{id:'council',n:3,title:'冷静に決めて',desc:'評議会。選択肢を比較して最終判断まで出す'},
{id:'claims',n:4,title:'監査して',desc:'Claim Board。主張・根拠・反証・未確認を分解する'},
{id:'brainstorm',n:5,title:'案出して',desc:'Brainstorming Board。独立発想→整理→発展→絞り込み'},
{id:'premortem',n:6,title:'事前に地雷探知して',desc:'PRE-MORTEM。失敗を仮定し、0行または最小SPIKE後に設計を焼く'}];
let format='panel';const $=s=>document.querySelector(s),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function controls(){ $('#formats').innerHTML=FORMATS.map(x=>`<button class="format" data-f="${x.id}" aria-pressed="${format===x.id}"><span class="num">${x.n}</span><span><b>${x.title}</b><small>${x.desc}</small></span></button>`).join('');document.querySelectorAll('[data-f]').forEach(b=>b.onclick=()=>{format=b.dataset.f;controls()});$('#premortemStage').disabled=format!=='premortem';const api=$('#api').value.trim();$('#status').className='status'+(api?' live':'');$('#status').textContent=api?'ENGINE APIを使用します。':'ENGINE API未設定。実Council結果は生成しません。';}
const nameMap={source:'史料警察',mechanic:'機構オタク',market:'市場屋',historian:'時計史厨',collector:'沼の住人',editor:'編集者',devil:'前提破壊班',schema:'データモデル警察',state:'状態遷移監査員',ops:'保守運用民',cfo:'冷徹なCFO',novice:'初見の名無しさん',researcher:'検索沼研究員',minimal:'ミニマリスト',wild:'野良の変人',aa:'AA職人'};
function summary(x){const stage=x.format==='premortem'?` · ${x.premortemStage==='post-spike'?'最小SPIKE後':'コード0行'}`:'';return`<div class="summary"><h2>${esc(x.formatLabel||x.format)}</h2><div class="meta">${esc(x.domain)} · ${esc(x.evidence)} · ${esc(x.budget)} · ${esc(x.panelSize)}人${stage} · ${esc(x.stopReason)}</div></div>`}
function board(x){return`<div class="section"><h3>${esc(x.board?.label||'BOARD')}</h3>${(x.board?.items||[]).map(i=>`<article class="card"><h4>${esc(i.id)} ${i.classification?`[${esc(i.classification)}] `:''}${esc(i.title)}</h4><p>${esc(i.statement)}</p>${x.format==='claims'||x.format==='premortem'?`<div class="muted">支持: ${esc((i.support||[]).join(' / ')||'なし')}<br>反証: ${esc((i.challenge||[]).join(' / ')||'なし')}<br>未確認: ${esc((i.unknowns||[]).join(' / ')||'なし')}${i.smallestSpike?`<br>最小SPIKE: ${esc(i.smallestSpike)}`:''}</div>`:''}</article>`).join('')}</div>`}
function synth(x){const s=x.synthesis||{},decision=x.format==='premortem'?`<p><strong>判定：</strong>${esc(s.verdict||'SPIKEしてからGO')}</p>${s.smallestSpike?`<p><strong>最小SPIKE：</strong>${esc(s.smallestSpike)}</p>`:''}`:s.recommended?`<p><strong>推奨：</strong>${esc(s.recommended)}</p>`:'';return`<div class="section"><h3>議長</h3><div class="card"><p>${esc(s.conclusion||'')}</p>${decision}</div>${(s.minorityReport||[]).length?`<h3>Minority Report</h3>${s.minorityReport.map(v=>`<div class="card"><p>${esc(v)}</p></div>`).join('')}`:''}${(s.unknowns||s.unverified||[]).length?`<h3>未確認</h3>${(s.unknowns||s.unverified||[]).map(v=>`<div class="card"><p>${esc(v)}</p></div>`).join('')}`:''}</div>`}
function thread(x){let n=1;return`<div class="section">${(x.posts||[]).filter(p=>p.phase!=='revote').map(p=>`<article class="thread-post"><div class="meta-line"><span>${n++}</span> 名前:<span class="name">${esc(nameMap[p.resident]||p.resident)}</span>${p.target?` &gt;&gt;${esc(p.target)}`:''}</div><div class="txt">${esc(p.text)}</div></article>`).join('')}</div>${synth(x)}`}
function panel(x){const p=(x.posts||[]).filter(z=>z.phase==='silent'||z.phase==='cross');return`<div class="section"><h3>ひな壇</h3><div class="panel-grid">${p.map(z=>`<article class="card"><h4>${esc(nameMap[z.resident]||z.resident)}</h4><p>${esc(z.text)}</p></article>`).join('')}</div></div>${synth(x)}`}
function votes(x){const p=(x.posts||[]).filter(z=>z.phase==='revote');return`<div class="section"><h3>匿名再評価</h3><div class="votes">${p.map(z=>`<span class="vote">${esc(nameMap[z.resident]||z.resident)} → ${esc(z.target||'ABSTAIN')} / ${esc(z.pre??'-')}→${esc(z.post??z.confidence)}</span>`).join('')}</div></div>`}
function render(x){let inner=summary(x);if(x.format==='thread')inner+=thread(x);else if(x.format==='panel')inner+=panel(x);else if(x.format==='council'||x.format==='premortem')inner+=board(x)+votes(x)+synth(x);else inner+=board(x)+synth(x);$('#result').innerHTML=inner;}
$('#api').value=localStorage.getItem('councilApi')||'';$('#api').addEventListener('input',controls);controls();
$('#run').onclick=async()=>{const api=$('#api').value.trim();if(!api){$('#result').innerHTML='<div class="error">ENGINE API URLを設定してください。ローカルの偽結果は生成しません。</div>';return}const title=$('#title').value.trim(),body=$('#body').value.trim();if(!title||!body){$('#result').innerHTML='<div class="error">タイトルと既知情報を入力してください。</div>';return}localStorage.setItem('councilApi',api);const payload={title,body,format,domain:$('#domain').value,evidence:$('#evidence').value,budget:$('#budget').value,...(format==='premortem'?{premortemStage:$('#premortemStage').value}:{}),...($('#size').value?{panelSize:Number($('#size').value)}:{})};$('#result').innerHTML='<div class="loading">独立初手 → Board → Cross Exam → 再評価を実行中…</div>';try{const r=await fetch(api,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(payload)});if(!r.ok)throw Error(await r.text());render(await r.json())}catch(e){$('#result').innerHTML=`<div class="error">ENGINE API error<br>${esc(e?.message||e)}</div>`}};
</script>
</body></html>
