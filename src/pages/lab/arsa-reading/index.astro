---
import { getCollection } from 'astro:content';
import SectionMast from '../../../components/SectionMast.astro';
import OwnerFonts from '../../../components/OwnerFonts.astro';
import Sources from '../../../components/Sources.astro';
import '../../../styles/site.css';

const entries = await getCollection('watches');
const watch = entries.find((entry) => entry.data.slug === 'arsa-blind-alarm');
if (!watch) throw new Error('ARSA Blind Alarm source is missing');
const data = watch.data;
const chapters = data.deepDive ?? [];
const gallery = data.specimenGallery ?? [];
const mediaUrl = (path: string) => path.startsWith('/') ? path : '/' + path;
const layouts = [
  { id: 'a', name: '本文中心' },
  { id: 'b', name: '写真併走' },
  { id: 'c', name: '章ごと' }
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="theme-color" content="#f3eee4" />
    <title>ARSA Blind Alarm｜記事レイアウト比較｜VINTAGE ALARM</title>
    <OwnerFonts />
  </head>
  <body>
    <SectionMast rightLabel="ARSA / AS1475" />
    <main class="arsa-lab" data-arsa-lab data-mode="a">
      <div class="lab-switch shell">
        <div class="lab-switch-copy">
          <strong>記事レイアウト</strong>
          <span>同じ本文・同じ写真で表示を切り替え</span>
        </div>
        <div class="lab-options" role="group" aria-label="記事レイアウトの切替">
          {layouts.map((layout) => (
            <button
              type="button"
              data-layout-option={layout.id}
              aria-pressed={layout.id === 'a' ? 'true' : 'false'}
              aria-label={layout.id.toUpperCase() + '案：' + layout.name}
            >
              <b>{layout.id.toUpperCase()}</b><span>{layout.name}</span>
            </button>
          ))}
        </div>
      </div>

      <header class="lab-hero shell">
        <div class="lab-intro">
          <p class="lab-eyebrow">ARSA / BLIND ALARM</p>
          <h1>{data.brand}<span>{data.model}</span></h1>
          <p class="lab-catch">{data.catch.join('')}</p>
          <div class="lab-lead">
            {data.ownersNote.lead.map((line: string) => <p>{line}</p>)}
          </div>
        </div>
        {gallery[0] && (
          <figure class="lab-hero-figure">
            <a href={mediaUrl(gallery[0].image)} target="_blank" rel="noopener noreferrer" aria-label={'写真を拡大：' + gallery[0].label}>
              <img src={mediaUrl(gallery[0].image)} alt={'ARSA Blind Alarm：' + gallery[0].label} fetchpriority="high" />
            </a>
            <figcaption>{gallery[0].label}</figcaption>
          </figure>
        )}
      </header>

      <nav class="lab-index shell" aria-label="記事の目次">
        {chapters.map((chapter) => (
          <a href={'#chapter-' + chapter.number}><span>{chapter.number}</span>{chapter.title}</a>
        ))}
      </nav>

      <div class="lab-reading shell">
        {chapters.map((chapter, chapterIndex: number) => {
          const figure = gallery[chapterIndex + 1];
          return (
            <section class="lab-chapter" id={'chapter-' + chapter.number} aria-labelledby={'title-' + chapter.number}>
              <div class="lab-copy">
                <p class="lab-chapter-number">{chapter.number}</p>
                <h2 id={'title-' + chapter.number}>{chapter.title}</h2>
                {chapter.subtitle && <h3>{chapter.subtitle}</h3>}
                {chapter.paragraphs.map((paragraph: string, paragraphIndex: number) => {
                  const refs = (chapter.citationRefs?.[paragraphIndex] ?? '')
                    .split(',').map((ref: string) => ref.trim()).filter(Boolean);
                  return (
                    <p class="lab-paragraph">
                      {paragraph}
                      {refs.length > 0 && (
                        <sup class="lab-cites" aria-label={'出典 ' + refs.join('、')}>
                          {refs.map((ref: string, index: number) => (
                            <>
                              {index > 0 && <span aria-hidden="true">,</span>}
                              <a href={'#source-' + ref}>{ref}</a>
                            </>
                          ))}
                        </sup>
                      )}
                    </p>
                  );
                })}
              </div>
              {figure && (
                <figure class="lab-figure">
                  <a href={mediaUrl(figure.image)} target="_blank" rel="noopener noreferrer" aria-label={'写真を拡大：' + figure.label}>
                    <img src={mediaUrl(figure.image)} alt={'ARSA Blind Alarm：' + figure.label} loading="lazy" decoding="async" />
                  </a>
                  <figcaption>{figure.label}</figcaption>
                </figure>
              )}
            </section>
          );
        })}
      </div>
      <Sources sources={data.sources} meta={data.sourceMeta} />
      <footer class="lab-footer shell">
        <a href="/arsa-blind-alarm/">ARSA Blind Alarm の個体ページへ戻る</a>
      </footer>
    </main>

    <script>
      const root = document.querySelector<HTMLElement>('[data-arsa-lab]');
      const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-layout-option]'));
      const allowed = new Set(['a', 'b', 'c']);
      const setLayout = (layout: string) => {
        if (!root || !allowed.has(layout)) return;
        root.dataset.mode = layout;
        for (const button of buttons) {
          button.setAttribute('aria-pressed', button.dataset.layoutOption === layout ? 'true' : 'false');
        }
      };
      const initial = new URLSearchParams(window.location.search).get('layout');
      if (initial && allowed.has(initial)) setLayout(initial);
      for (const button of buttons) {
        button.addEventListener('click', () => {
          const layout = button.dataset.layoutOption || 'a';
          setLayout(layout);
          const url = new URL(window.location.href);
          url.searchParams.set('layout', layout);
          window.history.replaceState(null, '', url);
        });
      }
    </script>
  </body>
</html>

<style>
  :global(html) { scroll-behavior: smooth; }
  :global(body) { background: #f3eee4; color: #241f1a; }
  :global(.section-mast) { border-bottom: 1px solid #b4a99b; }
  .arsa-lab { --lab-ink:#241f1a; --lab-soft:#665e55; --lab-rule:#b4a99b; --lab-paper:#f3eee4; }
  .arsa-lab .shell { width: min(calc(100% - 48px), 1120px); }
  .lab-switch { display:flex; align-items:center; justify-content:space-between; gap:24px; padding:26px 0 24px; border-bottom:1px solid var(--lab-rule); }
  .lab-switch-copy { display:grid; gap:4px; font-family:Inter,'Yu Gothic',sans-serif; }
  .lab-switch-copy strong { font-size:15px; font-weight:650; }
  .lab-switch-copy span { color:var(--lab-soft); font-size:12px; }
  .lab-options { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); width:min(100%,450px); border:1px solid var(--lab-ink); }
  .lab-options button { display:flex; align-items:center; justify-content:center; gap:8px; min-height:52px; min-width:0; padding:9px 12px; border:0; border-right:1px solid var(--lab-ink); background:transparent; color:var(--lab-ink); font-family:Inter,'Yu Gothic',sans-serif; font-size:13px; cursor:pointer; }
  .lab-options button:last-child { border-right:0; }
  .lab-options button[aria-pressed="true"] { background:var(--lab-ink); color:var(--lab-paper); }
  .lab-options button:focus-visible { outline:3px solid #a35c3b; outline-offset:3px; position:relative; z-index:1; }
  .lab-options b { font:400 21px/1 Georgia,serif; }
  .lab-hero { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,.85fr); align-items:center; gap:clamp(24px,5vw,72px); padding:68px 0 72px; }
  .lab-eyebrow { margin:0 0 22px; color:var(--lab-soft); font:13px/1.5 Georgia,serif; letter-spacing:.16em; }
  .lab-intro h1 { margin:0; font:400 clamp(54px,7.2vw,94px)/.98 Georgia,serif; letter-spacing:-.035em; }
  .lab-intro h1 span { display:block; font-size:.76em; line-height:1.12; }
  .lab-catch { margin:30px 0 20px; font-size:clamp(20px,2.3vw,27px); font-weight:600; line-height:1.7; }
  .lab-lead { color:var(--lab-soft); font-size:17px; line-height:1.85; }
  .lab-lead p { margin:0; }
  .lab-hero-figure, .lab-figure { margin:0; min-width:0; }
  .lab-hero-figure a, .lab-figure a { display:block; border:1px solid var(--lab-rule); background:#e8e1d7; }
  .lab-hero-figure img { display:block; width:100%; height:clamp(330px,42vw,510px); object-fit:contain; }
  .lab-figure img { display:block; width:100%; max-height:460px; object-fit:contain; }
  .lab-hero-figure figcaption, .lab-figure figcaption { padding:9px 0; color:var(--lab-soft); font-family:Inter,'Yu Gothic',sans-serif; font-size:12px; }
  .lab-index { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); border-top:1px solid var(--lab-ink); border-bottom:1px solid var(--lab-ink); }
  .lab-index a { display:flex; flex-direction:column; gap:10px; min-width:0; padding:20px 15px; border-right:1px solid var(--lab-rule); font-size:13px; line-height:1.7; text-decoration:none; }
  .lab-index a:first-child { padding-left:0; }
  .lab-index a:last-child { border-right:0; }
  .lab-index span { color:#9a4c3c; font:18px/1 Georgia,serif; }
  .lab-index a:focus-visible, .lab-figure a:focus-visible, .lab-hero-figure a:focus-visible { outline:3px solid #a35c3b; outline-offset:3px; }
  .lab-reading { padding-top:20px; }
  .lab-chapter { display:grid; grid-template-columns:minmax(0,1fr); gap:32px; padding:64px 0 78px; border-bottom:1px solid var(--lab-rule); scroll-margin-top:24px; }
  .lab-copy { min-width:0; }
  .lab-chapter-number { margin:0 0 10px; color:#9a4c3c; font:23px/1 Georgia,serif; }
  .lab-copy h2 { margin:0 0 28px; font-family:'Noto Serif JP','Yu Mincho',serif; font-size:clamp(25px,3.3vw,36px); font-weight:600; line-height:1.55; letter-spacing:0; }
  .lab-copy h3 { margin:0 0 22px; color:var(--lab-soft); font-size:18px; font-weight:500; line-height:1.75; }
  .lab-paragraph { margin:0 0 1.5em; font-size:17px; line-height:2.05; line-break:strict; word-break:normal; overflow-wrap:anywhere; }
  .lab-paragraph:last-child { margin-bottom:0; }
  .lab-cites { padding-left:3px; white-space:nowrap; font:12px/1.5 Georgia,serif; vertical-align:super; }
  .lab-cites a { padding:0 2px; color:#9a4c3c; }
  .arsa-lab[data-mode="a"] .lab-chapter { max-width:790px; margin-inline:auto; }
  .arsa-lab[data-mode="a"] .lab-figure { width:min(100%,630px); margin:6px auto 0; }
  .arsa-lab[data-mode="b"] .lab-hero { grid-template-columns:1fr; gap:28px; max-width:900px; }
  .arsa-lab[data-mode="b"] .lab-hero-figure img { height:clamp(360px,56vw,600px); }
  .arsa-lab[data-mode="b"] .lab-chapter { grid-template-columns:minmax(0,1fr) minmax(240px,.72fr); gap:clamp(28px,5vw,70px); align-items:start; }
  .arsa-lab[data-mode="b"] .lab-figure { position:sticky; top:20px; }
  .arsa-lab[data-mode="c"] .lab-hero { grid-template-columns:minmax(0,1fr) minmax(0,.7fr); }
  .arsa-lab[data-mode="c"] .lab-chapter { grid-template-columns:minmax(0,1fr) minmax(0,.9fr); gap:clamp(24px,4vw,56px); padding:clamp(28px,4vw,52px); margin:28px 0; border:1px solid var(--lab-rule); background:rgba(255,255,255,.26); align-items:center; }
  .arsa-lab[data-mode="c"] .lab-chapter:nth-child(odd) .lab-copy { grid-column:1; grid-row:1; }
  .arsa-lab[data-mode="c"] .lab-chapter:nth-child(odd) .lab-figure { grid-column:2; grid-row:1; }
  .arsa-lab[data-mode="c"] .lab-chapter:nth-child(even) .lab-copy { grid-column:2; grid-row:1; }
  .arsa-lab[data-mode="c"] .lab-chapter:nth-child(even) .lab-figure { grid-column:1; grid-row:1; }
  .lab-footer { padding:20px 0 90px; font-size:15px; }
  .lab-footer a { display:inline-block; padding:10px 0; text-underline-offset:5px; }
  @media (max-width:800px) {
    .lab-hero, .arsa-lab[data-mode="c"] .lab-hero { grid-template-columns:1fr; padding:46px 0 52px; }
    .lab-hero-figure img { height:auto; max-height:520px; }
    .lab-index { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .lab-index a { border-bottom:1px solid var(--lab-rule); }
    .lab-index a:nth-child(2n) { border-right:0; }
    .lab-index a:nth-last-child(-n+1) { border-bottom:0; }
    .arsa-lab[data-mode="b"] .lab-chapter,
    .arsa-lab[data-mode="c"] .lab-chapter { grid-template-columns:minmax(0,1fr); }
    .arsa-lab[data-mode="b"] .lab-figure { position:static; }
    .arsa-lab[data-mode="c"] .lab-chapter .lab-copy,
    .arsa-lab[data-mode="c"] .lab-chapter .lab-figure { grid-column:auto!important; grid-row:auto!important; }
  }
  @media (max-width:560px) {
    .arsa-lab .shell { width:calc(100% - 32px); }
    .lab-switch { align-items:stretch; flex-direction:column; gap:14px; padding:18px 0; }
    .lab-switch-copy span { font-size:12px; }
    .lab-options { width:100%; }
    .lab-options button { min-height:50px; padding:8px 4px; gap:6px; font-size:12px; }
    .lab-options b { font-size:19px; }
    .lab-intro h1 { font-size:clamp(43px,12vw,62px); }
    .lab-catch { margin-top:22px; font-size:21px; }
    .lab-lead { font-size:16px; }
    .lab-hero-figure img { max-height:430px; }
    .lab-index a { padding:14px 10px; font-size:12px; }
    .lab-index a:first-child { padding-left:10px; }
    .lab-chapter { padding:42px 0 52px; gap:22px; }
    .lab-copy h2 { font-size:26px; }
    .lab-copy h3 { font-size:17px; }
    .lab-paragraph { font-size:16px; line-height:2; }
    .arsa-lab[data-mode="c"] .lab-chapter { padding:20px 16px 24px; margin:18px 0; }
  }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior:auto; } }
</style>
