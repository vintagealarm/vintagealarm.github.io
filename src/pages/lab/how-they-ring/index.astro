---
import { getCollection } from 'astro:content';
import ownersDirectory from '../../../data/owners-directory.json';
import SeoHead from '../../../components/SeoHead.astro';
import SectionMast from '../../../components/SectionMast.astro';
import { howTheyRingCopy, type HowTheyRingLang } from '../../../data/how-they-ring-localized';
import '../../../styles/site.css';

const base = import.meta.env.BASE_URL;
const siteRoot = 'https://vintagealarm.github.io/';
const { production = false, lang = 'ja' } = Astro.props as { production?: boolean; lang?: HowTheyRingLang };
const copy = howTheyRingCopy[lang];
const productionTitle = copy.title;
const productionDescription = copy.description;
const productionUrl = new URL(copy.path, siteRoot).href;
const alternates = [
  { hreflang: 'ja', href: new URL('how-they-ring/', siteRoot).href },
  { hreflang: 'en', href: new URL('en/how-they-ring/', siteRoot).href },
  { hreflang: 'de', href: new URL('de/how-they-ring/', siteRoot).href },
  { hreflang: 'x-default', href: new URL('how-they-ring/', siteRoot).href }
];
const languageLinks = lang === 'ja'
  ? [
      { href: '/en/how-they-ring/', label: 'EN', hreflang: 'en' },
      { href: '/de/how-they-ring/', label: 'DE', hreflang: 'de' }
    ]
  : lang === 'en'
    ? [
        { href: '/how-they-ring/', label: '日本語', hreflang: 'ja' },
        { href: '/de/how-they-ring/', label: 'DE', hreflang: 'de' }
      ]
    : [
        { href: '/how-they-ring/', label: '日本語', hreflang: 'ja' },
        { href: '/en/how-they-ring/', label: 'EN', hreflang: 'en' }
      ];
const productionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'HOW THEY RING',
  description: productionDescription,
  inLanguage: lang,
  url: productionUrl
};
const watches = await getCollection('watches');
const galleryEntries = await getCollection('howTheyRing');
const published = new Map(
  watches.filter((item) => item.data.published).map((item) => [item.data.slug, item.data])
);
const galleryBySlug = new Map(galleryEntries.map((item) => [item.data.watchSlug, item.data]));
const ownerThumbnailBySlug = new Map(
  ownersDirectory.entries.map((entry) => [entry.historyId, entry.ownersThumbnail ?? entry.image])
);

const orderedSlugs = [
  'cyma-time-o-vox',
  'pierce-duofon',
  'wittnauer-10wa',
  'citizen-alarm',
  'basis-alarm',
  'westclox-watchlarm'
];

const categories = copy.categories;

const specimens = orderedSlugs
  .map((slug) => {
    const watch = published.get(slug);
    const gallery = galleryBySlug.get(slug);
    if (!watch || !gallery?.published) return null;
    return {
      slug,
      category: gallery.category,
      brand: watch.brand,
      model: watch.model,
      caliber: watch.spec.caliber,
      image: `${base}${(gallery.thumbnail?.trim() || ownerThumbnailBySlug.get(slug) || '').replace(/^\//, '')}`,
      recordings: gallery.audio.recordings
    };
  })
  .filter(Boolean);

const detailPath = (slug: string) => (
  lang === 'ja' ? `${slug}/#owners-note` : `${lang}/${slug}/#owners-note`
);
const detailHrefLang = () => (lang === 'ja' ? undefined : lang);
const localizedRecordingLabel = (label: string) => copy.recordingLabels[label] ?? label;

---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {production
      ? <SeoHead
          title={productionTitle}
          description={productionDescription}
          path={copy.path}
          image="/images/how-they-ring/gong.jpg"
          type="website"
          locale={copy.locale}
          schema={productionSchema}
          alternates={alternates}
        />
      : <>
          <meta name="robots" content="noindex,nofollow,noarchive" />
          <title>{copy.previewTitle}</title>
        </>}
    <meta name="theme-color" content="#f3eee4" />
    <style>
      :root {
        --lab-ink: #241f1a;
        --lab-soft: #6a6158;
        --lab-rule: #aaa094;
        --lab-paper: #f3eee4;
        --lab-wash: #e9e1d5;
        --lab-white: rgba(255,255,255,.20);
      }

      body { min-width: 0; }

      .lab {
        width: min(calc(100% - 40px), 1060px);
        margin-inline: auto;
        padding: 34px 0 96px;
      }

      .lab-hero {
        padding: 28px 0 42px;
      }

      .lab-kicker {
        margin: 0 0 16px;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 13px;
        letter-spacing: .22em;
      }

      .lab-kicker span {
        display: block;
        margin-top: 3px;
        color: var(--lab-soft);
        font-family: "Yu Mincho","Hiragino Mincho ProN","Noto Serif JP",serif;
        font-size: 10px;
        letter-spacing: .08em;
      }

      .lab-hero h1 {
        margin: 0;
        font-size: clamp(38px, 6vw, 62px);
        font-weight: 500;
        line-height: 1.25;
        letter-spacing: .01em;
      }

      .category-guide {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 14px;
        margin: 0 0 12px;
        color: var(--lab-ink);
        font-size: 13px;
        font-weight: 600;
        line-height: 1.5;
        text-align: center;
      }

      .category-guide-arrow {
        display: flex;
        justify-content: center;
        align-items: center;
        color: var(--lab-soft);
      }

      .category-guide-arrow svg {
        display: block;
        width: 14px;
        height: 28px;
        overflow: visible;
      }

      .category-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        border-top: 1px solid var(--lab-ink);
        border-left: 1px solid var(--lab-ink);
      }

      .category-button {
        --tap-accent: #a86f3e;
        appearance: none;
        position: relative;
        min-width: 0;
        padding: 16px 58px 15px 18px;
        border: 0;
        border-right: 1px solid var(--lab-ink);
        border-bottom: 1px solid var(--lab-ink);
        background: transparent;
        color: inherit;
        text-align: left;
        cursor: pointer;
      }

      .category-button[aria-pressed="true"] {
        background: rgba(36,31,26,.08);
      }

      .category-button[aria-pressed="true"] .category-name strong {
        text-decoration: underline;
        text-decoration-thickness: 2px;
        text-underline-offset: 6px;
      }

      .category-button:focus-visible {
        outline: 2px solid var(--lab-ink);
        outline-offset: 4px;
      }

      .category-name strong,
      .category-name em {
        display: block;
      }

      .category-name strong {
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(25px, 3vw, 32px);
        font-weight: 400;
        line-height: 1;
        letter-spacing: .035em;
      }

      .category-name em {
        margin-top: 6px;
        color: var(--lab-soft);
        font-size: 11px;
        font-style: normal;
      }

      .category-tap {
        position: absolute;
        top: 12px;
        right: 16px;
        display: grid;
        justify-items: center;
        width: 30px;
        color: var(--lab-ink);
        pointer-events: none;
      }

      .category-tap svg {
        display: block;
        width: 27px;
        height: 29px;
      }

      .category-tap-ring {
        opacity: 0;
        transition: opacity .16s ease;
      }

      .category-button[aria-pressed="true"] .category-tap-ring {
        opacity: 1;
      }

      .category-tap small {
        margin-top: 1px;
        color: var(--tap-accent);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 8px;
        font-weight: 600;
        line-height: 1;
        letter-spacing: .08em;
      }

      .category-action {
        display: block;
        margin-top: 12px;
        font-size: 12px;
        line-height: 1.55;
      }

      .mechanism-groups {
        border-left: 1px solid var(--lab-ink);
        border-right: 1px solid var(--lab-ink);
        border-bottom: 1px solid var(--lab-ink);
      }

      .mechanism-group {
        padding: 18px;
      }

      .mechanism-group[hidden] {
        display: none !important;
      }

      .mechanism-grid {
        display: grid;
        grid-template-columns: repeat(var(--figure-count), minmax(0, 1fr));
        gap: 12px;
      }

      .mechanism-variation {
        min-width: 0;
      }

      .variation-no {
        display: block;
        color: var(--lab-soft);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 10px;
        letter-spacing: .11em;
      }

      .mechanism-figure {
        position: relative;
        display: block;
        height: 142px;
        margin-top: 4px;
        overflow: hidden;
      }

      .mechanism-figure > img {
        position: absolute;
        inset: 0;
        display: block;
        width: 100% !important;
        height: 100% !important;
        max-width: none !important;
        object-fit: contain !important;
        background: transparent;
      }

      .mechanism-variation:not([data-figure="01"]) .mechanism-figure > img {
        top: 15px !important;
        bottom: auto !important;
        height: 112px !important;
        min-height: 112px !important;
        max-height: 112px !important;
        object-fit: cover !important;
        object-position: center center;
      }

      .variation-caption {
        display: block;
        margin-top: 7px;
        padding-top: 7px;
        border-top: 1px solid rgba(36,31,26,.24);
        line-height: 1.45;
      }

      .variation-caption strong,
      .variation-caption em {
        display: block;
        font-style: normal;
      }

      .variation-caption strong {
        font-size: 11px;
        font-weight: 500;
      }

      .variation-caption em {
        margin-top: 2px;
        color: var(--lab-soft);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 10px;
        letter-spacing: .04em;
      }

      .mechanism-evidence {
        margin-top: 14px;
        border-top: 1px solid rgba(36,31,26,.24);
      }

      .mechanism-evidence summary {
        padding: 11px 0 2px;
        color: var(--lab-soft);
        font-size: 10px;
        line-height: 1.5;
        cursor: pointer;
      }

      .mechanism-evidence-list {
        display: grid;
        gap: 9px;
        margin-top: 10px;
      }

      .mechanism-evidence-item {
        margin: 0;
        font-size: 10px;
        line-height: 1.65;
      }

      .mechanism-evidence-item strong {
        font-family: Georgia, "Times New Roman", serif;
        font-weight: 400;
        letter-spacing: .04em;
      }

      .mechanism-evidence-item cite {
        color: var(--lab-soft);
        font-style: normal;
      }

      .mechanism-evidence-note {
        margin: 10px 0 0;
        color: var(--lab-soft);
        font-size: 9px;
        line-height: 1.6;
      }

      .selected-section {
        margin-top: 12px;
        border-top: 1px solid var(--lab-ink);
      }

      .selected-head {
        display: block;
        padding: 18px 0 14px;
      }

      .selected-guide {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 6px 18px;
        margin: 10px 0 0;
        color: var(--lab-soft);
        font-size: 10px;
        line-height: 1.55;
      }

      .selected-guide strong {
        margin-right: .45em;
        color: var(--lab-ink);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 9px;
        font-weight: 400;
        letter-spacing: .10em;
      }

      .category-summary[hidden],
      .specimen-card[hidden] {
        display: none !important;
      }

      .category-summary h2 {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 34px;
        font-weight: 400;
        line-height: .95;
      }

      .category-summary h2 small {
        display: block;
        margin-top: 9px;
        color: var(--lab-soft);
        font-family: "Yu Mincho","Hiragino Mincho ProN","Noto Serif JP",serif;
        font-size: 13px;
      }

      .category-summary p {
        margin: 0;
        color: var(--lab-soft);
        font-size: 14px;
        line-height: 1.9;
      }

      .specimen-grid {
        display: block;
        border-top: 1px solid var(--lab-ink);
      }

      .specimen-card {
        display: grid;
        grid-template-columns: 124px minmax(0, 1fr) minmax(170px, .72fr);
        gap: 20px;
        align-items: center;
        min-width: 0;
        padding: 14px 0;
        border-bottom: 1px solid var(--lab-rule);
        background: transparent;
      }

      .specimen-media {
        position: relative;
        display: block;
        aspect-ratio: 4 / 3;
        overflow: hidden;
        background: rgba(255,255,255,.28);
      }

      .specimen-media::after {
        content: attr(data-detail-label);
        position: absolute;
        right: 6px;
        bottom: 6px;
        padding: 3px 5px 2px;
        background: rgba(243,238,228,.88);
        color: var(--lab-ink);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 8px;
        line-height: 1.15;
        letter-spacing: .07em;
        pointer-events: none;
      }

      .specimen-media:focus-visible {
        outline: 2px solid var(--lab-ink);
        outline-offset: 2px;
      }

      .specimen-media img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      .specimen-copy { display: contents; }
      .specimen-meta { min-width: 0; }

      .specimen-type {
        margin: 0 0 7px;
        color: var(--lab-soft);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 10px;
        letter-spacing: .12em;
      }

      .specimen-card h3 {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 18px;
        font-weight: 400;
        line-height: 1.05;
      }

      .specimen-model {
        margin: 6px 0 0;
        font-size: 14px;
      }

      .specimen-caliber {
        margin: 14px 0 0;
        color: var(--lab-soft);
        font-size: 12px;
      }

      .audio-slots {
        display: grid;
        gap: 8px;
        align-self: stretch;
        align-content: center;
      }

      .audio-pending,
      .audio-slots audio {
        width: 100%;
      }

      .audio-slots audio { display: block; max-width: 100%; }
      .audio-slots p { margin: 0 0 6px; color: var(--lab-soft); font-size: 11px; }

      .audio-pending {
        min-height: 52px;
        padding: 9px 11px;
        border: 1px solid var(--lab-rule);
        background: transparent;
        color: var(--lab-soft);
        font: inherit;
        text-align: left;
      }

      .audio-pending span,
      .audio-pending small {
        display: block;
      }

      .audio-pending span {
        font-family: Georgia, "Times New Roman", serif;
        font-size: 11px;
        letter-spacing: .06em;
      }

      .audio-pending small {
        margin-top: 4px;
        font-size: 10px;
      }

      .recording-condition {
        margin-top: 20px;
        padding-top: 8px;
        border-top: 1px solid rgba(36,31,26,.18);
        color: var(--lab-soft);
        font-size: 9px;
        line-height: 1.6;
      }

      .recording-condition summary {
        cursor: pointer;
      }

      .recording-condition summary strong {
        margin-right: .45em;
        color: var(--lab-ink);
        font-family: Georgia, "Times New Roman", serif;
        font-weight: 400;
        letter-spacing: .08em;
      }

      .recording-condition p {
        margin: 6px 0 0;
      }

      .lab-footnote {
        margin: 24px 0 0;
        color: var(--lab-soft);
        font-size: 11px;
        line-height: 1.8;
      }

      @media (hover: hover) and (pointer: fine) {
        .category-button:hover {
          background: rgba(233,225,213,.42);
        }
      }

      @media (max-width: 720px) {
        .lab {
          width: min(calc(100% - 32px), 1060px);
          padding-top: 24px;
        }

        .lab-hero {
          padding: 18px 0 20px;
        }

        .lab-hero h1 {
          font-size: clamp(32px, 10vw, 44px);
        }

        .category-guide {
          gap: 8px;
          font-size: 11px;
        }

        .category-button {
          min-height: 94px;
          padding: 11px 46px 10px 12px;
        }

        .category-tap {
          top: 10px;
          right: 10px;
          width: 27px;
        }

        .category-tap svg {
          width: 24px;
          height: 26px;
        }

        .category-tap small {
          font-size: 7px;
        }

        .category-name strong {
          font-size: clamp(18px, 6vw, 24px);
        }

        .category-action {
          margin-top: 7px;
          font-size: 9.5px;
        }

        .mechanism-group {
          padding: 11px;
        }

        .mechanism-grid {
          gap: 7px;
        }

        .mechanism-figure {
          height: 86px;
        }

        .mechanism-variation:not([data-figure="01"]) .mechanism-figure > img {
          top: 9px !important;
          height: 68px !important;
          min-height: 68px !important;
          max-height: 68px !important;
        }

        .variation-caption {
          margin-top: 4px;
          padding-top: 4px;
        }

        .variation-caption strong {
          font-size: 8.5px;
        }

        .variation-caption em {
          font-size: 7.5px;
          overflow-wrap: anywhere;
        }

        .mechanism-evidence {
          margin-top: 9px;
        }

        .mechanism-evidence summary,
        .mechanism-evidence-item {
          font-size: 8.5px;
        }

        .mechanism-evidence-note {
          font-size: 8px;
        }

        .selected-section {
          margin-top: 8px;
        }

        .selected-head {
          padding: 8px 0 7px;
        }

        .selected-guide {
          gap: 2px 12px;
          margin-top: 6px;
          font-size: 8.5px;
        }

        .selected-guide strong {
          font-size: 8px;
        }

        .category-summary h2 {
          font-size: 22px;
        }

        .category-summary h2 small {
          margin-top: 3px;
          font-size: 9px;
        }

        .category-summary p {
          font-size: 10px;
          line-height: 1.45;
        }

        .specimen-card {
          grid-template-columns: 96px minmax(0, 1fr);
          gap: 14px;
          align-items: start;
        }

        .specimen-media::after {
          right: 4px;
          bottom: 4px;
          padding: 2px 4px;
          font-size: 6.5px;
        }

        .specimen-copy { display: block; }

        .audio-slots {
          min-width: 0;
          margin-top: 10px;
        }
      }

      @media (max-width: 380px) {
        .lab { width: calc(100% - 24px); }

        .category-button {
          padding-inline: 9px;
        }

        .category-name strong {
          font-size: 17px;
        }

        .category-action {
          font-size: 8.5px;
        }

        .mechanism-group {
          padding-inline: 9px;
        }

        .mechanism-grid {
          gap: 5px;
        }

        .variation-caption strong {
          font-size: 8px;
        }

        .variation-caption em {
          font-size: 7px;
        }

        .specimen-card {
          grid-template-columns: 84px minmax(0, 1fr);
          gap: 12px;
        }
      }
    </style>
  </head>
  <body>
    {production && <SectionMast rightLabel={copy.mastRightLabel} lang={lang} languageLinks={languageLinks} />}
    <main class="lab">
      <header class="lab-hero">
        <p class="lab-kicker">HOW THEY RING</p>
        <h1>{copy.hero[0]}<br />{copy.hero[1]}</h1>
      </header>

      <section aria-label={copy.sectionLabel}>
        
        <div class="category-grid">
          {categories.map((category) => (
            <button
              type="button"
              class="category-button"
              data-category={category.id}
              aria-controls="specimen-panel"
              aria-pressed={category.id === 'gong' ? 'true' : 'false'}
            >
              <span class="category-name">
                <strong>{category.en}</strong>
                <em>{category.localLabel}</em>
              </span>
              <span class="category-tap" aria-hidden="true">
                <svg viewBox="0 0 32 34" focusable="false">
                  <path d="M9 23h14M11 23c1.2-1.7 2-4.2 2-7.1V13a3 3 0 0 1 6 0v2.9c0 2.9.8 5.4 2 7.1M14 27c.5 1.2 1.1 1.8 2 1.8s1.5-.6 2-1.8" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/>
                  <path class="category-tap-ring" d="M16 5V2M8.5 7.5 6.4 5.4M23.5 7.5l2.1-2.1" fill="none" stroke="var(--tap-accent)" stroke-width="1.2" stroke-linecap="round"/>
                </svg>
                <small>TAP</small>
              </span>
              <span class="category-action">{category.action}</span>
            </button>
          ))}
        </div>
        <div class="mechanism-groups">
          {categories.map((category) => (
            <div
              class="mechanism-group"
              data-mechanism-group={category.id}
              hidden={category.id !== 'gong'}
            >
              <div class="mechanism-grid" style={`--figure-count:${category.figures.length}`}>
                {category.figures.map((figure) => (
                  <div class="mechanism-variation" data-figure={figure.no}>
                    <span class="variation-no">FIG.{figure.no}</span>
                    <span class="mechanism-figure" aria-hidden="true">
                      <img src={`${base}${figure.image.replace(/^\//, '')}`} alt="" />
                    </span>
                    <span class="variation-caption">
                      <strong>{figure.label}</strong>
                      <em>{figure.example}</em>
                    </span>
                  </div>
                ))}
              </div>
              <details class="mechanism-evidence">
                <summary>{copy.evidenceSummary}</summary>
                <div class="mechanism-evidence-list">
                  {category.figures.map((figure) => (
                    <p class="mechanism-evidence-item">
                      <strong>FIG.{figure.no}</strong> — {figure.evidence}
                      {' '}<cite>{copy.sourcePrefix}{figure.source}</cite>
                    </p>
                  ))}
                </div>
                <p class="mechanism-evidence-note">{copy.classificationNote}</p>
              </details>
            </div>
          ))}
        </div>
      </section>

      <section class="selected-section" id="specimen-panel" aria-live="polite">
        <div class="selected-head">
          <div>
            {categories.map((category) => (
              <div class="category-summary" data-category-summary={category.id} hidden={category.id !== 'gong'}>
                <h2>{category.en}<small>{category.localLabel}</small></h2>
              </div>
            ))}
          </div>
          <p class="selected-guide">
            <span><strong>COMPARE</strong>{copy.compare}</span>
            <span><strong>DETAIL</strong>{copy.detail}</span>
          </p>
        </div>

        <div class="specimen-grid">
          {specimens.map((watch) => (
            <article
              class="specimen-card"
              data-specimen
              data-watch-slug={watch.slug}
              data-category={watch.category}
              hidden={watch.category !== 'gong'}
            >
              <a
                class="specimen-media"
                href={`${base}${detailPath(watch.slug)}`}
                hreflang={detailHrefLang()}
                aria-label={copy.detailAria(watch.brand, watch.model)}
                data-detail-label={copy.detailBadge}
              >
                <img src={watch.image} alt={copy.imageAlt(watch.brand, watch.model)} loading="lazy" />
              </a>
              <div class="specimen-copy">
                <div class="specimen-meta">
                  <p class="specimen-type">
                    {categories.find((item) => item.id === watch.category)?.en}
                    {lang === 'ja' ? '／' : ' / '}{categories.find((item) => item.id === watch.category)?.localLabel}
                  </p>
                  <h3>{watch.brand}</h3>
                  <p class="specimen-model">{watch.model}</p>
                  <p class="specimen-caliber">{watch.caliber}</p>
                </div>

                <div class="audio-slots">
                  {watch.recordings.length ? (
                    watch.recordings.map((recording) => (
                      <div>
                        <p>{localizedRecordingLabel(recording.label)}</p>
                        {recording.src?.trim() ? (
                          <audio controls preload="none" src={`${base}${recording.src.replace(/^\//, '')}`}></audio>
                        ) : (
                          <button class="audio-pending" type="button" disabled>
                            <span>{copy.audioPending}</span>
                          </button>
                        )}
                      </div>
                    ))
                  ) : (
                    <button class="audio-pending" type="button" disabled>
                      <span>{copy.audioPending}</span>
                    </button>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>

        <details class="recording-condition">
          <summary><strong>REC. CONDITION</strong></summary>
          <p>{copy.recordingCondition}</p>
          <p>{copy.recordingNote}</p>
        </details>

      </section>
    </main>

    <script is:inline>
      (() => {
        const categoryButtons = [...document.querySelectorAll('button[data-category]')];
        const specimenCards = [...document.querySelectorAll('[data-specimen]')];
        const headingBlocks = [...document.querySelectorAll('[data-category-summary]')];
        const mechanismGroups = [...document.querySelectorAll('[data-mechanism-group]')];

        const selectCategory = (category) => {
          categoryButtons.forEach((button) => {
            button.setAttribute('aria-pressed', button.dataset.category === category ? 'true' : 'false');
          });
          specimenCards.forEach((card) => {
            card.hidden = card.dataset.category !== category;
          });
          headingBlocks.forEach((block) => {
            block.hidden = block.dataset.categorySummary !== category;
          });
          mechanismGroups.forEach((group) => {
            group.hidden = group.dataset.mechanismGroup !== category;
          });
        };

        categoryButtons.forEach((button) => {
          button.addEventListener('click', () => selectCategory(button.dataset.category));
        });
      })();
    </script>
  </body>
</html>
