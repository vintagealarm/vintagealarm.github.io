---
import { getCollection } from 'astro:content';
import ownersDirectory from '../../../data/owners-directory.json';
import SeoHead from '../../../components/SeoHead.astro';
import '../../../styles/site.css';

const base = import.meta.env.BASE_URL;
const { production = false } = Astro.props as { production?: boolean };
const productionTitle = 'HOW THEY RING｜鳴らし方で見る、アラーム腕時計｜VINTAGE ALARM';
const productionDescription = '機械式アラーム腕時計を、GONG・CASEBACK・BELL・PINの4つの鳴動方式から、掲載実機と音で見比べる。';
const productionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'HOW THEY RING',
  description: productionDescription,
  inLanguage: 'ja',
  url: 'https://vintagealarm.github.io/how-they-ring/'
};
const watches = await getCollection('watches');
const galleryEntries = await getCollection('howTheyRing');
const published = new Map(
  watches.filter((item) => item.data.published).map((item) => [item.data.slug, item.data])
);
const galleryBySlug = new Map(galleryEntries.map((item) => [item.data.watchSlug, item.data]));
const ownerThumbnailBySlug = new Map(
  ownersDirectory.entries.map((entry) => [entry.historyId, entry.ownersThumbnail ?? entry.image])
);

const orderedSlugs = [
  'cyma-time-o-vox',
  'pierce-duofon',
  'wittnauer-10wa',
  'citizen-alarm',
  'basis-alarm',
  'westclox-watchlarm'
];

const categories = [
  {
    id: 'gong',
    no: '01',
    en: 'GONG',
    ja: 'ゴング',
    action: '音響ばね／ゴングを直接叩く',
    example: 'OMEGA MEMOMATIC',
    image: '/images/how-they-ring/gong.jpg'
  },
  {
    id: 'caseback',
    no: '02',
    en: 'CASEBACK',
    ja: 'ケースバック',
    action: 'ケース／保持リングそのものを直接叩く',
    example: 'SICURA SIGNAL / RONDA 1243-21',
    image: '/images/how-they-ring/caseback-hammer.png'
  },
  {
    id: 'bell',
    no: '03',
    en: 'BELL',
    ja: 'ベル',
    action: '独立したベル／ベル底を響かせる',
    example: 'JAEGER-LECOULTRE GRAND REVEIL / CAL.919',
    image: '/images/how-they-ring/bell.jpg'
  },
  {
    id: 'pin',
    no: '04',
    en: 'PIN',
    ja: '底部ピン',
    action: '底部ピンを叩き、膜・裏蓋へ振動を伝える',
    example: 'VULCAIN CRICKET',
    image: '/images/how-they-ring/pin-hammer.png'
  }
]

const specimens = orderedSlugs
  .map((slug) => {
    const watch = published.get(slug);
    const gallery = galleryBySlug.get(slug);
    if (!watch || !gallery?.published) return null;
    return {
      slug,
      category: gallery.category,
      brand: watch.brand,
      model: watch.model,
      caliber: watch.spec.caliber,
      image: `${base}${(gallery.thumbnail?.trim() || ownerThumbnailBySlug.get(slug) || '').replace(/^\//, '')}`,
      recordings: gallery?.audio.status === 'ready'
        ? gallery.audio.recordings.filter((recording) => Boolean(recording.src?.trim()))
        : []
    };
  })
  .filter(Boolean);

---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {production
      ? <SeoHead
          title={productionTitle}
          description={productionDescription}
          path="how-they-ring/"
          image="/images/how-they-ring/gong.jpg"
          type="website"
          schema={productionSchema}
        />
      : <>
          <meta name="robots" content="noindex,nofollow,noarchive" />
          <title>鳴らし方で見る、アラーム腕時計。｜VINTAGE ALARM TEST</title>
        </>}
    <meta name="theme-color" content="#f3eee4" />
    <style>
      :root {
        --lab-ink: #241f1a;
        --lab-soft: #6a6158;
        --lab-rule: #aaa094;
        --lab-paper: #f3eee4;
        --lab-wash: #e9e1d5;
        --lab-white: rgba(255,255,255,.20);
      }

      body { min-width: 0; }

      .lab {
        width: min(calc(100% - 40px), 1060px);
        margin-inline: auto;
        padding: 34px 0 96px;
      }

      .lab-hero {
        padding: 28px 0 42px;
      }

      .lab-kicker {
        margin: 0 0 16px;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 13px;
        letter-spacing: .22em;
      }

      .lab-kicker span {
        display: block;
        margin-top: 3px;
        color: var(--lab-soft);
        font-family: "Yu Mincho","Hiragino Mincho ProN","Noto Serif JP",serif;
        font-size: 10px;
        letter-spacing: .08em;
      }

      .lab-hero h1 {
        margin: 0;
        font-size: clamp(38px, 6vw, 62px);
        font-weight: 500;
        line-height: 1.25;
        letter-spacing: .01em;
      }

      .category-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        border-top: 1px solid var(--lab-ink);
        border-left: 1px solid var(--lab-ink);
      }

      .category-button {
        appearance: none;
        position: relative;
        min-width: 0;
        min-height: 258px;
        padding: 20px 18px 18px;
        overflow: hidden;
        border: 0;
        border-right: 1px solid var(--lab-ink);
        border-bottom: 1px solid var(--lab-ink);
        background: transparent;
        color: inherit;
        text-align: left;
        cursor: pointer;
      }

      .category-button[aria-pressed="true"] {
        background: rgba(255,255,255,.10);
      }

      .category-button:focus-visible {
        outline: 2px solid var(--lab-ink);
        outline-offset: 4px;
      }

      .category-no {
        position: absolute;
        top: 4px;
        right: 10px;
        color: rgba(36,31,26,.10);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 72px;
        line-height: 1;
        letter-spacing: -.06em;
        pointer-events: none;
      }

      .category-name {
        position: relative;
        z-index: 2;
        display: block;
      }

      .category-name strong,
      .category-name em {
        display: block;
      }

      .category-name strong {
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(23px, 2.7vw, 30px);
        font-weight: 400;
        line-height: 1;
        letter-spacing: .035em;
      }

      .category-name em {
        margin-top: 7px;
        color: var(--lab-soft);
        font-size: 12px;
        font-style: normal;
      }

      .mechanism-figure {
        position: relative;
        display: block;
        height: 156px;
        margin: 10px -2px 5px;
        overflow: hidden;
      }

      .mechanism-figure > img {
        display: block;
        width: 100% !important;
        height: 100% !important;
        max-width: none !important;
        object-fit: contain !important;
        background: transparent;
      }


      .category-button[data-category="caseback"] .mechanism-figure > img,
      .category-button[data-category="bell"] .mechanism-figure > img,
      .category-button[data-category="pin"] .mechanism-figure > img {
        top: 22px !important;
        bottom: auto !important;
        height: 112px !important;
        min-height: 112px !important;
        max-height: 112px !important;
        object-fit: cover !important;
        object-position: center center;
      }

      .category-action {
        display: block;
        min-height: 2.8em;
        margin-top: 6px;
        font-size: 12px;
        line-height: 1.65;
      }

      .category-examples {
        display: block;
        margin-top: 9px;
        padding-top: 8px;
        border-top: 1px solid rgba(36,31,26,.24);
        color: var(--lab-soft);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 10px;
        line-height: 1.45;
        letter-spacing: .045em;
      }

      .category-examples small {
        display: block;
        margin-bottom: 2px;
        font-family: "Yu Mincho","Hiragino Mincho ProN","Noto Serif JP",serif;
        font-size: 8px;
        letter-spacing: .06em;
      }

      .selected-section {
        margin-top: 12px;
        border-top: 1px solid var(--lab-ink);
      }

      .selected-head {
        display: block;
        padding: 18px 0 14px;
      }

      .category-summary[hidden],
      .specimen-card[hidden] {
        display: none !important;
      }

      .category-summary h2 {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 34px;
        font-weight: 400;
        line-height: .95;
      }

      .category-summary h2 small {
        display: block;
        margin-top: 9px;
        color: var(--lab-soft);
        font-family: "Yu Mincho","Hiragino Mincho ProN","Noto Serif JP",serif;
        font-size: 13px;
      }

      .category-summary p {
        margin: 0;
        color: var(--lab-soft);
        font-size: 14px;
        line-height: 1.9;
      }

      .specimen-grid {
        display: block;
        border-top: 1px solid var(--lab-ink);
      }

      .specimen-card {
        display: grid;
        grid-template-columns: 124px minmax(0, 1fr) minmax(170px, .72fr);
        gap: 20px;
        align-items: center;
        min-width: 0;
        padding: 14px 0;
        border-bottom: 1px solid var(--lab-rule);
        background: transparent;
      }

      .specimen-media {
        display: block;
        aspect-ratio: 4 / 3;
        overflow: hidden;
        background: rgba(255,255,255,.28);
      }

      .specimen-media:focus-visible {
        outline: 2px solid var(--lab-ink);
        outline-offset: 2px;
      }

      .specimen-media img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      .specimen-copy { display: contents; }
      .specimen-meta { min-width: 0; }

      .specimen-type {
        margin: 0 0 7px;
        color: var(--lab-soft);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 10px;
        letter-spacing: .12em;
      }

      .specimen-card h3 {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 18px;
        font-weight: 400;
        line-height: 1.05;
      }

      .specimen-model {
        margin: 6px 0 0;
        font-size: 14px;
      }

      .specimen-caliber {
        margin: 14px 0 0;
        color: var(--lab-soft);
        font-size: 12px;
      }

      .audio-slots {
        display: grid;
        gap: 8px;
        align-self: stretch;
        align-content: center;
      }

      .audio-pending,
      .audio-slots audio {
        width: 100%;
      }

      .audio-slots audio { display: block; max-width: 100%; }
      .audio-slots p { margin: 0 0 6px; color: var(--lab-soft); font-size: 11px; }

      .audio-pending {
        min-height: 52px;
        padding: 9px 11px;
        border: 1px solid var(--lab-rule);
        background: transparent;
        color: var(--lab-soft);
        font: inherit;
        text-align: left;
      }

      .audio-pending span,
      .audio-pending small {
        display: block;
      }

      .audio-pending span {
        font-family: Georgia, "Times New Roman", serif;
        font-size: 11px;
        letter-spacing: .06em;
      }

      .audio-pending small {
        margin-top: 4px;
        font-size: 10px;
      }

      .lab-footnote {
        margin: 24px 0 0;
        color: var(--lab-soft);
        font-size: 11px;
        line-height: 1.8;
      }

      @media (hover: hover) and (pointer: fine) {
        .category-button:hover {
          background: rgba(233,225,213,.42);
        }
      }

      @media (max-width: 720px) {
        .lab {
          width: min(calc(100% - 32px), 1060px);
          padding-top: 24px;
        }

        .lab-hero {
          padding: 18px 0 20px;
        }

        .lab-hero h1 {
          font-size: clamp(32px, 10vw, 44px);
        }

        .category-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .category-button {
          min-height: 184px;
          padding: 10px 10px 8px;
        }

        .category-no {
          font-size: 36px;
        }

        .category-name strong {
          font-size: clamp(14px, 4.6vw, 17px);
        }

        .mechanism-figure {
          height: 90px;
          margin: 5px -2px 2px;
        }

        .category-button[data-category="caseback"] .mechanism-figure > img,
        .category-button[data-category="bell"] .mechanism-figure > img,
        .category-button[data-category="pin"] .mechanism-figure > img {
          top: 11px !important;
          height: 68px !important;
          min-height: 68px !important;
          max-height: 68px !important;
        }

        .category-action {
          min-height: 2.7em;
          margin-top: 3px;
          font-size: 9px;
          line-height: 1.4;
        }

        .category-examples {
          margin-top: 4px;
          padding-top: 4px;
          font-size: 8.5px;
          line-height: 1.35;
          overflow-wrap: anywhere;
        }

        .category-examples small {
          margin-bottom: 1px;
          font-size: 8px;
        }

        .selected-section {
          margin-top: 8px;
        }

        .selected-head {
          padding: 8px 0 7px;
        }

        .category-summary h2 {
          font-size: 22px;
        }

        .category-summary h2 small {
          margin-top: 3px;
          font-size: 9px;
        }

        .category-summary p {
          font-size: 10px;
          line-height: 1.45;
        }

        .specimen-card {
          grid-template-columns: 96px minmax(0, 1fr);
          gap: 14px;
          align-items: start;
        }

        .specimen-copy { display: block; }

        .audio-slots {
          min-width: 0;
          margin-top: 10px;
        }
      }

      @media (max-width: 380px) {
        .lab { width: calc(100% - 24px); }

        .category-button {
          min-height: 180px;
          padding-inline: 11px;
        }

        .category-no {
          font-size: 40px;
        }

        .category-name strong {
          font-size: 18px;
        }

        .mechanism-figure {
          height: 90px;
        }

        .category-action {
          min-height: 2.6em;
          font-size: 8.5px;
        }

        .category-examples {
          font-size: 8px;
        }

        .specimen-card {
          grid-template-columns: 84px minmax(0, 1fr);
          gap: 12px;
        }
      }
    </style>
  </head>
  <body>
    <main class="lab">
      <header class="lab-hero">
        <p class="lab-kicker">HOW THEY RING<span>鳴らし方で見る</span></p>
        <h1>鳴らし方で見る、<br />アラーム腕時計。</h1>
      </header>

      <section aria-label="鳴動方式を選ぶ">
        <div class="category-grid">
          {categories.map((category) => (
            <button
              type="button"
              class="category-button"
              data-category={category.id}
              aria-controls="specimen-panel"
              aria-pressed={category.id === 'gong' ? 'true' : 'false'}
            >
              <span class="category-no">{category.no}</span>
              <span class="category-name">
                <strong>{category.en}</strong>
                <em>{category.ja}</em>
              </span>
              <span class="mechanism-figure" aria-hidden="true">
                <img
                  src={`${base}${category.image.replace(/^\//, '')}`}
                  alt=""
                  style="position:absolute;inset:0;display:block;width:100%;height:100%;min-height:100%;max-height:100%;max-width:none;object-fit:contain;"
                />
              </span>
              <span class="category-action">{category.action}</span>
              <span class="category-examples"><small>代表機</small>{category.example}</span>
            </button>
          ))}
        </div>
      </section>

      <section class="selected-section" id="specimen-panel" aria-live="polite">
        <div class="selected-head">
          <div>
            {categories.map((category) => (
              <div class="category-summary" data-category-summary={category.id} hidden={category.id !== 'gong'}>
                <h2>{category.en}<small>{category.ja}</small></h2>
              </div>
            ))}
          </div>

        </div>

        <div class="specimen-grid">
          {specimens.map((watch) => (
            <article
              class="specimen-card"
              data-specimen
              data-watch-slug={watch.slug}
              data-category={watch.category}
              hidden={watch.category !== 'gong'}
            >
              <a
                class="specimen-media"
                href={`${base}${watch.slug}/#owners-note`}
                aria-label={`${watch.brand} ${watch.model} のOWNER'S NOTEへ`}
              >
                <img src={watch.image} alt={`${watch.brand} ${watch.model} 掲載個体`} loading="lazy" />
              </a>
              <div class="specimen-copy">
                <div class="specimen-meta">
                  <p class="specimen-type">
                    {categories.find((item) => item.id === watch.category)?.en}
                    ／{categories.find((item) => item.id === watch.category)?.ja}
                  </p>
                  <h3>{watch.brand}</h3>
                  <p class="specimen-model">{watch.model}</p>
                  <p class="specimen-caliber">{watch.caliber}</p>
                </div>

                <div class="audio-slots">
                  {watch.recordings.length ? (
                    watch.recordings.map((recording) => (
                      <div>
                        <p>{recording.label}</p>
                        <audio controls preload="none" src={`${base}${recording.src.replace(/^\//, '')}`}></audio>
                      </div>
                    ))
                  ) : (
                    <button class="audio-pending" type="button" disabled>
                      <span>AUDIO / 音源</span>
                    </button>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>


      </section>
    </main>

    <script is:inline>
      (() => {
        const categoryButtons = [...document.querySelectorAll('button[data-category]')];
        const specimenCards = [...document.querySelectorAll('[data-specimen]')];
        const headingBlocks = [...document.querySelectorAll('[data-category-summary]')];

        const selectCategory = (category) => {
          categoryButtons.forEach((button) => {
            button.setAttribute('aria-pressed', button.dataset.category === category ? 'true' : 'false');
          });
          specimenCards.forEach((card) => {
            card.hidden = card.dataset.category !== category;
          });
          headingBlocks.forEach((block) => {
            block.hidden = block.dataset.categorySummary !== category;
          });
        };

        categoryButtons.forEach((button) => {
          button.addEventListener('click', () => selectCategory(button.dataset.category));
        });
      })();
    </script>
  </body>
</html>
