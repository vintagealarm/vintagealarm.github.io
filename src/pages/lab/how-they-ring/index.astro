---
import { getCollection } from 'astro:content';
import '../../../styles/site.css';

const base = import.meta.env.BASE_URL;
const watches = await getCollection('watches');
const published = new Map(
  watches.filter((item) => item.data.published).map((item) => [item.data.slug, item.data])
);

const categoryBySlug = {
  'basis-alarm': 'bell',
  'cyma-time-o-vox': 'gong',
  'pierce-duofon': 'gong',
  'wittnauer-10wa': 'gong',
  'westclox-watchlarm': 'pin',
  'citizen-alarm': 'caseback'
};

const orderedSlugs = [
  'basis-alarm',
  'cyma-time-o-vox',
  'pierce-duofon',
  'wittnauer-10wa',
  'westclox-watchlarm',
  'citizen-alarm'
];

const categories = [
  {
    id: 'bell',
    no: '01',
    en: 'BELL',
    ja: 'ベル',
    action: '別体のベルを叩く',
    count: 1
  },
  {
    id: 'gong',
    no: '02',
    en: 'GONG',
    ja: 'ゴング',
    action: '音響ばねを叩く',
    count: 3
  },
  {
    id: 'pin',
    no: '03',
    en: 'PIN',
    ja: '底部ピン',
    action: 'ピンを介して底部へ振動を伝える',
    count: 1
  },
  {
    id: 'caseback',
    no: '04',
    en: 'CASEBACK',
    ja: 'ケースバック',
    action: '裏蓋そのものを響かせる',
    count: 1
  }
];

const specimens = orderedSlugs
  .map((slug) => {
    const watch = published.get(slug);
    if (!watch) return null;
    return {
      slug,
      category: categoryBySlug[slug],
      brand: watch.brand,
      model: watch.model,
      caliber: watch.spec.caliber,
      image: `${base}${watch.ownersNote.image.replace(/^\//, '')}`,
      audio: watch.audio
    };
  })
  .filter(Boolean);
---
<!doctype html>
<html lang="ja" data-gallery-variant="a">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="theme-color" content="#f3eee4" />
    <title>鳴らし方で見る、アラーム腕時計。｜VINTAGE ALARM TEST</title>
    <style>
      :root {
        --lab-ink: #241f1a;
        --lab-soft: #6a6158;
        --lab-rule: #aaa094;
        --lab-paper: #f3eee4;
        --lab-wash: #e9e1d5;
        --lab-white: rgba(255,255,255,.26);
      }

      body { min-width: 0; }

      .lab {
        width: min(calc(100% - 40px), 1060px);
        margin-inline: auto;
        padding: 34px 0 96px;
      }

      .lab-status {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        padding-bottom: 13px;
        border-bottom: 1px solid var(--lab-rule);
        color: var(--lab-soft);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 10px;
        letter-spacing: .15em;
      }

      .lab-status strong {
        color: var(--lab-ink);
        font-weight: 400;
      }

      .lab-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(240px, .65fr);
        gap: 50px;
        align-items: end;
        padding: 62px 0 42px;
      }

      .lab-kicker {
        margin: 0 0 16px;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 13px;
        letter-spacing: .22em;
      }

      .lab-kicker span {
        display: block;
        margin-top: 3px;
        color: var(--lab-soft);
        font-family: "Yu Mincho","Hiragino Mincho ProN","Noto Serif JP",serif;
        font-size: 10px;
        letter-spacing: .08em;
      }

      .lab-hero h1 {
        margin: 0;
        font-size: clamp(38px, 6vw, 62px);
        font-weight: 500;
        line-height: 1.25;
        letter-spacing: .01em;
      }

      .lab-hero-copy {
        margin: 0;
        color: var(--lab-soft);
        font-size: 15px;
        line-height: 1.95;
        text-wrap: pretty;
      }

      .variant-switcher {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 0 0 20px;
      }

      .variant-switcher button {
        appearance: none;
        padding: 8px 13px 7px;
        border: 1px solid var(--lab-rule);
        border-radius: 999px;
        background: transparent;
        color: var(--lab-soft);
        font: inherit;
        font-size: 11px;
        line-height: 1.2;
        cursor: pointer;
      }

      .variant-switcher button span {
        font-family: Georgia, "Times New Roman", serif;
        letter-spacing: .08em;
      }

      .variant-switcher button[aria-pressed="true"] {
        border-color: var(--lab-ink);
        background: var(--lab-ink);
        color: var(--lab-paper);
      }

      .variant-switcher button:focus-visible,
      .category-button:focus-visible {
        outline: 2px solid var(--lab-ink);
        outline-offset: 4px;
      }

      .category-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        border-top: 1px solid var(--lab-ink);
        border-left: 1px solid var(--lab-ink);
      }

      .category-button {
        appearance: none;
        position: relative;
        min-width: 0;
        min-height: 178px;
        padding: 20px 18px;
        border: 0;
        border-right: 1px solid var(--lab-ink);
        border-bottom: 1px solid var(--lab-ink);
        background: var(--lab-white);
        color: inherit;
        text-align: left;
        cursor: pointer;
      }

      .category-button[aria-pressed="true"] {
        background: var(--lab-wash);
      }

      .category-no {
        display: block;
        margin-bottom: 29px;
        color: var(--lab-soft);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 11px;
        letter-spacing: .12em;
      }

      .category-name strong,
      .category-name em,
      .category-action,
      .category-count {
        display: block;
      }

      .category-name strong {
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(22px, 3vw, 30px);
        font-weight: 400;
        line-height: 1;
        letter-spacing: .035em;
      }

      .category-name em {
        margin-top: 7px;
        color: var(--lab-soft);
        font-size: 12px;
        font-style: normal;
      }

      .category-action {
        margin-top: 22px;
        font-size: 12px;
        line-height: 1.65;
      }

      .category-count {
        margin-top: 12px;
        color: var(--lab-soft);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 10px;
        letter-spacing: .08em;
      }

      .selected-section {
        margin-top: 48px;
        border-top: 1px solid var(--lab-ink);
      }

      .selected-head {
        display: grid;
        grid-template-columns: minmax(0, .85fr) minmax(280px, 1.15fr);
        gap: 38px;
        align-items: end;
        padding: 28px 0 24px;
      }

      .category-summary[hidden],
      .specimen-card[hidden] {
        display: none !important;
      }

      .category-summary h2 {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(34px, 6vw, 52px);
        font-weight: 400;
        line-height: .95;
      }

      .category-summary h2 small {
        display: block;
        margin-top: 9px;
        color: var(--lab-soft);
        font-family: "Yu Mincho","Hiragino Mincho ProN","Noto Serif JP",serif;
        font-size: 13px;
      }

      .category-summary p {
        margin: 0;
        color: var(--lab-soft);
        font-size: 14px;
        line-height: 1.9;
      }

      .specimen-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        border-top: 1px solid var(--lab-ink);
        border-left: 1px solid var(--lab-ink);
      }

      .specimen-card {
        min-width: 0;
        padding: 19px;
        border-right: 1px solid var(--lab-ink);
        border-bottom: 1px solid var(--lab-ink);
        background: rgba(255,255,255,.13);
      }

      .specimen-media {
        aspect-ratio: 4 / 3;
        margin-bottom: 18px;
        overflow: hidden;
        background: rgba(255,255,255,.30);
      }

      .specimen-media img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      .specimen-type {
        margin: 0 0 7px;
        color: var(--lab-soft);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 10px;
        letter-spacing: .12em;
      }

      .specimen-card h3 {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 25px;
        font-weight: 400;
        line-height: 1.05;
      }

      .specimen-model {
        margin: 6px 0 0;
        font-size: 14px;
      }

      .specimen-caliber {
        margin: 14px 0 17px;
        color: var(--lab-soft);
        font-size: 12px;
      }

      .audio-slots { display: grid; gap: 8px; }

      .audio-pending,
      .audio-slots audio {
        width: 100%;
      }

      .audio-pending {
        min-height: 52px;
        padding: 9px 11px;
        border: 1px solid var(--lab-rule);
        background: transparent;
        color: var(--lab-soft);
        font: inherit;
        text-align: left;
      }

      .audio-pending span,
      .audio-pending small {
        display: block;
      }

      .audio-pending span {
        font-family: Georgia, "Times New Roman", serif;
        font-size: 11px;
        letter-spacing: .06em;
      }

      .audio-pending small {
        margin-top: 4px;
        font-size: 10px;
      }

      .lab-footnote {
        margin: 24px 0 0;
        color: var(--lab-soft);
        font-size: 11px;
        line-height: 1.8;
      }

      /* A — EDITORIAL INDEX / 編集索引 */
      html[data-gallery-variant="a"] .category-button {
        min-height: 178px;
      }

      html[data-gallery-variant="a"] .specimen-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      /* B — WATCH PORTRAIT / 個体写真 */
      html[data-gallery-variant="b"] .category-grid {
        background: transparent;
      }

      html[data-gallery-variant="b"] .category-button {
        min-height: 214px;
        background: transparent;
        overflow: hidden;
      }

      html[data-gallery-variant="b"] .category-button[aria-pressed="true"] {
        background: transparent;
        box-shadow: inset 0 -6px 0 var(--lab-ink);
      }

      html[data-gallery-variant="b"] .category-no {
        position: absolute;
        right: 10px;
        top: 4px;
        margin: 0;
        color: rgba(36,31,26,.10);
        font-size: 72px;
        line-height: 1;
        letter-spacing: -.06em;
      }

      html[data-gallery-variant="b"] .category-name {
        position: absolute;
        left: 18px;
        bottom: 78px;
      }

      html[data-gallery-variant="b"] .category-action {
        position: absolute;
        left: 18px;
        right: 18px;
        bottom: 34px;
        margin: 0;
      }

      html[data-gallery-variant="b"] .category-count {
        position: absolute;
        right: 18px;
        bottom: 13px;
        margin: 0;
      }

      html[data-gallery-variant="b"] .selected-head {
        grid-template-columns: 1fr;
        gap: 13px;
        max-width: 760px;
      }

      html[data-gallery-variant="b"] .specimen-grid {
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 0;
      }

      html[data-gallery-variant="b"] .specimen-card {
        grid-column: span 2;
        padding: 0 0 28px;
        border-right: 1px solid var(--lab-ink);
        border-bottom: 1px solid var(--lab-ink);
      }

      html[data-gallery-variant="b"] .specimen-card:not([hidden]) {
        background: transparent;
      }

      html[data-gallery-variant="b"] .specimen-card:not([hidden]):only-child {
        grid-column: 2 / span 4;
      }

      html[data-gallery-variant="b"] .specimen-media {
        aspect-ratio: 1 / 1;
        margin: 0;
        border-bottom: 1px solid var(--lab-ink);
      }

      html[data-gallery-variant="b"] .specimen-copy {
        padding: 20px 20px 0;
      }

      html[data-gallery-variant="b"] .specimen-card h3 {
        font-size: clamp(28px, 4vw, 40px);
      }

      /* C — CATALOG LIST / 比較一覧 */
      html[data-gallery-variant="c"] .category-button {
        min-height: 116px;
        padding: 16px 15px 14px;
      }

      html[data-gallery-variant="c"] .category-no {
        margin-bottom: 17px;
      }

      html[data-gallery-variant="c"] .category-name strong {
        font-size: 18px;
      }

      html[data-gallery-variant="c"] .category-action {
        margin-top: 12px;
        font-size: 11px;
      }

      html[data-gallery-variant="c"] .category-count {
        position: absolute;
        top: 16px;
        right: 14px;
        margin: 0;
      }

      html[data-gallery-variant="c"] .selected-head {
        grid-template-columns: 240px minmax(0, 1fr);
        gap: 24px;
        padding-block: 22px;
      }

      html[data-gallery-variant="c"] .category-summary h2 {
        font-size: 34px;
      }

      html[data-gallery-variant="c"] .specimen-grid {
        display: block;
        border: 0;
        border-top: 1px solid var(--lab-ink);
      }

      html[data-gallery-variant="c"] .specimen-card {
        display: grid;
        grid-template-columns: 124px minmax(0, 1fr) minmax(170px, .72fr);
        gap: 20px;
        align-items: center;
        padding: 14px 0;
        border: 0;
        border-bottom: 1px solid var(--lab-rule);
        background: transparent;
      }

      html[data-gallery-variant="c"] .specimen-media {
        aspect-ratio: 4 / 3;
        margin: 0;
      }

      html[data-gallery-variant="c"] .specimen-copy {
        display: contents;
      }

      html[data-gallery-variant="c"] .specimen-meta {
        min-width: 0;
      }

      html[data-gallery-variant="c"] .specimen-card h3 {
        font-size: 22px;
      }

      html[data-gallery-variant="c"] .specimen-caliber {
        margin-bottom: 0;
      }

      html[data-gallery-variant="c"] .audio-slots {
        align-self: stretch;
        align-content: center;
      }

      @media (hover: hover) and (pointer: fine) {
        .category-button:hover {
          background: rgba(233,225,213,.58);
        }

        .variant-switcher button:hover {
          border-color: var(--lab-ink);
          color: var(--lab-ink);
        }

        .variant-switcher button[aria-pressed="true"]:hover {
          color: var(--lab-paper);
        }
      }

      @media (max-width: 720px) {
        .lab {
          width: min(calc(100% - 32px), 1060px);
          padding-top: 24px;
        }

        .lab-status {
          font-size: 9px;
          letter-spacing: .09em;
        }

        .lab-hero {
          grid-template-columns: 1fr;
          gap: 22px;
          padding: 46px 0 34px;
        }

        .lab-hero h1 {
          font-size: clamp(36px, 11vw, 50px);
        }

        .lab-hero-copy {
          max-width: 33em;
          font-size: 14px;
        }

        .category-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .category-button {
          min-height: 154px;
          padding: 16px 14px;
        }

        .category-no {
          margin-bottom: 22px;
        }

        .category-name strong {
          font-size: 22px;
        }

        .category-action {
          margin-top: 16px;
          font-size: 11px;
        }

        .selected-section {
          margin-top: 38px;
        }

        .selected-head {
          grid-template-columns: 1fr;
          gap: 14px;
        }

        .specimen-grid {
          grid-template-columns: 1fr;
        }

        html[data-gallery-variant="b"] .category-button {
          min-height: 184px;
        }

        html[data-gallery-variant="b"] .category-no {
          font-size: 58px;
        }

        html[data-gallery-variant="b"] .category-name {
          bottom: 70px;
          left: 14px;
        }

        html[data-gallery-variant="b"] .category-action {
          left: 14px;
          right: 14px;
          bottom: 30px;
        }

        html[data-gallery-variant="b"] .category-count {
          right: 14px;
          bottom: 10px;
        }

        html[data-gallery-variant="b"] .specimen-grid {
          grid-template-columns: 1fr;
        }

        html[data-gallery-variant="b"] .specimen-card,
        html[data-gallery-variant="b"] .specimen-card:not([hidden]):only-child {
          grid-column: auto;
        }

        html[data-gallery-variant="b"] .specimen-media {
          aspect-ratio: 5 / 4;
        }

        html[data-gallery-variant="c"] .category-button {
          min-height: 104px;
        }

        html[data-gallery-variant="c"] .selected-head {
          grid-template-columns: 1fr;
        }

        html[data-gallery-variant="c"] .specimen-card {
          grid-template-columns: 96px minmax(0, 1fr);
          gap: 14px;
        }

        html[data-gallery-variant="c"] .specimen-copy {
          display: block;
        }

        html[data-gallery-variant="c"] .audio-slots {
          grid-column: 1 / -1;
        }
      }

      @media (max-width: 340px) {
        .lab { width: calc(100% - 24px); }

        .variant-switcher {
          display: grid;
          grid-template-columns: 1fr;
        }

        .variant-switcher button {
          text-align: left;
        }

        .category-button {
          padding-inline: 11px;
        }

        .category-name strong {
          font-size: 20px;
        }

        html[data-gallery-variant="b"] .category-name {
          left: 11px;
        }

        html[data-gallery-variant="b"] .category-action {
          left: 11px;
          right: 11px;
        }

        html[data-gallery-variant="c"] .specimen-card {
          grid-template-columns: 1fr;
        }

        html[data-gallery-variant="c"] .specimen-media {
          max-width: 160px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
      }
    </style>
  </head>
  <body>
    <main class="lab">
      <div class="lab-status">
        <strong>VINTAGE ALARM / TEST SURFACE</strong>
        <span>非公開プレビュー</span>
      </div>

      <header class="lab-hero">
        <div>
          <p class="lab-kicker">HOW THEY RING<span>鳴らし方で見る</span></p>
          <h1>鳴らし方で見る、<br />アラーム腕時計。</h1>
        </div>
        <p class="lab-hero-copy">
          ブランドや年代ではなく、何を叩き、何を響かせるのかで分ける。
          4つの方式から、対応する掲載個体へ切り替える。
        </p>
      </header>

      <div class="variant-switcher" role="group" aria-label="比較レイアウト">
        <button type="button" data-variant="a" aria-pressed="true"><span>A INDEX</span>　編集索引</button>
        <button type="button" data-variant="b" aria-pressed="false"><span>B PORTRAIT</span>　個体写真</button>
        <button type="button" data-variant="c" aria-pressed="false"><span>C CATALOG</span>　比較一覧</button>
      </div>

      <section aria-label="鳴動方式を選ぶ">
        <div class="category-grid">
          {categories.map((category) => (
            <button
              type="button"
              class="category-button"
              data-category={category.id}
              aria-controls="specimen-panel"
              aria-pressed={category.id === 'gong' ? 'true' : 'false'}
            >
              <span class="category-no">{category.no}</span>
              <span class="category-name">
                <strong>{category.en}</strong>
                <em>{category.ja}</em>
              </span>
              <span class="category-action">{category.action}</span>
              <span class="category-count">{category.count} {category.count === 1 ? 'WATCH' : 'WATCHES'} / 掲載</span>
            </button>
          ))}
        </div>
      </section>

      <section class="selected-section" id="specimen-panel" aria-live="polite">
        <div class="selected-head">
          <div>
            {categories.map((category) => (
              <div class="category-summary" data-category-summary={category.id} hidden={category.id !== 'gong'}>
                <h2>{category.en}<small>{category.ja}</small></h2>
              </div>
            ))}
          </div>
          <div>
            {categories.map((category) => (
              <div class="category-summary" data-category-description={category.id} hidden={category.id !== 'gong'}>
                <p>{category.action}方式。現在の掲載個体は{category.count}本。音源は実機録音を追加するまで表示しない。</p>
              </div>
            ))}
          </div>
        </div>

        <div class="specimen-grid">
          {specimens.map((watch) => (
            <article
              class="specimen-card"
              data-specimen
              data-category={watch.category}
              hidden={watch.category !== 'gong'}
            >
              <div class="specimen-media">
                <img src={watch.image} alt={`${watch.brand} ${watch.model} 掲載個体`} loading="lazy" />
              </div>
              <div class="specimen-copy">
                <div class="specimen-meta">
                  <p class="specimen-type">
                    {categories.find((item) => item.id === watch.category)?.en}
                    ／{categories.find((item) => item.id === watch.category)?.ja}
                  </p>
                  <h3>{watch.brand}</h3>
                  <p class="specimen-model">{watch.model}</p>
                  <p class="specimen-caliber">{watch.caliber}</p>
                </div>

                <div class="audio-slots">
                  {watch.audio?.recordings?.length ? (
                    watch.audio.recordings.map((recording) => (
                      recording.src ? (
                        <div>
                          <p>{recording.label}</p>
                          <audio controls preload="none" src={`${base}${recording.src.replace(/^\//, '')}`}></audio>
                        </div>
                      ) : (
                        <button class="audio-pending" type="button" disabled>
                          <span>{recording.label}</span>
                          <small>音源準備中</small>
                        </button>
                      )
                    ))
                  ) : (
                    <button class="audio-pending" type="button" disabled>
                      <span>AUDIO / 音源</span>
                      <small>実機録音を追加予定</small>
                    </button>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>

        <p class="lab-footnote">
          音源スロットは各掲載個体に用意済み。録音を追加した個体だけ再生UIへ切り替える。
          Pierce Duofonは複数音源を格納できる構造を維持。
        </p>
      </section>
    </main>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const categoryButtons = [...document.querySelectorAll('button[data-category]')];
        const specimenCards = [...document.querySelectorAll('[data-specimen]')];
        const headingBlocks = [...document.querySelectorAll('[data-category-summary]')];
        const descriptionBlocks = [...document.querySelectorAll('[data-category-description]')];
        const variantButtons = [...document.querySelectorAll('[data-variant]')];

        const selectCategory = (category) => {
          categoryButtons.forEach((button) => {
            button.setAttribute('aria-pressed', button.dataset.category === category ? 'true' : 'false');
          });
          specimenCards.forEach((card) => {
            card.hidden = card.dataset.category !== category;
          });
          headingBlocks.forEach((block) => {
            block.hidden = block.dataset.categorySummary !== category;
          });
          descriptionBlocks.forEach((block) => {
            block.hidden = block.dataset.categoryDescription !== category;
          });
        };

        categoryButtons.forEach((button) => {
          button.addEventListener('click', () => selectCategory(button.dataset.category));
        });

        variantButtons.forEach((button) => {
          button.addEventListener('click', () => {
            const variant = button.dataset.variant || 'a';
            root.dataset.galleryVariant = variant;
            variantButtons.forEach((item) => {
              item.setAttribute('aria-pressed', item === button ? 'true' : 'false');
            });
          });
        });
      })();
    </script>
  </body>
</html>
