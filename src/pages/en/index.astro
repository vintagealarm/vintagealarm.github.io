---
import SeoHead from '../../components/SeoHead.astro';
import HomeLanding from '../../components/HomeLanding.astro';
import OwnerFonts from '../../components/OwnerFonts.astro';
import '../../styles/site.css';
import '../../styles/home-v2.css';

const title = 'VINTAGE ALARM — Mechanical Alarm Wristwatches | English';
const description = 'English VINTAGE ALARM: history, owned specimens, real alarm sounds, ringing mechanisms and source-backed research on mechanical alarm wristwatches.';
const socialImage = '/images/history-motifs/before-watercolor.png';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'VINTAGE ALARM — English',
  description,
  inLanguage: 'en',
  url: 'https://vintagealarm.github.io/en/',
  hasPart: [
    { '@type': 'Article', name: 'History of the Alarm Wristwatch', url: 'https://vintagealarm.github.io/en/history/' },
    { '@type': 'CollectionPage', name: "OWNER'S NOTES", url: 'https://vintagealarm.github.io/en/owners-notes/' },
    { '@type': 'CollectionPage', name: 'HOW THEY RING', url: 'https://vintagealarm.github.io/en/how-they-ring/' }
  ]
};
const alternates = [
  { hreflang: 'ja', href: '/' },
  { hreflang: 'en', href: '/en/' },
  { hreflang: 'de', href: '/de/' },
  { hreflang: 'x-default', href: '/' }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f8f4" />
    <OwnerFonts />
    <SeoHead title={title} description={description} path="en/" image={socialImage} locale="en_US" schema={schema} alternates={alternates} />
  </head>
  <body class="home-v2">
    <HomeLanding locale="en" />
  </body>
</html>
