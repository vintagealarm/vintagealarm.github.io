---
import SeoHead from '../components/SeoHead.astro';
import HomeLanding from '../components/HomeLanding.astro';
import OwnerFonts from '../components/OwnerFonts.astro';
import '../styles/site.css';
import '../styles/home-v2.css';
const title = 'VINTAGE ALARM｜機械式アラーム腕時計の歴史・実機・資料';
const description = '機械式アラーム腕時計を、歴史・実機・音・資料から読むオンライン誌。Pierce Duofonをはじめ、各時代のアラーム腕時計と機構を整理する。';
const socialImage = '/images/history-motifs/before-watercolor.png';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'VINTAGE ALARM',
  url: 'https://vintagealarm.github.io/',
  description,
  inLanguage: 'ja'
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f8f4" />
    <OwnerFonts />
    <SeoHead title={title} description={description} path="" image={socialImage} schema={schema} />
  </head>
  <body class="home-v2">
    <HomeLanding />
  </body>
</html>
