---
import SeoHead from '../../../components/SeoHead.astro';
const base = import.meta.env.BASE_URL;
const parts = [1, 2, 3, 4].map((n) => `${base}images/history/smartwatch-part-${n}.webp`);
const artworkUrl = 'https://vintagealarm.github.io/images/history/smartwatch-part-1.webp';
const title = '現状の到達点：SMARTWATCH｜アラーム腕時計の歴史｜VINTAGE ALARM';
const alternates = [
  { hreflang: 'ja', href: '/history/smartwatch/' },
  { hreflang: 'en', href: '/en/history/smartwatch/' },
  { hreflang: 'de', href: '/de/history/smartwatch/' },
  { hreflang: 'x-default', href: '/history/smartwatch/' }
];
const description = 'アラーム腕時計の歴史の現在地。機械式アラームから電子化を経て、腕時計が通知・健康・通信まで扱うSMARTWATCHへ到達した先を見る。';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CreativeWork',
      name: '現状の到達点：SMARTWATCH',
      description,
      inLanguage: 'ja',
      image: artworkUrl,
      url: 'https://vintagealarm.github.io/history/smartwatch/',
      isPartOf: {
        '@type': 'WebPage',
        name: 'アラーム腕時計の歴史',
        url: 'https://vintagealarm.github.io/history/'
      }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'VINTAGE ALARM',
          item: 'https://vintagealarm.github.io/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'HISTORY',
          item: 'https://vintagealarm.github.io/history/'
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'SMARTWATCH',
          item: 'https://vintagealarm.github.io/history/smartwatch/'
        }
      ]
    }
  ]
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <SeoHead title={title} description={description} path="history/smartwatch/" image={artworkUrl} type="article" schema={schema} alternates={alternates} robots="noindex,follow" />
    <style is:inline>
      html,body{margin:0;background:#000}
      body{min-height:100vh}
      .smartwatch-finale{background:#000}
      .smartwatch-finale-inner{position:relative;width:min(100%,480px);margin-inline:auto;background:#000;line-height:0}
      .smartwatch-finale-art{display:block;width:100%;height:auto;margin:0;border:0}
      .smartwatch-finale-back{position:absolute;z-index:2;left:41%;top:90.5%;width:56%;height:6.2%;display:block;border-radius:8px;text-decoration:none;line-height:normal}
      .smartwatch-finale-back:focus-visible{outline:2px solid #d4a55f;outline-offset:2px;background:rgba(212,165,95,.08)}
      .visually-hidden{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}
    </style>
  </head>
  <body>
    <main>
      <section class="smartwatch-finale" aria-labelledby="smartwatch-title">
        <div class="visually-hidden">
          <p>HISTORY OF ALARM WRISTWATCHES</p>
          <p>07｜現在：SMARTWATCH</p>
          <h1 id="smartwatch-title">SMARTWATCH</h1>
          <p>スマートウォッチ</p>
          <p>アラームも、通知も、健康も、つながりも。</p>
          <p>現代の到達点。</p>
          <p>欲しいものは、全部盛り。</p>
          <p>まだ、足りませんか。</p>
          <p>通知に疲れましたか？</p>
          <p>私たちが本当に求めていたのは、これほどの「知らせ方」だったのでしょうか。</p>
        </div>
        <div class="smartwatch-finale-inner">
          <img class="smartwatch-finale-art" src={parts[0]} width="480" height="180" alt="" aria-hidden="true" loading="eager" fetchpriority="high" />
          <img class="smartwatch-finale-art" src={parts[1]} width="480" height="180" alt="" aria-hidden="true" loading="eager" />
          <img class="smartwatch-finale-art" src={parts[2]} width="480" height="180" alt="" aria-hidden="true" loading="eager" />
          <img class="smartwatch-finale-art" src={parts[3]} width="480" height="180" alt="" aria-hidden="true" loading="eager" />
          <a class="smartwatch-finale-back" href={`${base}history/`} title="もっと静かな時代へ戻る"><span class="visually-hidden">← もっと静かな時代へ戻る。</span></a>
        </div>
      </section>
    </main>
  </body>
</html>
