---
import SeoHead from '../../components/SeoHead.astro';
import SectionMast from '../../components/SectionMast.astro';
import { sourceLibrary } from '../../data/source-library';
import '../../styles/site.css';

const title='資料・出典｜VINTAGE ALARM';
const description='VINTAGE ALARMで繰り返し参照する専門書を、書誌情報・主な参照範囲・図書館／書誌確認・入手先とともに整理する資料ページ。';
const root='https://vintagealarm.github.io/';
const pageUrl=root+'sources/';
const books=sourceLibrary.filter(item=>item.category==='reference-book');
const schema={'@context':'https://schema.org','@graph':[
  {'@type':'CollectionPage',name:'資料・出典',description,url:pageUrl,isPartOf:{'@type':'WebSite',name:'VINTAGE ALARM',url:root}},
  ...books.map(item=>({
    '@type':'Book',
    '@id':`${pageUrl}#${item.id}`,
    name:item.title,
    author:{'@type':'Person',name:item.author},
    datePublished:item.year,
    ...(item.isbn?{isbn:item.isbn}:{}),
    ...(item.language?{inLanguage:item.language}:{}),
    url:`${pageUrl}#${item.id}`
  })),
  {'@type':'BreadcrumbList',itemListElement:[
    {'@type':'ListItem',position:1,name:'VINTAGE ALARM',item:root},
    {'@type':'ListItem',position:2,name:'資料・出典',item:pageUrl}
  ]}
]};
---
<!doctype html><html lang="ja"><head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="theme-color" content="#1c201c"/>
  <link rel="icon" href="data:,"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Noto+Serif+JP:wght@400;500;600&display=swap" rel="stylesheet"/>
  <SeoHead title={title} description={description} path="sources/" type="website" schema={schema}/>
</head><body>
  <SectionMast rightLabel="SOURCES"/>
  <main class="source-library shell">
    <header class="source-library-head">
      <p class="source-kicker">SOURCE TRACEABILITY</p>
      <h1>資料・出典</h1>
      <p>VINTAGE ALARMで繰り返し参照する資料を、読者自身が追跡できるように整理します。図書館・出版社・書誌資料へのリンクは、資料の実在、版、ISBNなどを確認するための補助導線です。歴史的主張そのものは、HISTORY / WATCH側で該当ページや一次資料へ紐付けます。</p>
    </header>

    <section aria-labelledby="reference-books-title">
      <div class="source-section-head">
        <h2 id="reference-books-title">専門書</h2>
        <span>{books.length}</span>
      </div>
      <div class="source-grid">
        {books.map((item,index)=><article class="source-card" id={item.id} data-source-id={item.id}>
          <div class="source-card-meta"><span>SOURCE {String(index+1).padStart(2,'0')}</span><span>{item.year}</span></div>
          <h3><cite>{item.title}</cite></h3>
          <p class="source-author">{item.author}</p>
          <dl>
            <div><dt>刊行</dt><dd>{item.imprint}</dd></div>
            <div><dt>年</dt><dd>{item.year}</dd></div>
            <div><dt>ISBN</dt><dd>{item.isbn??'未確認'}</dd></div>
          </dl>
          <div class="source-uses">
            <h4>VINTAGE ALARM内の主な参照</h4>
            <ul>{item.usedFor.map(use=><li>{use}</li>)}</ul>
          </div>
          {item.bibliography&&item.bibliography.length>0&&<div class="source-links source-bibliography" aria-label="書誌確認">
            <span>書誌確認</span>
            {item.bibliography.map(link=><a href={link.url} rel="noopener noreferrer" target="_blank" data-kind={link.kind}>{link.label} ↗</a>)}
          </div>}
          {item.note&&<p class="source-note">{item.note}</p>}
          {item.acquisition&&item.acquisition.length>0&&<div class="source-links" aria-label="入手先">
            <span>入手先</span>
            {item.acquisition.map(link=><a href={link.url} rel="noopener noreferrer" target="_blank">{link.label} ↗</a>)}
          </div>}
        </article>)}
      </div>
    </section>

    <aside class="source-scope">
      <strong>このページの範囲</strong>
      <p>まずHorlbeck / Beitlの2冊だけを共通資料として整理しています。メーカー公式資料・特許・個別Web資料は、それを使ったHISTORY / WATCH側で個別に示します。資料数を増やすこと自体は目的にしません。</p>
    </aside>
  </main>
</body></html>

<style>
  .source-library{padding:54px 0 96px}
  .source-library-head{max-width:760px;margin-bottom:58px}
  .source-kicker{margin:0 0 12px;font:600 11px/1.2 Inter,sans-serif;letter-spacing:.18em;color:var(--soft)}
  .source-library h1{margin:0 0 20px;font:500 clamp(36px,7vw,72px)/1.05 "Noto Serif JP",serif;letter-spacing:-.02em}
  .source-library-head>p:last-child{max-width:680px;margin:0;color:var(--soft);font-size:15px;line-height:2}
  .source-section-head{display:flex;align-items:end;justify-content:space-between;padding-bottom:12px;border-bottom:1px solid var(--ink);margin-bottom:24px}
  .source-section-head h2{margin:0;font:500 24px/1.2 "Noto Serif JP",serif}
  .source-section-head span{font:500 11px/1 Inter,sans-serif;color:var(--soft)}
  .source-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
  .source-card{padding:24px;border:1px solid var(--rule);background:var(--paper)}
  .source-card-meta{display:flex;justify-content:space-between;gap:16px;margin-bottom:22px;font:500 10px/1.2 Inter,sans-serif;letter-spacing:.12em;color:var(--soft)}
  .source-card h3{margin:0 0 10px;font:500 24px/1.35 "Noto Serif JP",serif}
  .source-card cite{font-style:normal}
  .source-author{margin:0 0 22px;font:500 13px/1.5 Inter,sans-serif}
  .source-card dl{margin:0 0 24px;border-top:1px solid var(--rule)}
  .source-card dl>div{display:grid;grid-template-columns:72px 1fr;gap:14px;padding:10px 0;border-bottom:1px solid var(--rule);font-size:12px;line-height:1.65}
  .source-card dt{color:var(--soft)}
  .source-card dd{margin:0}
  .source-uses h4{margin:0 0 10px;font:600 10px/1.2 Inter,sans-serif;letter-spacing:.1em;color:var(--soft)}
  .source-uses ul{margin:0;padding-left:1.1em;font-size:13px;line-height:1.8}
  .source-note{margin:20px 0 0;padding-top:16px;border-top:1px solid var(--rule);font-size:12px;line-height:1.8;color:var(--soft)}
  .source-links{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:18px}
  .source-bibliography{padding-top:16px;border-top:1px solid var(--rule)}
  .source-links>span{font:600 10px/1 Inter,sans-serif;letter-spacing:.1em;color:var(--soft)}
  .source-links a{color:var(--ink);font-size:12px;text-underline-offset:3px}
  .source-scope{margin-top:34px;padding:20px 0;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule)}
  .source-scope strong{display:block;margin-bottom:8px;font:600 10px/1 Inter,sans-serif;letter-spacing:.1em;color:var(--soft)}
  .source-scope p{max-width:760px;margin:0;font-size:13px;line-height:1.85}
  @media(max-width:760px){
    .source-library{padding:38px 0 72px}
    .source-library-head{margin-bottom:42px}
    .source-grid{grid-template-columns:1fr}
    .source-card{padding:20px}
  }
</style>